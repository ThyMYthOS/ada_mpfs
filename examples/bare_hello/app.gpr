--  SPDX-License-Identifier: Apache-2.0
--
--  Compiles a bare image to objects (gprbuild -c, see build.sh): start.S and a
--  main written with No_Elaboration_Code. The light-polarfiresoc runtime is
--  selected only for its system.ads (word size, address type, ...); build.sh
--  binds nothing and links no unit of the runtime.
--
--  Build contract: see examples/STYLE.md.

project App is
   type Hart_Kind is ("e51", "u54");
   Hart : Hart_Kind := external ("MPFS_HART", "e51");

   --  STACK_ANALYSIS=1 (./x stack) makes the compiler also write the stack
   --  usage (.su) and the call graph (.ci) of every unit. The code is the same.
   type Switch is ("0", "1");
   Stack_Analysis : Switch := external ("STACK_ANALYSIS", "0");
   Analysis := ();
   case Stack_Analysis is
      when "1" => Analysis := ("-fstack-usage", "-fcallgraph-info=su,da");
      when "0" => null;
   end case;

   --  The build directory must not reach the image (./x repro compares two
   --  builds made in different directories): the paths the compiler records
   --  are made relative to the repository root, which ./x exports (without
   --  ADA_MPFS_SDK, gprbuild called by hand, they stay absolute), and the
   --  switches are not recorded: they name a temporary file of gprbuild.
   Sdk_Root := external ("ADA_MPFS_SDK", "");
   Repro_Switches := ("-gno-record-gcc-switches");
   case Sdk_Root is
      when ""     => null;
      when others =>
         null;
   end case;

   --  The ABI of the image. The E51 has no FPU.
   Arch := "";
   Abi  := "";
   case Hart is
      when "e51" =>
         Arch := "rv64imac_zicsr_zifencei";
         Abi  := "lp64";
      when "u54" =>
         Arch := "rv64imafdc_zicsr_zifencei";
         Abi  := "lp64d";
   end case;

   for Languages use ("Ada", "Asm_Cpp");
   for Target use "riscv64-elf";
   for Runtime ("Ada") use "light-polarfiresoc";
   for Source_Dirs use (".", "src");
   for Object_Dir use "obj-" & Hart;
   for Exec_Dir use "bin-" & Hart;
   for Main use ("bare_hello.adb");

   Common := ("-march=" & Arch, "-mabi=" & Abi, "-mcmodel=medany");

   package Compiler is
      for Default_Switches ("Ada") use Common &
        ("-O2", "-g", "-gnat2022", "-gnatwa", "-gnatwe", "-gnaty",
         "-ffunction-sections", "-fdata-sections") & Repro_Switches & Analysis;
      for Default_Switches ("Asm_Cpp") use Common & ("-g") & Repro_Switches;
   end Compiler;
end App;
