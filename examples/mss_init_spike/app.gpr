--  SPDX-License-Identifier: Apache-2.0
--
--  Two images of the MSS set-up from the table MPFS_Init_Table (generated
--  from an MSS Configurator XML and hw/mss_init.py): mss_init_spike for the
--  Icicle Kit, where a poll that runs out of time is an error, and
--  mss_init_spike_qemu, which reports it and goes on. Both link the `light`
--  runtime and use its console. MSS_INIT_TABLE_DIR names another directory
--  for mpfs_init_table.ads (the test of the example builds an image from a
--  table with a deliberate error that way).
--
--  Build contract: see examples/STYLE.md.

with "../../crates/mpfs_rts/mpfs_rts.gpr";
with "../../crates/mpfs_rts/mpfs_link.gpr";
with "../../libs/mpfs_pac/mpfs_pac.gpr";

project App is
   Hart := Mpfs_Rts.Hart;

   --  STACK_ANALYSIS=1 (./x stack) makes the compiler also write the stack
   --  usage (.su) and the call graph (.ci) of every unit. The code is the same.
   type Switch is ("0", "1");
   Stack_Analysis : Switch := external ("STACK_ANALYSIS", "0");
   Analysis := ();
   case Stack_Analysis is
      when "1" => Analysis := ("-fstack-usage", "-fcallgraph-info=su,da");
      when "0" => null;
   end case;

   --  The build directory must not reach the image (./x repro): see examples/STYLE.md.
   Sdk_Root := external ("ADA_MPFS_SDK", "");
   Repro_Switches := ("-gno-record-gcc-switches");
   case Sdk_Root is
      when ""     => null;
      when others =>
         Repro_Switches := Repro_Switches
           & ("-ffile-prefix-map=" & Sdk_Root & "=.");
   end case;

   Table_Dir := external ("MSS_INIT_TABLE_DIR", "src/generated");
   Ring_Dir  := external ("MSS_INIT_RING_DIR", "src/ring");

   for Languages use ("Ada");
   for Target use Mpfs_Rts.Target;
   for Runtime ("Ada") use Mpfs_Rts.Runtime_Path;
   for Source_Dirs use ("src", Table_Dir, Ring_Dir);
   for Object_Dir use "obj-" & Hart;
   for Exec_Dir use "bin-" & Hart;
   for Main use ("mss_init_spike.adb", "mss_init_spike_qemu.adb");

   package Builder is
      for Executable_Suffix use ".elf";
   end Builder;

   package Compiler is
      for Default_Switches ("Ada") use
        ("-O2", "-g", "-gnat2022", "-gnatwa", "-gnatw.X", "-gnatwe", "-gnaty",
         "-ffunction-sections", "-fdata-sections") & Analysis & Repro_Switches;
   end Compiler;

   package Linker is
      for Default_Switches ("Ada") use Mpfs_Link.Switches;
   end Linker;
end App;
