--
--  The interrupt stack tests of the embedded profile (issue #91): the peak use of the interrupt
--  stack of the first unwind inside a trap handler. Sources shared with the light-tasking variant
--  (examples/interrupt_stack_tasking_test), which differs in the last chance handler.
--
--  Build contract: see examples/STYLE.md.

with "../../crates/mpfs_rts/mpfs_rts.gpr";
with "../../crates/mpfs_rts/mpfs_link.gpr";

project App is
   Hart := Mpfs_Rts.Hart;

   --  STACK_ANALYSIS=1 (./x stack) makes the compiler also write the stack
   --  usage (.su) and the call graph (.ci) of every unit. The code is the same.
   type Switch is ("0", "1");
   Stack_Analysis : Switch := external ("STACK_ANALYSIS", "0");
   Analysis := ();
   case Stack_Analysis is
      when "1" => Analysis := ("-fstack-usage", "-fcallgraph-info=su,da");
      when "0" => null;
   end case;

   --  The build directory must not reach the image (./x repro): see examples/STYLE.md.
   Sdk_Root := external ("ADA_MPFS_SDK", "");
   Repro_Switches := ("-gno-record-gcc-switches");
   case Sdk_Root is
      when ""     => null;
      when others =>
         Repro_Switches := Repro_Switches
           & ("-ffile-prefix-map=" & Sdk_Root & "=.");
   end case;

   for Languages use ("Ada", "Asm_Cpp");
   for Target use Mpfs_Rts.Target;
   for Runtime ("Ada") use Mpfs_Rts.Runtime_Path;
   for Source_Dirs use ("src", "../trap_test/src", "../bare_hello/src", "../../tests/common");
   --  Only what the image needs of the shared directories.
   for Source_Files use
     ("interrupt_stack_peak_test.adb", "interrupt_stack_overflow_test.adb",
      "interrupt_stack_halt_test.adb", "istack.ads", "istack.adb",
      "istack_overrun.ads", "istack_overrun.adb",
      "istack_check.ads", "istack_check.adb", "istack_handler.ads",
      "istack_handler.adb", "test_name.ads", "fault.S",
      "bare_console.ads", "bare_console.adb",
      "test_report.ads", "test_report.adb");
   for Object_Dir use "obj-" & Hart;
   for Exec_Dir use "bin-" & Hart;
   for Main use
     ("interrupt_stack_peak_test.adb", "interrupt_stack_overflow_test.adb",
      "interrupt_stack_halt_test.adb");

   package Builder is
      for Executable ("interrupt_stack_peak_test.adb") use "istack_peak_embedded_test";
      for Executable ("interrupt_stack_overflow_test.adb") use "istack_overflow_embedded_test";
      for Executable ("interrupt_stack_halt_test.adb") use "istack_halt_embedded_test";
      for Executable_Suffix use ".elf";
   end Builder;

   package Compiler is
      for Default_Switches ("Ada") use
        ("-O2", "-g", "-gnat2022", "-gnatwa", "-gnatwe", "-gnaty",
         "-ffunction-sections", "-fdata-sections") & Analysis & Repro_Switches;
      for Default_Switches ("Asm_Cpp") use ("-g") & Repro_Switches;
   end Compiler;

   package Linker is
      for Default_Switches ("Ada") use Mpfs_Link.Switches;
      for Switches ("interrupt_stack_overflow_test.adb") use
        Mpfs_Link.Common
        & external_as_list ("MPFS_DEFSYMS_interrupt_stack_overflow_test", ";");
   end Linker;
end App;
