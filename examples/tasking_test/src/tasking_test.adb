--
--  The smallest program that needs the tasking runtime: a periodic task
--  (Ticker.Worker) and an environment task that sleeps. It exists to be
--  built with every hart class against a runtime generated by crates/mpfs_rts
--  (P1.2); the real test of the work package P1.13 replaces it.

with Ada.Real_Time;
with Ticker;
pragma Unreferenced (Ticker);

procedure Tasking_Test is
begin
   delay until Ada.Real_Time.Time_Last;
end Tasking_Test;
