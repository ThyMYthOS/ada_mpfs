--
--  The interrupt stack tests of the light-tasking profile (issue #91). The sources are those of
--  examples/interrupt_stack_embedded_test, except for the last chance handler, which takes the
--  message of the exception as a C string in this profile (Istack_Handler), and the name of the test
--  (Test_Name; examples/STYLE.md, "Profile variants").
--
--  Build contract: see examples/STYLE.md.

with "../../crates/mpfs_rts/mpfs_rts.gpr";
with "../../crates/mpfs_rts/mpfs_link.gpr";

project App is
   Hart := Mpfs_Rts.Hart;

   --  STACK_ANALYSIS=1 (./x stack) makes the compiler also write the stack
   --  usage (.su) and the call graph (.ci) of every unit. The code is the same.
   type Switch is ("0", "1");
   Stack_Analysis : Switch := external ("STACK_ANALYSIS", "0");
   Analysis := ();
   case Stack_Analysis is
      when "1" => Analysis := ("-fstack-usage", "-fcallgraph-info=su,da");
      when "0" => null;
   end case;

   --  The build directory must not reach the image (./x repro): see examples/STYLE.md.
   Sdk_Root := external ("ADA_MPFS_SDK", "");
   Repro_Switches := ("-gno-record-gcc-switches");
   case Sdk_Root is
      when ""     => null;
      when others =>
         Repro_Switches := Repro_Switches
           & ("-ffile-prefix-map=" & Sdk_Root & "=.");
   end case;

   for Languages use ("Ada", "Asm_Cpp");
   for Target use Mpfs_Rts.Target;
   for Runtime ("Ada") use Mpfs_Rts.Runtime_Path;
   for Source_Dirs use
     ("src", "../interrupt_stack_embedded_test/src", "../trap_test/src", "../bare_hello/src",
      "../../tests/common");
   --  Only what the image needs of the shared directories.
   for Source_Files use
     ("interrupt_stack_peak_test.adb", "istack.ads", "istack.adb",
      "istack_check.ads", "istack_check.adb", "istack_handler_tasking.ads",
      "istack_handler_tasking.adb", "test_name_tasking.ads", "fault.S",
      "bare_console.ads", "bare_console.adb",
      "test_report.ads", "test_report.adb");
   for Object_Dir use "obj-" & Hart;
   for Exec_Dir use "bin-" & Hart;
   for Main use ("interrupt_stack_peak_test.adb");

   --  The sources are those of the embedded variant; the handler, the name of the test and of the
   --  image are not.
   package Naming is
      for Spec ("Test_Name") use "test_name_tasking.ads";
      for Spec ("Istack_Handler") use "istack_handler_tasking.ads";
      for Body ("Istack_Handler") use "istack_handler_tasking.adb";
   end Naming;

   package Builder is
      for Executable ("interrupt_stack_peak_test.adb") use "interrupt_stack_peak_tasking_test";
      for Executable_Suffix use ".elf";
   end Builder;

   package Compiler is
      for Default_Switches ("Ada") use
        ("-O2", "-g", "-gnat2022", "-gnatwa", "-gnatwe", "-gnaty",
         "-ffunction-sections", "-fdata-sections") & Analysis & Repro_Switches;
      for Default_Switches ("Asm_Cpp") use ("-g") & Repro_Switches;
   end Compiler;

   package Linker is
      for Default_Switches ("Ada") use Mpfs_Link.Switches;
   end Linker;
end App;
