--  SPDX-License-Identifier: Apache-2.0
--
--  Six images of the console of the runtime (System.Text_IO), each linked
--  with the console symbols of its own partition (Mpfs_Link, per main; the
--  IMAGE_<main> lines of example.conf): textio_test (MMUART0),
--  console_mmuart1_test to console_mmuart4_test (that MMUART) and
--  console_noinit_test (MMUART0, __mpfs_console_init = 0). Test_Report is the
--  shared one; its output goes through System.Text_IO (src/bare_console.adb
--  is the body of the Bare_Console of examples/bare_hello). The register
--  package of the PAC (mpfs_pac.gpr) is the test's view of the MMUART.
--
--  Build contract: see examples/STYLE.md.

with "../../crates/mpfs_rts/mpfs_rts.gpr";
with "../../crates/mpfs_rts/mpfs_link.gpr";
with "../../libs/mpfs_pac/mpfs_pac.gpr";

project App is
   Hart := Mpfs_Rts.Hart;

   --  STACK_ANALYSIS=1 (./x stack) makes the compiler also write the stack
   --  usage (.su) and the call graph (.ci) of every unit. The code is the same.
   type Switch is ("0", "1");
   Stack_Analysis : Switch := external ("STACK_ANALYSIS", "0");
   Analysis := ();
   case Stack_Analysis is
      when "1" => Analysis := ("-fstack-usage", "-fcallgraph-info=su,da");
      when "0" => null;
   end case;

   --  The build directory must not reach the image (./x repro): see examples/STYLE.md.
   Sdk_Root := external ("ADA_MPFS_SDK", "");
   Repro_Switches := ("-gno-record-gcc-switches");
   case Sdk_Root is
      when ""     => null;
      when others =>
         Repro_Switches := Repro_Switches
           & ("-ffile-prefix-map=" & Sdk_Root & "=.");
   end case;

   for Languages use ("Ada");
   for Target use Mpfs_Rts.Target;
   for Runtime ("Ada") use Mpfs_Rts.Runtime_Path;
   --  The spec of Bare_Console is bare_hello's, its body is src/bare_console.adb.
   for Source_Dirs use ("src", "../bare_hello/src", "../../tests/common");
   for Object_Dir use "obj-" & Hart;
   for Exec_Dir use "bin-" & Hart;
   for Main use
     ("textio_test.adb",
      "console_mmuart1_test.adb", "console_mmuart2_test.adb",
      "console_mmuart3_test.adb", "console_mmuart4_test.adb",
      "console_noinit_test.adb");

   package Builder is
      for Executable_Suffix use ".elf";
   end Builder;

   package Compiler is
      for Default_Switches ("Ada") use
        ("-O2", "-g", "-gnat2022", "-gnatwa", "-gnatw.X", "-gnatwe", "-gnaty",
         "-ffunction-sections", "-fdata-sections") & Analysis & Repro_Switches;
   end Compiler;

   --  Every main has its own partition: ./x build writes MPFS_DEFSYMS for textio_test and
   --  MPFS_DEFSYMS_<main> for the others, from the IMAGE_<main> lines of example.conf.
   package Linker is
      for Default_Switches ("Ada") use Mpfs_Link.Switches;
      for Switches ("console_mmuart1_test.adb") use
        Mpfs_Link.Common & external_as_list ("MPFS_DEFSYMS_console_mmuart1_test", ";");
      for Switches ("console_mmuart2_test.adb") use
        Mpfs_Link.Common & external_as_list ("MPFS_DEFSYMS_console_mmuart2_test", ";");
      for Switches ("console_mmuart3_test.adb") use
        Mpfs_Link.Common & external_as_list ("MPFS_DEFSYMS_console_mmuart3_test", ";");
      for Switches ("console_mmuart4_test.adb") use
        Mpfs_Link.Common & external_as_list ("MPFS_DEFSYMS_console_mmuart4_test", ";");
      for Switches ("console_noinit_test.adb") use
        Mpfs_Link.Common & external_as_list ("MPFS_DEFSYMS_console_noinit_test", ";");
   end Linker;
end App;
