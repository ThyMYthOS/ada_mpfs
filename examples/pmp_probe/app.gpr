--
--  Same construction as examples/bare_hello (start.S and Bare_Console are
--  shared with it); see there.
--
--  Build contract: see examples/STYLE.md.

project App is
   type Hart_Kind is ("e51", "u54");
   Hart : Hart_Kind := external ("MPFS_HART", "e51");

   --  The ABI of the image. The E51 has no FPU.
   Arch := "";
   Abi  := "";
   case Hart is
      when "e51" =>
         Arch := "rv64imac_zicsr_zifencei";
         Abi  := "lp64";
      when "u54" =>
         Arch := "rv64imafdc_zicsr_zifencei";
         Abi  := "lp64d";
   end case;

   for Languages use ("Ada", "Asm_Cpp");
   for Target use "riscv64-elf";
   for Runtime ("Ada") use "light-polarfiresoc";
   for Source_Dirs use (".", "src", "../bare_hello", "../bare_hello/src");
   --  Only what the image needs of the shared directories.
   for Source_Files use
     ("start.S", "pmp_mask.S", "bare_console.ads", "bare_console.adb",
      "pmp_probe.ads", "pmp_probe.adb");
   for Object_Dir use "obj-" & Hart;
   for Exec_Dir use "bin-" & Hart;
   for Main use ("pmp_probe.adb");

   Common := ("-march=" & Arch, "-mabi=" & Abi, "-mcmodel=medany");

   package Compiler is
      for Default_Switches ("Ada") use Common &
        ("-O2", "-g", "-gnat2022", "-gnatwa", "-gnatwe", "-gnaty",
         "-ffunction-sections", "-fdata-sections");
      for Default_Switches ("Asm_Cpp") use Common & ("-g");
   end Compiler;
end App;
