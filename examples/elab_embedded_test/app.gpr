--
--  The elab_tasking_test of the embedded profile. The sources are those of
--  examples/elab_tasking_test; the name of the test and of the image is
--  elab_embedded_test (examples/STYLE.md, "Profile variants").
--
--  Build contract: see examples/STYLE.md.

with "../../crates/mpfs_rts/mpfs_rts.gpr";
with "../../crates/mpfs_rts/mpfs_link.gpr";

project App is
   Hart := Mpfs_Rts.Hart;

   --  STACK_ANALYSIS=1 (./x stack) makes the compiler also write the stack
   --  usage (.su) and the call graph (.ci) of every unit. The code is the same.
   type Switch is ("0", "1");
   Stack_Analysis : Switch := external ("STACK_ANALYSIS", "0");
   Analysis := ();
   case Stack_Analysis is
      when "1" => Analysis := ("-fstack-usage", "-fcallgraph-info=su,da");
      when "0" => null;
   end case;

   --  The build directory must not reach the image (./x repro): see examples/STYLE.md.
   Sdk_Root := external ("ADA_MPFS_SDK", "");
   Repro_Switches := ("-gno-record-gcc-switches");
   case Sdk_Root is
      when ""     => null;
      when others =>
         Repro_Switches := Repro_Switches
           & ("-ffile-prefix-map=" & Sdk_Root & "=.");
   end case;

   --  The image of one U54 hart other than hart 1 (./x build --hart u54 --harts 3) is kept next
   --  to the one of hart 1: bin-u54-h3/, see examples/STYLE.md.
   Suffix := "";
   case Mpfs_Link.Harts is
      when "2" | "3" | "4" => Suffix := "-h" & Mpfs_Link.Harts;
      when others          => null;
   end case;

   for Languages use ("Ada");
   for Target use Mpfs_Rts.Target;
   for Runtime ("Ada") use Mpfs_Rts.Runtime_Path;
   for Source_Dirs use ("src", "../elab_tasking_test/src", "../elab_test/src", "../bare_hello/src", "../../tests/common");
   --  Only what the image needs of the shared directories.
   for Source_Files use
     ("elab_tasking_test.adb", "elab_tasks.ads", "elab_tasks.adb",
      "elab_log.ads", "elab_log.adb", "elab_a.ads", "elab_a.adb",
      "elab_b.ads", "elab_b.adb", "elab_c.ads", "elab_c.adb",
      "elab_checks.ads", "elab_checks.adb",
      "test_name_embedded.ads",
      "bare_console.ads", "bare_console.adb",
      "test_report.ads", "test_report.adb");
   for Object_Dir use "obj-" & Hart & Suffix;
   for Exec_Dir use "bin-" & Hart & Suffix;
   for Main use ("elab_tasking_test.adb");

   package Naming is
      for Spec ("Test_Name") use "test_name_embedded.ads";
   end Naming;

   package Builder is
      for Executable ("elab_tasking_test.adb") use "elab_embedded_test";
      for Executable_Suffix use ".elf";
   end Builder;

   package Compiler is
      for Default_Switches ("Ada") use
        ("-O2", "-g", "-gnat2022", "-gnatwa", "-gnatw.X", "-gnatwe", "-gnaty",
         "-ffunction-sections", "-fdata-sections") & Analysis & Repro_Switches;
   end Compiler;

   package Linker is
      for Default_Switches ("Ada") use Mpfs_Link.Switches;
   end Linker;
end App;
