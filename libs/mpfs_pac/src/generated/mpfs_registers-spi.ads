      Reserved_8_31 at 0 range 8 .. 31;
   end record;

   type CTRL3_Register is record
      --  Aliased CONTROL register bits 31:24. This register allows byte
      --  operations from an 8-bit processor in the fabric. It is not intended
      --  for access from internal MSS masters.
      CTRL3         : MPFS_Registers.UInt8 := 16#80#;
      --  unspecified
      Reserved_8_31 : MPFS_Registers.UInt24 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for CTRL3_Register use record
      CTRL3         at 0 range 0 .. 7;
      Reserved_8_31 at 0 range 8 .. 31;
   end record;

   type FRAMESUP_Register is record
      --  W: No operation. R: Returns the lower 16 bits of the byte count from
      --  the FRAMES register.
      BYTESLOWER : MPFS_Registers.UInt16 := 16#1#;
      --  W: Writes the upper 16 bits of the number of bytes to be transmitted.
      --  R: Returns the written value.
      BYTESUPPER : MPFS_Registers.UInt16 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for FRAMESUP_Register use record
      BYTESLOWER at 0 range 0 .. 15;
      BYTESUPPER at 0 range 16 .. 31;
   end record;

   -----------------
   -- Peripherals --
   -----------------

   --  SPI_A_HI Controller
   type SPI_Peripheral is record
      --  Control register
      CONTROL      : aliased CONTROL_Register;
      --  Transmit and receive data frame size
      FRAMESIZE    : aliased FRAMESIZE_Register;
      --  Status register
      STATUS       : aliased STATUS_Register;
      --  Interrupt clear register
      INT_CLEAR    : aliased INT_CLEAR_Register;
      --  Receive data register
      RX_DATA      : aliased MPFS_Registers.UInt32;
      --  Transmit data register
      TX_DATA      : aliased MPFS_Registers.UInt32;
      --  Output clock generator (Master mode)
      CLK_GEN      : aliased CLK_GEN_Register;
      --  Specifies slave selected (Master mode)
      SLAVE_SELECT : aliased SLAVE_SELECT_Register;
      --  Masked interrupt status
      INTMASK      : aliased INTMASK_Register;
      --  Raw interrupt status
      INTRAW       : aliased INTRAW_Register;
      --  Control bits for enhanced modes
      CONTROL2     : aliased CONTROL2_Register;
      --  Command register
      COMMAND      : aliased COMMAND_Register;
      --  Packet size
      PKTSIZE      : aliased PKTSIZE_Register;
      --  Command size
      CMD_SIZE     : aliased CMD_SIZE_Register;
      --  Slave hardware status
      HWSTATUS     : aliased HWSTATUS_Register;
      --  Status register
      STAT8        : aliased STAT8_Register;
      CTRL0        : aliased CTRL0_Register;
      CTRL1        : aliased CTRL1_Register;
      CTRL2        : aliased CTRL2_Register;
      CTRL3        : aliased CTRL3_Register;
      FRAMESUP     : aliased FRAMESUP_Register;
   end record
     with Volatile;

   for SPI_Peripheral use record
      CONTROL      at 16#0# range 0 .. 31;
      FRAMESIZE    at 16#4# range 0 .. 31;
      STATUS       at 16#8# range 0 .. 31;
      INT_CLEAR    at 16#C# range 0 .. 31;
      RX_DATA      at 16#10# range 0 .. 31;
      TX_DATA      at 16#14# range 0 .. 31;
      CLK_GEN      at 16#18# range 0 .. 31;
      SLAVE_SELECT at 16#1C# range 0 .. 31;
      INTMASK      at 16#20# range 0 .. 31;
      INTRAW       at 16#24# range 0 .. 31;
      CONTROL2     at 16#28# range 0 .. 31;
      COMMAND      at 16#2C# range 0 .. 31;
      PKTSIZE      at 16#30# range 0 .. 31;
      CMD_SIZE     at 16#34# range 0 .. 31;
      HWSTATUS     at 16#38# range 0 .. 31;
      STAT8        at 16#3C# range 0 .. 31;
      CTRL0        at 16#40# range 0 .. 31;
      CTRL1        at 16#44# range 0 .. 31;
      CTRL2        at 16#48# range 0 .. 31;
      CTRL3        at 16#4C# range 0 .. 31;
      FRAMESUP     at 16#50# range 0 .. 31;
   end record;

   --  SPI_A_HI Controller
   SPI_A_HI_Periph : aliased SPI_Peripheral
     with Import, Address => SPI_A_HI_Base,
          Volatile, Async_Readers, Async_Writers, Effective_Writes,
          Effective_Reads => True;

   --  SPI_A_LO Controller
   SPI_A_LO_Periph : aliased SPI_Peripheral
     with Import, Address => SPI_A_LO_Base,
          Volatile, Async_Readers, Async_Writers, Effective_Writes,
          Effective_Reads => True;

   --  SPI_B_HI Controller
   SPI_B_HI_Periph : aliased SPI_Peripheral
     with Import, Address => SPI_B_HI_Base,
          Volatile, Async_Readers, Async_Writers, Effective_Writes,
          Effective_Reads => True;

   --  SPI_B_LO Controller
   SPI_B_LO_Periph : aliased SPI_Peripheral
     with Import, Address => SPI_B_LO_Base,
          Volatile, Async_Readers, Async_Writers, Effective_Writes,
          Effective_Reads => True;

end MPFS_Registers.SPI;
