   --  CFG_DDR_SGMII_PHY Controller
   type CFG_DDR_SGMII_PHY_Peripheral is record
      --  Compulsory register for all SCB slaves, facilitating global soft
      --  reset.
      SOFT_RESET_DDR_PHY                 : aliased SOFT_RESET_DDR_PHY_Register;
      --  DDRPHY MODE Register
      DDRPHY_MODE                        : aliased DDRPHY_MODE_Register;
      --  DDRPHY STARTUP register
      DDRPHY_STARTUP                     : aliased DDRPHY_STARTUP_Register;
      --  spare logic
      SPARE_0                            : aliased SPARE_0_Register;
      --  This is a compulsory register for all SCB slaves and must be at the
      --  same offset in all slaves to facilitate global soft reset of all SCB
      --  registers with a single broadcast write from the SCB master.
      SOFT_RESET_MAIN_PLL                : aliased SOFT_RESET_MAIN_PLL_Register;
      --  PLL control register
      PLL_CTRL_MAIN                      : aliased PLL_CTRL_MAIN_Register;
      --  PLL reference and feedback registers
      PLL_REF_FB_MAIN                    : aliased PLL_REF_FB_MAIN_Register;
      --  PLL fractional register
      PLL_FRACN_MAIN                     : aliased MPFS_Registers.UInt32;
      --  PLL 0/1 division registers
      PLL_DIV_0_1_MAIN                   : aliased PLL_DIV_0_1_MAIN_Register;
      --  PLL 2/3 division registers
      PLL_DIV_2_3_MAIN                   : aliased PLL_DIV_2_3_MAIN_Register;
      --  PLL control register
      PLL_CTRL2_MAIN                     : aliased PLL_CTRL2_MAIN_Register;
      --  PLL calibration register
      PLL_CAL_MAIN                       : aliased MPFS_Registers.UInt32;
      --  PLL phase registers
      PLL_PHADJ_MAIN                     : aliased PLL_PHADJ_MAIN_Register;
      --  SSCG registers 0
      SSCG_REG_0_MAIN                    : aliased MPFS_Registers.UInt32;
      --  SSCG registers 1
      SSCG_REG_1_MAIN                    : aliased MPFS_Registers.UInt32;
      --  SSCG registers 2
      SSCG_REG_2_MAIN                    : aliased SSCG_REG_2_MAIN_Register;
      --  SSCG registers 3
      SSCG_REG_3_MAIN                    : aliased MPFS_Registers.UInt32;
