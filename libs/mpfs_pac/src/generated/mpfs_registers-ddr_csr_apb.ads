      --  cfg_regdimm + cfg_dfi_t_rddata_en - 9 Half-Rate: CAS read latency +
      --  Additive Latency + Parity Latency (DDR4 only) + Command Address
      --  Latency (DDR4 only) + cfg_regdimm + cfg_dfi_t_rddata_en - 19
