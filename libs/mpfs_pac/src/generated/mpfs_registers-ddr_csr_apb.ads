   type CFG_DFI_T_RDDATA_EN_Register is record
      --  Used to derive the delay from assertion of read command to
      --  dfi_rddata_en assertion at the DFI interface. The resulting delay,
      --  referred to as tRDDATA_EN in the DFI specification, is calculated
      --  below. Full-Rate: CAS read latency + Additive Latency + Parity
