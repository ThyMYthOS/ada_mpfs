      --  unspecified
      Reserved_4_31          : MPFS_Registers.UInt28 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for INIT_READ_CAPTURE_ADDR_Register use record
      INIT_READ_CAPTURE_ADDR at 0 range 0 .. 3;
      Reserved_4_31          at 0 range 4 .. 31;
   end record;

   type INIT_READ_CAPTURE_DATA_4_Register is record
