   end record;

   --  SRS21 - ADMA Error Status
   type SRS21_Register is record
      --  Read-only. EADMAS - ADMA Error State\n\n The value of this field
      --  reflects the state of the ADMA state machine. The possible values
      --  are:\n 00b - ST_STOP (ADMA Stopped)\n 01b - ST_FDS (Fetching
      --  descriptor)\n 10b - not used\n 11b - ST_TRF (Transfer data)
      EADMAS        : MPFS_Registers.UInt2;
      --  Read-only. EADMAL - ADMA Length Mismatch Error\n\n This bit is set
      --  when:\n - total data length specified in ADMA descriptors is
      --  different from that specified by the Block Count and Block Length
      --  fields (if Block Count Enable is set).\n - total data length cannot
      --  be divided into complete blocks of specified length (if Block Count
      --  Enable is not set).
      EADMAL        : Boolean;
      --  unspecified
      Reserved_3_31 : MPFS_Registers.UInt29;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for SRS21_Register use record
      EADMAS        at 0 range 0 .. 1;
      EADMAL        at 0 range 2 .. 2;
      Reserved_3_31 at 0 range 3 .. 31;
   end record;

