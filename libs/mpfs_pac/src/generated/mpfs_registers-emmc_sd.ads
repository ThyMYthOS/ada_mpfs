      ECCRC_FE       at 0 range 17 .. 17;
      ECEB_FE        at 0 range 18 .. 18;
      ECI_FE         at 0 range 19 .. 19;
      EDT_FE         at 0 range 20 .. 20;
      EDCRC_FE       at 0 range 21 .. 21;
      EDEB_FE        at 0 range 22 .. 22;
      ECL_FE         at 0 range 23 .. 23;
      EAC_FE         at 0 range 24 .. 24;
      EADMA_FE       at 0 range 25 .. 25;
      ETUNE_FE       at 0 range 26 .. 26;
