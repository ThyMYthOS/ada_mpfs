      ECI_IE         : Boolean := False;
      --  EDT_IE - Data Timeout Error Interrupt Enable (SD mode only)\n\n 1 -
      --  enabled\n 0 - masked
      EDT_IE         : Boolean := False;
      --  EDCRC_IE - Data CRC Error Interrupt Enable (SD mode only)\n\n 1 -
      --  enabled\n 0 - masked
      EDCRC_IE       : Boolean := False;
      --  EDEB_IE - Data End Bit Error Interrupt Enable (SD mode only)\n\n 1 -
      --  enabled\n 0 - masked
      EDEB_IE        : Boolean := False;
      --  ECL_IE - Current Limit Error Interrupt Enable (SD mode only)\n\n 1 -
      --  enabled\n 0 - masked
      ECL_IE         : Boolean := False;
      --  EAC_IE - Auto CMD Error Interrupt Enable (SD mode only)\n\n 1 -
      --  enabled\n 0 - masked
      EAC_IE         : Boolean := False;
      --  EADMA_IE - ADMA Error Interrupt Enable (SD mode only)\n\n 1 -
      --  enabled\n 0 - masked
      EADMA_IE       : Boolean := False;
      --  unspecified
      Reserved_26_26 : MPFS_Registers.Bit := 16#0#;
      --  ERSP_IE - Response Error Interrupt Enable\n\n 1 - enabled\n 0 -
      --  masked
      ERSP_IE        : Boolean := False;
      --  unspecified
      Reserved_28_31 : MPFS_Registers.UInt4 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for SRS14_Register use record
