   --  CQRS00 - Command Queuing Version
   type CQRS00_Register is record
      --  Read-only. CQVN3 - eMMC Version Suffix\n\n Suffix version number of
      --  supported eMMC standard - 0.
      CQVN3          : MPFS_Registers.UInt4;
      --  Read-only. CQVN2 - eMMC Minor Version Number\n\n Minor version number
      --  of supported eMMC standard - 1.
      CQVN2          : MPFS_Registers.UInt4;
      --  Read-only. CQVN1 - eMMC Major Version Number\n\n Major version number
      --  of supported eMMC standard - 5.
      CQVN1          : MPFS_Registers.UInt4;
      --  unspecified
      Reserved_12_31 : MPFS_Registers.UInt20;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for CQRS00_Register use record
      CQVN3          at 0 range 0 .. 3;
      CQVN2          at 0 range 4 .. 7;
      CQVN1          at 0 range 8 .. 11;
      Reserved_12_31 at 0 range 12 .. 31;
   end record;

   --  CQRS01 - Command Queuing Capabilities
   type CQRS01_Register is record
      --  Read-only. ITCFVAL - Internal Timer Clock Frequency Value
      --  (ITCFVAL)\n\n Value defines internal clock frequency for the
      --  coalescing timer and for the SQS polling period. The frequency is
      --  equal to ITCFMUL * ITCFVAL.
      ITCFVAL        : MPFS_Registers.UInt10;
      --  unspecified
      Reserved_10_11 : MPFS_Registers.UInt2;
      --  Read-only. ITCFMUL - Internal Timer Clock Frequency Multiplier
      --  (ITCFMUL)\n\n Defines multiplier of internal clock frequency for the
      --  coalescing timer and for the SQS polling period.\n 0 - 0.001 MHz\n 1
      --  - 0.01 MHz\n 2 - 0.1 MHz\n 3 - 1 MHz\n 4 - 10 MHz\n\n The ITCFMUL and
      --  ITCFVAL defines the clock frequency.
      ITCFMUL        : MPFS_Registers.UInt4;
      --  unspecified
      Reserved_16_31 : MPFS_Registers.UInt16;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for CQRS01_Register use record
      ITCFVAL        at 0 range 0 .. 9;
      Reserved_10_11 at 0 range 10 .. 11;
      ITCFMUL        at 0 range 12 .. 15;
      Reserved_16_31 at 0 range 16 .. 31;
   end record;

   --  CQRS02 - Command Queuing Configuration
   type CQRS02_Register is record
      --  CQE - Command Queuing Enable\n\n Enables (1) or disables (0) the
      --  Command Queuing. This bit can be enabled only when all previous
      --  transactions are completed. This bit can be cleared only when all
      --  tasks are completed or cleared.
      CQE            : Boolean := False;
      --  unspecified
      Reserved_1_7   : MPFS_Registers.UInt7 := 16#0#;
      --  CQTDS - Task Descriptor\n\n Size Expect 128 bit (1) or 64 bit (0)
      --  task descriptor. This setting can be changed only when Command
      --  Queuing is disabled (CQE = 0).
      CQTDS          : Boolean := False;
      --  unspecified
      Reserved_9_11  : MPFS_Registers.UInt3 := 16#0#;
      --  CQDCE - Direct Command (DCMD) Enable\n\n Process Task Descriptor for
      --  slot 31 as Data Transfer Task Descriptor (0) or Direct Command Task
      --  Descriptor (1).
      CQDCE          : Boolean := False;
      --  unspecified
      Reserved_13_31 : MPFS_Registers.UInt19 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for CQRS02_Register use record
      CQE            at 0 range 0 .. 0;
      Reserved_1_7   at 0 range 1 .. 7;
      CQTDS          at 0 range 8 .. 8;
      Reserved_9_11  at 0 range 9 .. 11;
      CQDCE          at 0 range 12 .. 12;
      Reserved_13_31 at 0 range 13 .. 31;
   end record;

   --  CQRS03 - Command Queuing Control
   type CQRS03_Register is record
      --  CQHLT - Halt CQ\n\n Engine can be halted by writing this bit 1. Any
      --  pending operation will be completed, and awaiting operation will be
      --  stopped. Once all tasks are completed or stopped this bit is set 1.
      --  The host controller will not automatically start any new operation,
      --  but software can use SRS registers to issue any command directly
      --  bypassing CQE. CQ Engine starts operation after being halted by
      --  writing 0 to this register. Writing 0 is ignored when CQ Engine is
      --  not halted.
      CQHLT         : Boolean := False;
      --  unspecified
      Reserved_1_7  : MPFS_Registers.UInt7 := 16#0#;
      --  CQCAT - Clear All Tasks\n\n Clears (1) all active tasks in the host
      --  controller. Software has to poll this register until operation is
      --  completed (bit is automatically cleared). Software can set this bit
      --  only when the CQ Engine is halted. Software has to clear all
      --  requested tasks in the eMMC device. Writing (0) has no effect.
      CQCAT         : Boolean := False;
      --  unspecified
      Reserved_9_31 : MPFS_Registers.UInt23 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for CQRS03_Register use record
      CQHLT         at 0 range 0 .. 0;
      Reserved_1_7  at 0 range 1 .. 7;
      CQCAT         at 0 range 8 .. 8;
      Reserved_9_31 at 0 range 9 .. 31;
   end record;

   --  CQRS04 - Command Queuing Interrupt Status\n This register has several
   --  status bit related to specific interrupt event. When even happened and
   --  related Command Queuing Interrupt Status Enable is set, the status bit
   --  is set to 1. The bits can be cleared by S/W.\n Write 0 clears bit.\n
   --  Write 1 is ignored.
   type CQRS04_Register is record
      --  CQHAC - Halt Complete Interrupt (HAC)\n\n CQE sets this bit when
      --  value of CQHLT changed from 0 to 1.
      CQHAC         : Boolean := False;
      --  CQTCC - Task Complete Interrupt (TCC)\n\n CQE sets this bit when
      --  either a task with INT=1 is completed or Interrupt Coalescing reports
      --  interrupt.
      CQTCC         : Boolean := False;
      --  CQREDI - Response Error Detected Interrupt (RED)\n\n When an error is
      --  detected in the response received from eMMC device, the CQE sets this
      --  bit to 1. S/W can select which bits are analyzed by selecting CQRMEM.
      CQREDI        : Boolean := False;
      --  CQTCL - Task Cleared (TCL)\n\n When task clear operation or clear
      --  individual task is completed, the CQE sets this bit to 1.
      CQTCL         : Boolean := False;
      --  unspecified
      Reserved_4_31 : MPFS_Registers.UInt28 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for CQRS04_Register use record
      CQHAC         at 0 range 0 .. 0;
      CQTCC         at 0 range 1 .. 1;
      CQREDI        at 0 range 2 .. 2;
      CQTCL         at 0 range 3 .. 3;
      Reserved_4_31 at 0 range 4 .. 31;
   end record;

   --  CQRS05 - Command Queuing Interrupt Status Enable\n\n Statuses Enable
   --  bits enables interrupt sources. The status is enabled when bit is set 1
   --  (S/W wrote 1 to the field).
   type CQRS05_Register is record
      --  CQHACST - Halt Complete Status Enable (HAC)\n\n Enables CQTCLST
      --  register.
      CQHACST       : Boolean := False;
      --  CQTCCST - Task Complete Status Enable (TCC)\n\n Enables CQHAC
      --  register.
      CQTCCST       : Boolean := False;
      --  CQREDST - Response Error Detected Status Enable (RED)\n\n Enables
      --  CQREDI register.
      CQREDST       : Boolean := False;
      --  CQTCLST - Task Cleared Status Enable (TCL)\n\n Enables CQTCL
      --  register.
      CQTCLST       : Boolean := False;
      --  unspecified
      Reserved_4_31 : MPFS_Registers.UInt28 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for CQRS05_Register use record
      CQHACST       at 0 range 0 .. 0;
      CQTCCST       at 0 range 1 .. 1;
      CQREDST       at 0 range 2 .. 2;
      CQTCLST       at 0 range 3 .. 3;
      Reserved_4_31 at 0 range 4 .. 31;
   end record;

   --  CQRS06 - Command Queuing Interrupt Signal Enable\n This register allows
   --  to turn on or turn off interrupt notification separately for each bit of
   --  the Command Queuing Interrupt Status. When Interrupt status bit is set 1
   --  and related field in this register is set (S/W wrote 1 to the filed),
   --  the Interrupt Status is reported on interrupt port.
   type CQRS06_Register is record
      --  CQHACSI - Halt Complete Signal Enable (HAC)\n\n Enables interrupt
      --  signaling from CQHLT register.
      CQHACSI       : Boolean := False;
      --  CQTCCSI - Task Complete Signal Enable (TCC)\n\n Enables interrupt
      --  signaling from CQTCC register.
      CQTCCSI       : Boolean := False;
      --  CQREDSI - Response Error Detected Signal Enable (TCC)\n\n Enables
      --  interrupt signaling from CQREDI register.
      CQREDSI       : Boolean := False;
      --  CQTCLSI - Task Cleared Signal Enable (TCL)\n\n Enables interrupt
      --  signaling from CQTCL register.
      CQTCLSI       : Boolean := False;
      --  unspecified
      Reserved_4_31 : MPFS_Registers.UInt28 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for CQRS06_Register use record
      CQHACSI       at 0 range 0 .. 0;
      CQTCCSI       at 0 range 1 .. 1;
      CQREDSI       at 0 range 2 .. 2;
      CQTCLSI       at 0 range 3 .. 3;
      Reserved_4_31 at 0 range 4 .. 31;
   end record;

   --  CQRS07 - Interrupt Coalescing\n\n This register allows to group a CQ
   --  transfer and report single interrupt for entire group of requested
   --  tasks.
   type CQRS07_Register is record
      --  CQICTOVAL - Interrupt Coalescing Timeout Value (ICTOVAL)\n\n CQE
      --  generates interrupt when internal counter reaches period defined in
      --  this field. The counter starts when first transfer with INT=0 is
      --  completed. The counter increments each time when Internal Clock *
      --  1024 period elapsed. S/W can disable this timer by setting this filed
      --  to 0.
      CQICTOVAL      : MPFS_Registers.UInt7 := 16#0#;
      --  CQICTOVALEN - Interrupt Coalescing Timeout Value Write Enable
      --  (ICTOVALWEN)\n\n This is write enable for CQICTOVAL. When this bit is
      --  set 1, the field will be updated.
      CQICTOVALEN    : Boolean := False;
      --  CQICCTH - Interrupt Coalescing Counter Threshold (ICCTH)\n\n CQE
      --  increments internal counter when task with INT=0 is completed. When
      --  internal counter reaches this value the coalescing generates
      --  interrupt. S/W can select treshold value in range 1 to 31. S/W can
      --  disable internal counter and interrupt generation by setting this
      --  field to 0.
      CQICCTH        : MPFS_Registers.UInt5 := 16#0#;
      --  unspecified
      Reserved_13_14 : MPFS_Registers.UInt2 := 16#0#;
      --  CQICCTHWEN - Interrupt Coalescing Counter Threshold Write Enable
      --  (ICCTHWEN)\n\n This is write enable for CQICCTH. When this bit is set
      --  1, the field will be updated.
      CQICCTHWEN     : Boolean := False;
      --  CQICCTR - Counter and Timer Reset(ICCTR)\n\n S/W resets interrupt
      --  coalescing timer and counter.
      CQICCTR        : Boolean := False;
      --  unspecified
      Reserved_17_19 : MPFS_Registers.UInt3 := 16#0#;
      --  Read-only. CQICSB - Interrupt Coalescing Status Bit (ICSB)\n\n CQE
      --  sets this bit 1 when any task with INT=0 is completed.
      CQICSB         : Boolean := False;
      --  unspecified
      Reserved_21_30 : MPFS_Registers.UInt10 := 16#0#;
      --  CQICED - Interrupt Coalescing Enable/Disable\n\n Enables coalescing
      --  mechanism allowing to generate coalescing interrupts.
      CQICED         : Boolean := False;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for CQRS07_Register use record
      CQICTOVAL      at 0 range 0 .. 6;
      CQICTOVALEN    at 0 range 7 .. 7;
      CQICCTH        at 0 range 8 .. 12;
      Reserved_13_14 at 0 range 13 .. 14;
      CQICCTHWEN     at 0 range 15 .. 15;
      CQICCTR        at 0 range 16 .. 16;
      Reserved_17_19 at 0 range 17 .. 19;
      CQICSB         at 0 range 20 .. 20;
      Reserved_21_30 at 0 range 21 .. 30;
      CQICED         at 0 range 31 .. 31;
   end record;

   --  CQRS10_CQTD array
   type CQRS10_CQTD_Field_Array is array (0 .. 31) of Boolean
     with Component_Size => 1, Size => 32;

   --  CQRS10 - Command Queuing Task Doorbell\n CQ has 32 tasks have individual
   --  bits to start operation on desired task. The S/W writes 1 on any
   --  position from 0 to 31 to start task 0 to 31. The S/W can request more
   --  than one task in single write. The CQ Engine process tasks in order they
   --  were requested:\n - when more than one task is requested in single
   --  register write, the task with lower number has higher priority over task
   --  with higher number\n - task(s) requested in earlier register write has
   --  higher priority over task(s) in later register write\n The order of the
   --  tasks are maintained during all phases of transaction. If given task is
   --  not ready for execution, the CQ Engine takes next task with highest
   --  number.\n CQ Engine needs several clock cycles to push requested in the
   --  single register write Task Doorbell to queue. The slave interface ends
   --  write transfer as soon all tasks are in the queue.\n When S/W writes 0
   --  to bit in this register, the related task won't start - this value is
   --  ignored.\n Task Doorbell bit remain 1 until task execution is completed,
   --  task is cleared by Clear All Task or Clear Task with this number or CQ
   --  Engine is disabled (CQE=0).
   type CQRS10_Register
     (As_Array : Boolean := False)
   is record
      case As_Array is
         when False =>
            --  CQTD as a value
            Val : MPFS_Registers.UInt32;
         when True =>
            --  CQTD as an array
            Arr : CQRS10_CQTD_Field_Array;
      end case;
   end record
     with Unchecked_Union, Size => 32, Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for CQRS10_Register use record
      Val at 0 range 0 .. 31;
      Arr at 0 range 0 .. 31;
   end record;

   --  CQRS11_CQTCN array
   type CQRS11_CQTCN_Field_Array is array (0 .. 31) of Boolean
     with Component_Size => 1, Size => 32;

   --  CQRS11 - Task Complete Notification\n 32 bits related to 32 tasks. If
   --  task N is completed N bit is set 1. Bit that is set 1 can be cleared by
   --  writing 1 to this bit.
   type CQRS11_Register
     (As_Array : Boolean := False)
   is record
      case As_Array is
         when False =>
            --  CQTCN as a value
            Val : MPFS_Registers.UInt32;
         when True =>
            --  CQTCN as an array
            Arr : CQRS11_CQTCN_Field_Array;
      end case;
   end record
     with Unchecked_Union, Size => 32, Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for CQRS11_Register use record
      Val at 0 range 0 .. 31;
      Arr at 0 range 0 .. 31;
   end record;

   --  CQRS13_CQDPT array
   type CQRS13_CQDPT_Field_Array is array (0 .. 31) of Boolean
     with Component_Size => 1, Size => 32;

   --  CQRS13 - Device Pending Tasks\n This register information which task is
   --  submitted to eMMC (CMD44 and CMD45 was sent) and is not executed. Task N
   --  is submitted and not executed when N bit is set 1. Bit N is cleared when
   --  task N is completed.
   type CQRS13_Register
     (As_Array : Boolean := False)
   is record
      case As_Array is
         when False =>
            --  CQDPT as a value
            Val : MPFS_Registers.UInt32;
         when True =>
            --  CQDPT as an array
            Arr : CQRS13_CQDPT_Field_Array;
      end case;
   end record
     with Unchecked_Union, Size => 32, Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for CQRS13_Register use record
      Val at 0 range 0 .. 31;
      Arr at 0 range 0 .. 31;
   end record;

   --  CQRS14_CQTC array
   type CQRS14_CQTC_Field_Array is array (0 .. 31) of Boolean
     with Component_Size => 1, Size => 32;

   --  CQRS14 - Task Clear\n S/W writes 1 to N bit of this register to clear
   --  task N. Bit remains 1 until clear operation is completed. Once
   --  operations ends, the CQE clears this bit to 0. The S/W has to ensure the
   --  CQ Engine is halted before clearing tasks. The S/W can clear only single
   --  task. When any bit of this register is set, the S/W has no to request
   --  new task clear. This operation clears only task in the Host Controller.
   --  The S/W should take care about clearing task in the device.\n Writing 0
   --  to register is ignored.
   type CQRS14_Register
     (As_Array : Boolean := False)
   is record
      case As_Array is
         when False =>
            --  CQTC as a value
            Val : MPFS_Registers.UInt32;
         when True =>
            --  CQTC as an array
            Arr : CQRS14_CQTC_Field_Array;
      end case;
   end record
     with Unchecked_Union, Size => 32, Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for CQRS14_Register use record
      Val at 0 range 0 .. 31;
      Arr at 0 range 0 .. 31;
   end record;

   --  CQRS16 - Send Status Configuration 1
   type CQRS16_Register is record
      --  CQSSCIT - Send Status Command Idle Timer (CIT)\n\n When CQE is in
      --  idle, the host controller can poll device by sending
      --  SEND_QUEUE_STATUS (CMD13) with interval defined by this register.
      --  Accepted register value is in range 1 to 65535. The interval can be
      --  calculated as CQSSICT * internal clock period.
      CQSSCIT        : MPFS_Registers.UInt16 := 16#0#;
      --  CQSSCBC - Send Status Command Block Counter (CBC)\n\n S/W can define
      --  if and when CQE sends SEND_QUEUE_STATUS (CMD13) command during data
      --  transfer.\n When this register is set 0, the CQE does not send CMD13
      --  during data transfer. The value is 1, 2, or N means, the CQE sends
      --  CMD13 is transferred during last, one before last, or (N-1) before
      --  last block, respectively.\n Accepted register value range is 0 to 15.
      CQSSCBC        : MPFS_Registers.UInt4 := 16#0#;
      --  unspecified
      Reserved_20_31 : MPFS_Registers.UInt12 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for CQRS16_Register use record
      CQSSCIT        at 0 range 0 .. 15;
      CQSSCBC        at 0 range 16 .. 19;
      Reserved_20_31 at 0 range 20 .. 31;
   end record;

   --  CQRS17 - Send Status Configuration 2
   type CQRS17_Register is record
      --  CQSQSR - Send Queue Status RCA\n\n S/W writes 16-bit RCA value which
      --  is send as an argument in SEND_QUEUE_STATUS (CMD13) command.
      CQSQSR         : MPFS_Registers.UInt16 := 16#0#;
      --  unspecified
      Reserved_16_31 : MPFS_Registers.UInt16 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for CQRS17_Register use record
      CQSQSR         at 0 range 0 .. 15;
      Reserved_16_31 at 0 range 16 .. 31;
   end record;

   --  CQRS21 - Task Error Information
   type CQRS21_Register is record
      --  Read-only. CQRMECI - Response Mode Error Command Index\n\n Host
      --  updates this field with index of the command executed when error
      --  occurred during the command transaction.
      CQRMECI        : MPFS_Registers.UInt6;
      --  unspecified
      Reserved_6_7   : MPFS_Registers.UInt2;
      --  Read-only. CQRMETID - Response Mode Error Task ID\n\n Host updates
      --  this field with ID of the task with active command transfer when
      --  error occurred during the command transaction.
      CQRMETID       : MPFS_Registers.UInt5;
      --  unspecified
      Reserved_13_14 : MPFS_Registers.UInt2;
      --  Read-only. CQRMEFV - Response Mode Error Fields Valid\n\n Host sets
      --  this bit to 1 when error is detected and command transaction is
      --  active. Host sets this bit to 0 when error is detected and command
      --  transaction is no active.
      CQRMEFV        : Boolean;
      --  Read-only. CQDTECI - Data Transfer Error Command Index\n\n Host
      --  updates this field with index of the data transfer command executed
      --  when error occurred during the data transfer.
      CQDTECI        : MPFS_Registers.UInt6;
      --  unspecified
      Reserved_22_23 : MPFS_Registers.UInt2;
      --  Read-only. CQDTETID - Data Transfer Error Task ID\n\n Host updates
      --  this field with ID of the task with active data transfer when error
      --  occurred during the data transfer.
      CQDTETID       : MPFS_Registers.UInt5;
      --  unspecified
      Reserved_29_30 : MPFS_Registers.UInt2;
      --  Read-only. CQDTEFV - Data Transfer Error Fields Valid\n\n Host sets
      --  this bit to 1 when error is detected during data transfer. Host
      --  clears this bit to 0 when error is detected and there is no active
      --  data transfer.
      CQDTEFV        : Boolean;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for CQRS21_Register use record
      CQRMECI        at 0 range 0 .. 5;
      Reserved_6_7   at 0 range 6 .. 7;
      CQRMETID       at 0 range 8 .. 12;
      Reserved_13_14 at 0 range 13 .. 14;
      CQRMEFV        at 0 range 15 .. 15;
      CQDTECI        at 0 range 16 .. 21;
      Reserved_22_23 at 0 range 22 .. 23;
      CQDTETID       at 0 range 24 .. 28;
      Reserved_29_30 at 0 range 29 .. 30;
      CQDTEFV        at 0 range 31 .. 31;
   end record;

   --  CQRS22 - Command Response Index
   type CQRS22_Register is record
      --  Read-only. CQLCRI - Last Command Response Index\n\n Host updates this
      --  field with command index when response is received.
      CQLCRI        : MPFS_Registers.UInt6;
      --  unspecified
      Reserved_6_31 : MPFS_Registers.UInt26;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for CQRS22_Register use record
      CQLCRI        at 0 range 0 .. 5;
      Reserved_6_31 at 0 range 6 .. 31;
   end record;

