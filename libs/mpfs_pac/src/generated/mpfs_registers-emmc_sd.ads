   --  SRS20 - Force Event\n\n Each field of this register is related to the
   --  specific error status. Writing 1 to field will set the status error.
   --  This function is provided for SW debug purpose.
   type SRS20_Register is record
      --  ACNE_FE - Force Auto CMD12 Not Executed Event
      ACNE_FE        : Boolean := False;
      --  ACTE_FE - Force Auto CMD Timeout Error Event
      ACTE_FE        : Boolean := False;
      --  ACCE_FE - Force Auto CMD CRC Error Event
      ACCE_FE        : Boolean := False;
      --  ACEBE_FE - Force Auto CMD End Bit Error Event
      ACEBE_FE       : Boolean := False;
      --  ACIE_FE - Force Auto CMD Index Error Event
      ACIE_FE        : Boolean := False;
      --  unspecified
      Reserved_5_6   : MPFS_Registers.UInt2 := 16#0#;
      --  CNIACE_FE - Force Command Not Issued By Auto CMD12 Error Event
      CNIACE_FE      : Boolean := False;
      --  unspecified
      Reserved_8_15  : MPFS_Registers.UInt8 := 16#0#;
      --  ECT_FE - Force Command Timeout Error Event
      ECT_FE         : Boolean := False;
      --  ECCRC_FE - Force Command CRC Error Event
      ECCRC_FE       : Boolean := False;
      --  ECEB_FE - Force Command End Bit Error Event
      ECEB_FE        : Boolean := False;
      --  ECI_FE - Force Command Index Error Event
      ECI_FE         : Boolean := False;
      --  EDT_FE - Force Data Timeout Error Event
      EDT_FE         : Boolean := False;
      --  EDCRC_FE - Force Data CRC Error Event
      EDCRC_FE       : Boolean := False;
      --  EDEB_FE - Force Data End Bit Error Event
      EDEB_FE        : Boolean := False;
      --  ECL_FE - Force Current Limit Error Event
      ECL_FE         : Boolean := False;
      --  EAC_FE - Force Auto CMD Error Event
      EAC_FE         : Boolean := False;
      --  EADMA_FE - Force ADMA Error Event
      EADMA_FE       : Boolean := False;
      --  ETUNE_FE - Force Tuning Error Event
      ETUNE_FE       : Boolean := False;
      --  ERESP_FE - Force Response Error Event
      ERESP_FE       : Boolean := False;
      --  unspecified
      Reserved_28_31 : MPFS_Registers.UInt4 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for SRS20_Register use record
      ACNE_FE        at 0 range 0 .. 0;
      ACTE_FE        at 0 range 1 .. 1;
      ACCE_FE        at 0 range 2 .. 2;
      ACEBE_FE       at 0 range 3 .. 3;
      ACIE_FE        at 0 range 4 .. 4;
