   --  EMMC_SD Controller
   type EMMC_SD_Peripheral is record
      --  HRS00 - General Information Register
      HRS00  : aliased HRS00_Register;
      --  HRS01 - Debounce Setting Register
      HRS01  : aliased HRS01_Register;
      --  HRS02 - Bus Setting Register
      HRS02  : aliased HRS02_Register;
      --  HRS03 - AXI ERROR Responses Register\n\n These registers extend the
      --  standard set of SD-HOST interrupt statuses by information about AXI
      --  interface exceptions.\n The registers are divided into three
      --  groups:\n - Signal Enable registers allow to enable/mask signaling
      --  the Interrupt Status registers (HRS03[3:0]) on interrupt port\n -
      --  Status Enable registers allow to enable/disable interrupt source for
      --  each Interrupt Status separately\n - Interrupt Status are triggered
      --  whenever the interrupt source is detected and the Status Enable
      --  register is enabled\n
      HRS03  : aliased HRS03_Register;
      --  HRS04 - SD/eMMC PHY Registers Interface\n\n This register enables
      --  access to the SD/eMMC PHY registers. The interface behavior is
      --  described in section SD/eMMC PHY Register Interface.
      HRS04  : aliased HRS04_Register;
      --  HRS06 - eMMC control registers
      HRS06  : aliased HRS06_Register;
      --  HRS07 - IO Delay Information Register
      HRS07  : aliased HRS07_Register;
      --  HRS30 - Host Capability Register\n This register states whether
      --  configurable options are available or are not available in the
      --  SD/eMMC Host Controller configuration. This register gives such
      --  information about features not been covered by the standard
      --  capability registers (SRS16-SRS18).
      HRS30  : aliased HRS30_Register;
      --  HRS31 - Host Controller Version\n This register contains the host
      --  controller version number.
      HRS31  : aliased HRS31_Register;
      --  HRS32 - FSM Monitor Register
      HRS32  : aliased HRS32_Register;
      --  HRS33 - Tune Status 0 Register
      HRS33  : aliased MPFS_Registers.UInt32;
      --  HRS34 - Tune Status 1 Register
      HRS34  : aliased HRS34_Register;
      --  HRS35 - Tune Debug Register
      HRS35  : aliased HRS35_Register;
      --  HRS36 - Boot Status Register
      HRS36  : aliased HRS36_Register;
      --  HRS37 - Read block gap coefficient interface mode select
      HRS37  : aliased HRS37_Register;
      --  HRS38 - Read block gap coefficient
      HRS38  : aliased HRS38_Register;
      --  CRS63 - Host Controller Version/Slot Interrupt Status
      CRS63  : aliased CRS63_Register;
      --  SRS00 - SDMA System Address / Argument 2
      SRS00  : aliased MPFS_Registers.UInt32;
      --  SRS01 - Block Size / Block Count
      SRS01  : aliased SRS01_Register;
      --  SRS02 - Argument 1
      SRS02  : aliased MPFS_Registers.UInt32;
      --  SRS03 - Command/Transfer Mode
      SRS03  : aliased SRS03_Register;
      --  The SRS04 - SRS07 registers store the response returned by the
      --  card.\n The mapping of the actual device response and the SRS04 -
      --  SRS07 contents depends on the type of response. The type of response
      --  is determined by the RTS field (Response Type) for all user-defined
      --  commands.\n The separate cases are the Auto-CMD12 response (called
      --  R1b in the SD Memory Specification) and Auto-CMD23 response (called
      --  R1 in the SD Memory Specification). Auto-CMD12 and Auto-CMD23
      --  responses are handled by the core automatically and goes to the SRS07
      --  register regardless of the RTS value.\n\n SRS04-SRS07 relation to
      --  received response field:\n Auto-CMD12 resp:\n Response field R[39:8]
      --  - RESP3[31:0]\n\n Auto-CMD23 resp:\n Response field R[39:8] -
      --  RESP3[31:0]\n\n No response:\n RTS=00b\n\n 136-bit:\n RTS=01b,
      --  Response field R[127:8] - {RESP3[23:0], RESP2[31:0], RESP1[31:0],
      --  RESP0[31:0]}\n\n 48-bit:\n RTS=10b, Response field R[39:8] -
      --  RESP1[31:0]\n\n 48-bit with BUSY:\n RTS=11b, Response field R[39:8] -
      --  RESP1[31:0]\n\n Implementation note: Registers value are undefined
      --  after reset, and will be valid after response is received.
      SRS04  : aliased MPFS_Registers.UInt32;
      --  Described in SRS04.
      SRS05  : aliased MPFS_Registers.UInt32;
      --  Described in SRS04.
      SRS06  : aliased MPFS_Registers.UInt32;
      --  Described in SRS04.
      SRS07  : aliased MPFS_Registers.UInt32;
      --  SRS08 - Data Buffer
      SRS08  : aliased MPFS_Registers.UInt32;
      --  SRS09 - Present State Register
      SRS09  : aliased SRS09_Register;
      --  SRS10 - Host Control 1 (General / Power / Block-Gap / Wake-Up)
      SRS10  : aliased SRS10_Register;
      --  SRS11 - Host Control 2 (Clock, Timeout, Reset)
      SRS11  : aliased SRS11_Register;
      --  SRS12 - Error/Normal Interrupt Status
      SRS12  : aliased SRS12_Register;
      --  SRS13 - Error/Normal Status Enable
      SRS13  : aliased SRS13_Register;
      --  SRS14 - Error/Normal Signal Enable
      SRS14  : aliased SRS14_Register;
      --  SRS15 - Host Control #2 / Auto CMD Error Status
      SRS15  : aliased SRS15_Register;
      --  SRS16 - Capabilities #1\n HWINIT Register - Note this register is
      --  hardware initialized after reset and the value read back will match
      --  the IP configuration.
      SRS16  : aliased SRS16_Register;
      --  SRS17 - Capabilities #2HWINIT Register - Note this register is
      --  hardware initialized after reset and the value read back will match
      --  the IP configuration.
      SRS17  : aliased SRS17_Register;
      --  SRS18 - Capabilities #3HWINIT Register - Note this register is
      --  hardware initialized after reset and the value read back will match
      --  the IP configuration.
      SRS18  : aliased SRS18_Register;
      --  SRS19 - Capabilities #4\n HWINIT Register - Note this register is
      --  hardware initialized after reset and the value read back will match
      --  the IP configuration.
      SRS19  : aliased SRS19_Register;
      --  SRS20 - Force Event\n\n Each field of this register is related to the
      --  specific error status. Writing 1 to field will set the status error.
      --  This function is provided for SW debug purpose.
      SRS20  : aliased SRS20_Register;
      --  SRS21 - ADMA Error Status
      SRS21  : aliased SRS21_Register;
      --  SRS22 ADMA/SDMA System Address 1
      SRS22  : aliased MPFS_Registers.UInt32;
      --  SRS23 ADMA/SDMA System Address 2
      SRS23  : aliased MPFS_Registers.UInt32;
      --  SRS24 - Preset Value (Default Speed)\n\n SRS24[31:16] - Default Speed
      --  if:\n SRS15.V18SE=0\n SRS10.HSE=0\n\n HWINIT Register - Note this
      --  register is hardware initialized after reset and the value read back
      --  will match the IP configuration.
      SRS24  : aliased SRS24_Register;
      --  SRS25 - Preset Value (High Speed and SDR12)\n\n SRS25[15:0] - High
      --  Speed if:\n SRS15.V18SE=0\n SRS.HSE=1\n\n SRS25[31:16] - SDR12 if:\n
      --  SRS15.V18SE=1\n SRS15.UMS=000b\n\n HWINIT Register - Note this
      --  register is hardware initialized after reset and the value read back
      --  will match the IP configuration.
      SRS25  : aliased SRS25_Register;
      --  SRS26 - Preset Value (SDR25 and SDR50)\n\n SRS26[15:0] - SDR25 if:\n
      --  SRS15.V18SE=1\n SRS15.UMS=001b\n\n SRS26[31:16] - SDR50 if:\n
      --  SRS15.V18SE=1\n SRS15.UMS=010b\n\n HWINIT Register - Note this
      --  register is hardware initialized after reset and the value read back
      --  will match the IP configuration.
      SRS26  : aliased SRS26_Register;
      --  SRS27 - Preset Value (SDR104 and DDR50)\n\n SRS27[15:0] - SDR104
      --  if:\n SRS15.V18SE=1\n SRS15.UMS=011b\n\n SRS27[31:16] - DDR50 if:\n
      --  SRS15.V18SE=1\n SRS15.UMS=100b\n\n HWINIT Register - Note this
      --  register is hardware initialized after reset and the value read back
      --  will match the IP configuration.
      SRS27  : aliased SRS27_Register;
      --  SRS29 - Preset Value for UHS-II\n\n SRS29[15:0] - UHS-II if:\n
      --  SRS15.V18SE=0\n SRS15.UMS=111b\n\n HWINIT Register - Note this
      --  register is hardware initialized after reset and the value read back
      --  will match the IP configuration.
      SRS29  : aliased SRS29_Register;
      --  CQRS00 - Command Queuing Version
      CQRS00 : aliased CQRS00_Register;
      --  CQRS01 - Command Queuing Capabilities
      CQRS01 : aliased CQRS01_Register;
      --  CQRS02 - Command Queuing Configuration
      CQRS02 : aliased CQRS02_Register;
      --  CQRS03 - Command Queuing Control
      CQRS03 : aliased CQRS03_Register;
      --  CQRS04 - Command Queuing Interrupt Status\n This register has several
      --  status bit related to specific interrupt event. When even happened
      --  and related Command Queuing Interrupt Status Enable is set, the
      --  status bit is set to 1. The bits can be cleared by S/W.\n Write 0
      --  clears bit.\n Write 1 is ignored.
      CQRS04 : aliased CQRS04_Register;
      --  CQRS05 - Command Queuing Interrupt Status Enable\n\n Statuses Enable
      --  bits enables interrupt sources. The status is enabled when bit is set
      --  1 (S/W wrote 1 to the field).
      CQRS05 : aliased CQRS05_Register;
      --  CQRS06 - Command Queuing Interrupt Signal Enable\n This register
      --  allows to turn on or turn off interrupt notification separately for
      --  each bit of the Command Queuing Interrupt Status. When Interrupt
      --  status bit is set 1 and related field in this register is set (S/W
      --  wrote 1 to the filed), the Interrupt Status is reported on interrupt
      --  port.
      CQRS06 : aliased CQRS06_Register;
      --  CQRS07 - Interrupt Coalescing\n\n This register allows to group a CQ
      --  transfer and report single interrupt for entire group of requested
      --  tasks.
      CQRS07 : aliased CQRS07_Register;
      --  CQRS08 - Command Queuing Task Descriptor List Base Address
      CQRS08 : aliased MPFS_Registers.UInt32;
      --  CQRS09 - Command Queuing Task Descriptor List Base Address Upper 32
      --  Bits
      CQRS09 : aliased MPFS_Registers.UInt32;
      --  CQRS10 - Command Queuing Task Doorbell\n CQ has 32 tasks have
      --  individual bits to start operation on desired task. The S/W writes 1
      --  on any position from 0 to 31 to start task 0 to 31. The S/W can
      --  request more than one task in single write. The CQ Engine process
      --  tasks in order they were requested:\n - when more than one task is
      --  requested in single register write, the task with lower number has
      --  higher priority over task with higher number\n - task(s) requested in
      --  earlier register write has higher priority over task(s) in later
      --  register write\n The order of the tasks are maintained during all
      --  phases of transaction. If given task is not ready for execution, the
      --  CQ Engine takes next task with highest number.\n CQ Engine needs
      --  several clock cycles to push requested in the single register write
      --  Task Doorbell to queue. The slave interface ends write transfer as
      --  soon all tasks are in the queue.\n When S/W writes 0 to bit in this
      --  register, the related task won't start - this value is ignored.\n
      --  Task Doorbell bit remain 1 until task execution is completed, task is
      --  cleared by Clear All Task or Clear Task with this number or CQ Engine
      --  is disabled (CQE=0).
      CQRS10 : aliased CQRS10_Register;
      --  CQRS11 - Task Complete Notification\n 32 bits related to 32 tasks. If
      --  task N is completed N bit is set 1. Bit that is set 1 can be cleared
      --  by writing 1 to this bit.
      CQRS11 : aliased CQRS11_Register;
      --  CQRS12 - Device Queue Status
      CQRS12 : aliased MPFS_Registers.UInt32;
      --  CQRS13 - Device Pending Tasks\n This register information which task
      --  is submitted to eMMC (CMD44 and CMD45 was sent) and is not executed.
      --  Task N is submitted and not executed when N bit is set 1. Bit N is
      --  cleared when task N is completed.
      CQRS13 : aliased CQRS13_Register;
      --  CQRS14 - Task Clear\n S/W writes 1 to N bit of this register to clear
      --  task N. Bit remains 1 until clear operation is completed. Once
      --  operations ends, the CQE clears this bit to 0. The S/W has to ensure
      --  the CQ Engine is halted before clearing tasks. The S/W can clear only
      --  single task. When any bit of this register is set, the S/W has no to
      --  request new task clear. This operation clears only task in the Host
      --  Controller. The S/W should take care about clearing task in the
      --  device.\n Writing 0 to register is ignored.
      CQRS14 : aliased CQRS14_Register;
      --  CQRS16 - Send Status Configuration 1
      CQRS16 : aliased CQRS16_Register;
      --  CQRS17 - Send Status Configuration 2
      CQRS17 : aliased CQRS17_Register;
      --  CQRS18 - Command Response for Direct-Command Task
      CQRS18 : aliased MPFS_Registers.UInt32;
      --  CQRS20 - Response Mode Error Mask
      CQRS20 : aliased MPFS_Registers.UInt32;
      --  CQRS21 - Task Error Information
      CQRS21 : aliased CQRS21_Register;
      --  CQRS22 - Command Response Index
      CQRS22 : aliased CQRS22_Register;
      --  CQRS23 - Command Response Argument
      CQRS23 : aliased MPFS_Registers.UInt32;
   end record
     with Volatile;

