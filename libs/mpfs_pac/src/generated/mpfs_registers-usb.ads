   --  musb_read_configdata after writing INDEX 0), and the fields below do not
   --  apply: bit 7 MPRXE, 6 MPTXE, 5 BIGENDIAN, 4 HBRXE, 3 HBTXE, 2 DYNFIFO, 1
   --  SOFTCONE, 0 UTMIDW (16 bit UTMI data). The board reads 0xDE at INDEX 0.
   type INDEXED_FIFO_SIZE_Register is record
      --  Read-only. TX FIFO size encoding (log2(size/8)) [3:0]
      TX_FIFO_SZ : MPFS_Registers.UInt4;
      --  Read-only. RX FIFO size encoding (log2(size/8)) [7:4]
      RX_FIFO_SZ : MPFS_Registers.UInt4;
   end record
     with Volatile_Full_Access, Object_Size => 8,
          Bit_Order => System.Low_Order_First;

   for INDEXED_FIFO_SIZE_Register use record
      TX_FIFO_SZ at 0 range 0 .. 3;
      RX_FIFO_SZ at 0 range 4 .. 7;
   end record;

   --  Endpoint %s FIFO Data Port (32-bit access; 8- and 16-bit accesses also valid; only EP0..EP4 are implemented on the MPFS250T)

   --  Endpoint %s FIFO Data Port (32-bit access; 8- and 16-bit accesses also
   --  valid; only EP0..EP4 are implemented on the MPFS250T)
   type FIFO_Registers is array (0 .. 15) of MPFS_Registers.UInt32;

   --  OTG Device Control Register
   type DEV_CTRL_Register is record
      --  Start (write 1) or end (write 0) an OTG session
      SESSION   : Boolean := False;
      --  Host negotiation request (OTG A-device)
      HOST_REQ  : Boolean := False;
      --  Read-only. Host mode active (read-only)
      HOST_MODE : Boolean := False;
      --  Read-only. VBUS voltage level (read-only)
      VBUS      : MPFS_Registers.UInt2 := 16#0#;
      --  Read-only. Low-speed device connected (host mode, read-only)
      LS_DEV    : Boolean := False;
      --  Read-only. Full-speed device connected (host mode, read-only)
      FS_DEV    : Boolean := False;
      --  Read-only. B-device role (read-only)
      B_DEVICE  : Boolean := False;
   end record
     with Volatile_Full_Access, Object_Size => 8,
          Bit_Order => System.Low_Order_First;

   for DEV_CTRL_Register use record
      SESSION   at 0 range 0 .. 0;
      HOST_REQ  at 0 range 1 .. 1;
      HOST_MODE at 0 range 2 .. 2;
      VBUS      at 0 range 3 .. 4;
      LS_DEV    at 0 range 5 .. 5;
      FS_DEV    at 0 range 6 .. 6;
      B_DEVICE  at 0 range 7 .. 7;
   end record;

   --  Miscellaneous Control Register (BABBLE_CTL in the Linux MUSB driver)
   type MISC_Register is record
      --  unspecified
      Reserved_0_1    : MPFS_Registers.UInt2 := 16#0#;
      --  Disable the receiver
      RCV_DISABLE     : Boolean := False;
      --  unspecified
      Reserved_3_4    : MPFS_Registers.UInt2 := 16#0#;
      --  Stuck J condition on the bus
      STUCK_J         : Boolean := False;
      --  Software controls the session
      SW_SESSION_CTRL : Boolean := False;
      --  Force the transmitter idle
      FORCE_TXIDLE    : Boolean := False;
   end record
     with Volatile_Full_Access, Object_Size => 8,
          Bit_Order => System.Low_Order_First;

   for MISC_Register use record
      Reserved_0_1    at 0 range 0 .. 1;
      RCV_DISABLE     at 0 range 2 .. 2;
      Reserved_3_4    at 0 range 3 .. 4;
      STUCK_J         at 0 range 5 .. 5;
      SW_SESSION_CTRL at 0 range 6 .. 6;
      FORCE_TXIDLE    at 0 range 7 .. 7;
   end record;

   --  Dynamic TX FIFO Size Register (selects the endpoint by INDEX)
   type TX_FIFO_SIZE_Register is record
      --  TX FIFO size as log2(size/8): 0=8B, 1=16B, 2=32B, 3=64B, 4=128B,
      --  5=256B, 6=512B, 7=1024B, 8=2048B, 9=4096B
      TXFIFOSZ     : MPFS_Registers.UInt4 := 16#0#;
      --  Double-packet buffering enable
      DPB          : Boolean := False;
      --  unspecified
      Reserved_5_7 : MPFS_Registers.UInt3 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 8,
          Bit_Order => System.Low_Order_First;

   for TX_FIFO_SIZE_Register use record
      TXFIFOSZ     at 0 range 0 .. 3;
      DPB          at 0 range 4 .. 4;
      Reserved_5_7 at 0 range 5 .. 7;
   end record;

   --  Dynamic RX FIFO Size Register (selects the endpoint by INDEX)
   type RX_FIFO_SIZE_Register is record
      --  RX FIFO size as log2(size/8): 0=8B, 1=16B, 2=32B, 3=64B, 4=128B,
      --  5=256B, 6=512B, 7=1024B, 8=2048B, 9=4096B (same encoding as
      --  TX_FIFO_SIZE.TXFIFOSZ)
      RXFIFOSZ     : MPFS_Registers.UInt4 := 16#0#;
      --  Double-packet buffering enable
      DPB          : Boolean := False;
      --  unspecified
      Reserved_5_7 : MPFS_Registers.UInt3 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 8,
          Bit_Order => System.Low_Order_First;

   for RX_FIFO_SIZE_Register use record
      RXFIFOSZ     at 0 range 0 .. 3;
      DPB          at 0 range 4 .. 4;
      Reserved_5_7 at 0 range 5 .. 7;
   end record;

   --  Dynamic TX FIFO Start Address Register (8-byte units) (selects the
   --  endpoint by INDEX)
   type TX_FIFO_ADDR_Register is record
      --  Start address of TX FIFO allocation in 8-byte units
      ADDR           : MPFS_Registers.UInt13 := 16#0#;
      --  unspecified
      Reserved_13_15 : MPFS_Registers.UInt3 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 16,
          Bit_Order => System.Low_Order_First;

   for TX_FIFO_ADDR_Register use record
      ADDR           at 0 range 0 .. 12;
      Reserved_13_15 at 0 range 13 .. 15;
   end record;

   --  Dynamic RX FIFO Start Address Register (8-byte units) (selects the
   --  endpoint by INDEX)
   type RX_FIFO_ADDR_Register is record
      --  Start address of RX FIFO allocation in 8-byte units
      ADDR           : MPFS_Registers.UInt13 := 16#0#;
      --  unspecified
      Reserved_13_15 : MPFS_Registers.UInt3 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 16,
          Bit_Order => System.Low_Order_First;

   for RX_FIFO_ADDR_Register use record
      ADDR           at 0 range 0 .. 12;
      Reserved_13_15 at 0 range 13 .. 15;
   end record;

   --  Endpoint Information Register (read-only; the number of endpoints
   --  besides EP0, the MPFS250T reads 0x44, i.e. 4 TX and 4 RX)
   type EP_INFO_Register is record
      --  Read-only. Number of TX endpoints besides EP0 (bits[3:0])
      TX_EP_NUM : MPFS_Registers.UInt4;
      --  Read-only. Number of RX endpoints besides EP0 (bits[7:4])
      RX_EP_NUM : MPFS_Registers.UInt4;
   end record
     with Volatile_Full_Access, Object_Size => 8,
          Bit_Order => System.Low_Order_First;

   for EP_INFO_Register use record
      TX_EP_NUM at 0 range 0 .. 3;
      RX_EP_NUM at 0 range 4 .. 7;
   end record;

   --  FIFO RAM Size Information Register (read-only)
   type RAM_INFO_Register is record
      --  Read-only. RAM width (vendor driver)
      RAM_BITS     : MPFS_Registers.UInt4;
      --  Read-only. Number of DMA channels (vendor driver)
      DMA_CHANNELS : MPFS_Registers.UInt4;
   end record
     with Volatile_Full_Access, Object_Size => 8,
          Bit_Order => System.Low_Order_First;

   for RAM_INFO_Register use record
      RAM_BITS     at 0 range 0 .. 3;
      DMA_CHANNELS at 0 range 4 .. 7;
   end record;

   --  Link Layer Timing Information Register (read-only)
   type LINK_INFO_Register is record
      --  Read-only. Wait time for ID (vendor driver)
      WTID  : MPFS_Registers.UInt4;
      --  Read-only. Wait time for connect (vendor driver)
      WTCON : MPFS_Registers.UInt4;
   end record
     with Volatile_Full_Access, Object_Size => 8,
          Bit_Order => System.Low_Order_First;

   for LINK_INFO_Register use record
      WTID  at 0 range 0 .. 3;
      WTCON at 0 range 4 .. 7;
   end record;

   --  Soft Reset Control Register (self-clearing: the vendor driver writes it
   --  and polls until it reads 0; not used by the Linux MUSB driver)
   type SOFT_RST_Register is record
      --  Assert NRSTn reset (bit 0)
      NRST         : Boolean := False;
      --  Assert NADFn reset (bit 1)
      NADF         : Boolean := False;
      --  unspecified
      Reserved_2_7 : MPFS_Registers.UInt6 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 8,
          Bit_Order => System.Low_Order_First;

   for SOFT_RST_Register use record
      NRST         at 0 range 0 .. 0;
      NADF         at 0 range 1 .. 1;
      Reserved_2_7 at 0 range 2 .. 7;
   end record;

   --  DMA Interrupt Register (the IRQ word of DMA channel 0): bit n is set
   --  when DMA channel n completed or failed; a read clears it. Linux reads it
   --  as 8 bits.
   type DMA_INTR_Register is record
      --  Read-only. *** This field is cleared (set to zero) following a read
      --  operation ***. Interrupt status of DMA channel n in bit n (read
      --  clears)
      DMA_IRQ       : MPFS_Registers.UInt8;
      --  unspecified
      Reserved_8_31 : MPFS_Registers.UInt24;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for DMA_INTR_Register use record
      DMA_IRQ       at 0 range 0 .. 7;
      Reserved_8_31 at 0 range 8 .. 31;
   end record;

   --  Endpoint %s Requested Packet Count Register (DMA mode 1) (not used by
   --  the Linux MUSB driver, unverified; only EP0..EP4 are implemented on the
   --  MPFS250T)
   type RQ_PKT_CNT_Register is record
      --  Number of bulk packets to transfer via DMA mode 1 (bits[15:0])
      PKT_COUNT      : MPFS_Registers.UInt16 := 16#0#;
      --  unspecified
      Reserved_16_31 : MPFS_Registers.UInt16 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for RQ_PKT_CNT_Register use record
      PKT_COUNT      at 0 range 0 .. 15;
      Reserved_16_31 at 0 range 16 .. 31;
   end record;

   --  Endpoint %s Requested Packet Count Register (DMA mode 1) (not used by
   --  the Linux MUSB driver, unverified; only EP0..EP4 are implemented on the
   --  MPFS250T)
   type RQ_PKT_CNT_Registers is array (0 .. 15) of RQ_PKT_CNT_Register;

   -----------------
   -- Peripherals --
   -----------------

   type USB_Disc is
     (TX_CSR,
      CSR0);

   --  MSS USB 2.0 OTG High-Speed Controller
   type USB_Peripheral
     (Discriminent : USB_Disc := TX_CSR)
   is record
      --  Function Address Register (peripheral mode)
      FADDR               : aliased FADDR_Register;
      --  Power Management and High-Speed Control Register
      POWER               : aliased POWER_Register;
      --  TX Endpoint Interrupt Status Register (read-clears; EP0..EP4 are
      --  implemented on the MPFS250T)
      TX_IRQ              : aliased TX_IRQ_Register;
      --  RX Endpoint Interrupt Status Register (read-clears; bit 0 unused;
      --  EP1..EP4 are implemented on the MPFS250T)
      RX_IRQ              : aliased RX_IRQ_Register;
      --  TX Endpoint Interrupt Enable Register (EP0..EP4 are implemented on
      --  the MPFS250T; the board reads 0x1F)
      TX_IRQ_ENABLE       : aliased TX_IRQ_ENABLE_Register;
      --  RX Endpoint Interrupt Enable Register (EP1..EP4 are implemented on
      --  the MPFS250T; the board reads 0x1E)
      RX_IRQ_ENABLE       : aliased RX_IRQ_ENABLE_Register;
      --  USB Common Interrupt Status Register
      USB_IRQ             : aliased USB_IRQ_Register;
      --  USB Common Interrupt Enable Register
      USB_ENABLE          : aliased USB_ENABLE_Register;
      --  USB Frame Number Register (read-only)
      FRAME               : aliased FRAME_Register;
      --  Endpoint Index Register — selects which endpoint CSRs appear at
      --  0x010–0x01F
      INDEX               : aliased INDEX_Register;
      --  USB Test Mode Control Register
      TEST_MODE           : aliased TEST_MODE_Register;
      --  Indexed TX Maximum Packet Size (endpoint selected by INDEX)
      INDEXED_TX_MAX_P    : aliased INDEXED_TX_MAX_P_Register;
      --  Indexed RX Maximum Packet Size (endpoint selected by INDEX)
      INDEXED_RX_MAX_P    : aliased INDEXED_RX_MAX_P_Register;
      --  Indexed RX Control/Status Register — EPN view (N>0). Upper byte
      --  (RxCSRH) carries DMA, ISO and mode bits. Bit semantics differ between
      --  device and host mode.
      INDEXED_RX_CSR      : aliased INDEXED_RX_CSR_Register;
      --  Indexed RX Byte Count Register (COUNT0 for EP0; read-only)
      INDEXED_RX_COUNT    : aliased INDEXED_RX_COUNT_Register;
      --  Indexed TX Type Register — target EP, protocol, speed (host mode;
      --  TYPE0 for EP0)
      INDEXED_TX_TYPE     : aliased INDEXED_TX_TYPE_Register;
      --  Indexed TX Polling Interval / NAK Limit (host; NAK_LIMIT0 for EP0)
      INDEXED_TX_INTERVAL : aliased MPFS_Registers.UInt8;
      --  Indexed RX Type Register — target EP, protocol, speed (host mode)
      INDEXED_RX_TYPE     : aliased INDEXED_RX_TYPE_Register;
      --  Indexed RX Polling Interval / NAK Limit (host mode)
      INDEXED_RX_INTERVAL : aliased MPFS_Registers.UInt8;
      --  Indexed FIFO Size / Config Data Register (read-only). With INDEX of
      --  an endpoint above 0 the fields give its FIFO sizes (Linux
      --  MUSB_FIFOSIZE). With INDEX 0 the same byte is CONFIGDATA of the core
      --  (Linux MUSB_CONFIGDATA = MUSB_FIFOSIZE re-used for EP0, read by
      --  musb_read_configdata after writing INDEX 0), and the fields below do
      --  not apply: bit 7 MPRXE, 6 MPTXE, 5 BIGENDIAN, 4 HBRXE, 3 HBTXE, 2
      --  DYNFIFO, 1 SOFTCONE, 0 UTMIDW (16 bit UTMI data). The board reads
      --  0xDE at INDEX 0.
      INDEXED_FIFO_SIZE   : aliased INDEXED_FIFO_SIZE_Register;
      --  Endpoint %s FIFO Data Port (32-bit access; 8- and 16-bit accesses
      --  also valid; only EP0..EP4 are implemented on the MPFS250T)
      FIFO                : aliased FIFO_Registers;
      --  OTG Device Control Register
      DEV_CTRL            : aliased DEV_CTRL_Register;
      --  Miscellaneous Control Register (BABBLE_CTL in the Linux MUSB driver)
      MISC                : aliased MISC_Register;
      --  Dynamic TX FIFO Size Register (selects the endpoint by INDEX)
      TX_FIFO_SIZE        : aliased TX_FIFO_SIZE_Register;
      --  Dynamic RX FIFO Size Register (selects the endpoint by INDEX)
      RX_FIFO_SIZE        : aliased RX_FIFO_SIZE_Register;
      --  Dynamic TX FIFO Start Address Register (8-byte units) (selects the
      --  endpoint by INDEX)
      TX_FIFO_ADDR        : aliased TX_FIFO_ADDR_Register;
      --  Dynamic RX FIFO Start Address Register (8-byte units) (selects the
      --  endpoint by INDEX)
      RX_FIFO_ADDR        : aliased RX_FIFO_ADDR_Register;
      --  VBUS Control and Status Register (not used by the Linux MUSB driver,
      --  unverified)
      VBUS_CSR            : aliased MPFS_Registers.UInt32;
      --  Hardware Version Register (read-only)
      HW_VERSION          : aliased MPFS_Registers.UInt16;
      --  ULPI VBUS Control Register
      ULPI_BUSCONTROL     : aliased MPFS_Registers.UInt8;
      --  ULPI Carkit Control Register (not used by the Linux MUSB driver,
      --  unverified)
      ULPI_CARKIT_CTRL    : aliased MPFS_Registers.UInt8;
      --  ULPI Interrupt Mask Register
      ULPI_INT_MASK       : aliased MPFS_Registers.UInt8;
      --  ULPI Interrupt Source Register (read-only)
      ULPI_INT_SRC        : aliased MPFS_Registers.UInt8;
      --  ULPI Data Register
      ULPI_REG_DATA       : aliased MPFS_Registers.UInt8;
      --  ULPI Address Register
      ULPI_REG_ADDR       : aliased MPFS_Registers.UInt8;
      --  ULPI Control Register
      ULPI_REG_CONTROL    : aliased MPFS_Registers.UInt8;
      --  ULPI Raw Data Register (read-only)
      ULPI_RAW_DATA       : aliased MPFS_Registers.UInt8;
      --  Endpoint Information Register (read-only; the number of endpoints
      --  besides EP0, the MPFS250T reads 0x44, i.e. 4 TX and 4 RX)
      EP_INFO             : aliased EP_INFO_Register;
      --  FIFO RAM Size Information Register (read-only)
      RAM_INFO            : aliased RAM_INFO_Register;
      --  Link Layer Timing Information Register (read-only)
      LINK_INFO           : aliased LINK_INFO_Register;
      --  VBUS Pulsing Length Register
      VP_LEN              : aliased MPFS_Registers.UInt8;
      --  High-Speed End-of-Frame Timing Register 1
      HS_EOF1             : aliased MPFS_Registers.UInt8;
      --  Full-Speed End-of-Frame Timing Register 1
      FS_EOF1             : aliased MPFS_Registers.UInt8;
      --  Low-Speed End-of-Frame Timing Register 1
      LS_EOF1             : aliased MPFS_Registers.UInt8;
      --  Soft Reset Control Register (self-clearing: the vendor driver writes
      --  it and polls until it reads 0; not used by the Linux MUSB driver)
      SOFT_RST            : aliased SOFT_RST_Register;
      --  DMA Interrupt Register (the IRQ word of DMA channel 0): bit n is set
      --  when DMA channel n completed or failed; a read clears it. Linux reads
      --  it as 8 bits.
      DMA_INTR            : aliased DMA_INTR_Register;
      --  Endpoint %s Requested Packet Count Register (DMA mode 1) (not used by
      --  the Linux MUSB driver, unverified; only EP0..EP4 are implemented on
      --  the MPFS250T)
      RQ_PKT_CNT          : aliased RQ_PKT_CNT_Registers;
      --  RX Double-Packet Buffer Disable Register (bit N disables
      --  double-buffering on RX endpoint N; bit 0 unused) (not used by the
      --  Linux MUSB driver, unverified)
      RX_DPBUF_DIS        : aliased MPFS_Registers.UInt16;
      --  TX Double-Packet Buffer Disable Register (bit N disables
      --  double-buffering on TX endpoint N; bit 0 unused) (not used by the
      --  Linux MUSB driver, unverified)
      TX_DPBUF_DIS        : aliased MPFS_Registers.UInt16;
      --  Chirp Timeout (UCH) Value Register (not used by the Linux MUSB
      --  driver, unverified)
      C_T_UCH             : aliased MPFS_Registers.UInt16;
      --  Host High-Speed Return (HHSRTN) Timing Register (not used by the
      --  Linux MUSB driver, unverified)
      C_T_HHSRTN          : aliased MPFS_Registers.UInt16;
      --  High-Speed Bus Turnaround (HSBT) Timing Register (not used by the
      --  Linux MUSB driver, unverified)
      C_T_HSBT            : aliased MPFS_Registers.UInt16;
      case Discriminent is
         when TX_CSR =>
            --  Indexed TX Control/Status Register — EPN view (N>0). Upper
            --  byte (TxCSRH) carries DMA and mode control. Bit semantics
            --  differ between device and host mode.
            INDEXED_TX_CSR : aliased INDEXED_TX_CSR_Register;
         when CSR0 =>
            --  Indexed EP0 Control/Status Register — EP0 view only
            --  (INDEX=0). Overlaps INDEXED_TX_CSR; bit definitions differ
            --  completely.
            INDEXED_CSR0 : aliased INDEXED_CSR0_Register;
      end case;
   end record
     with Unchecked_Union, Volatile;

   for USB_Peripheral use record
      FADDR               at 16#0# range 0 .. 7;
      POWER               at 16#1# range 0 .. 7;
      TX_IRQ              at 16#2# range 0 .. 15;
      RX_IRQ              at 16#4# range 0 .. 15;
      TX_IRQ_ENABLE       at 16#6# range 0 .. 15;
      RX_IRQ_ENABLE       at 16#8# range 0 .. 15;
      USB_IRQ             at 16#A# range 0 .. 7;
      USB_ENABLE          at 16#B# range 0 .. 7;
      FRAME               at 16#C# range 0 .. 15;
      INDEX               at 16#E# range 0 .. 7;
      TEST_MODE           at 16#F# range 0 .. 7;
      INDEXED_TX_MAX_P    at 16#10# range 0 .. 15;
      INDEXED_RX_MAX_P    at 16#14# range 0 .. 15;
      INDEXED_RX_CSR      at 16#16# range 0 .. 15;
      INDEXED_RX_COUNT    at 16#18# range 0 .. 15;
      INDEXED_TX_TYPE     at 16#1A# range 0 .. 7;
      INDEXED_TX_INTERVAL at 16#1B# range 0 .. 7;
      INDEXED_RX_TYPE     at 16#1C# range 0 .. 7;
      INDEXED_RX_INTERVAL at 16#1D# range 0 .. 7;
      INDEXED_FIFO_SIZE   at 16#1F# range 0 .. 7;
      FIFO                at 16#20# range 0 .. 511;
      DEV_CTRL            at 16#60# range 0 .. 7;
      MISC                at 16#61# range 0 .. 7;
      TX_FIFO_SIZE        at 16#62# range 0 .. 7;
      RX_FIFO_SIZE        at 16#63# range 0 .. 7;
      TX_FIFO_ADDR        at 16#64# range 0 .. 15;
      RX_FIFO_ADDR        at 16#66# range 0 .. 15;
      VBUS_CSR            at 16#68# range 0 .. 31;
      HW_VERSION          at 16#6C# range 0 .. 15;
      ULPI_BUSCONTROL     at 16#70# range 0 .. 7;
      ULPI_CARKIT_CTRL    at 16#71# range 0 .. 7;
      ULPI_INT_MASK       at 16#72# range 0 .. 7;
      ULPI_INT_SRC        at 16#73# range 0 .. 7;
      ULPI_REG_DATA       at 16#74# range 0 .. 7;
      ULPI_REG_ADDR       at 16#75# range 0 .. 7;
      ULPI_REG_CONTROL    at 16#76# range 0 .. 7;
      ULPI_RAW_DATA       at 16#77# range 0 .. 7;
      EP_INFO             at 16#78# range 0 .. 7;
      RAM_INFO            at 16#79# range 0 .. 7;
      LINK_INFO           at 16#7A# range 0 .. 7;
      VP_LEN              at 16#7B# range 0 .. 7;
      HS_EOF1             at 16#7C# range 0 .. 7;
      FS_EOF1             at 16#7D# range 0 .. 7;
      LS_EOF1             at 16#7E# range 0 .. 7;
      SOFT_RST            at 16#7F# range 0 .. 7;
      DMA_INTR            at 16#200# range 0 .. 31;
      RQ_PKT_CNT          at 16#300# range 0 .. 511;
      RX_DPBUF_DIS        at 16#340# range 0 .. 15;
      TX_DPBUF_DIS        at 16#342# range 0 .. 15;
      C_T_UCH             at 16#344# range 0 .. 15;
      C_T_HHSRTN          at 16#346# range 0 .. 15;
      C_T_HSBT            at 16#348# range 0 .. 15;
      INDEXED_TX_CSR      at 16#12# range 0 .. 15;
      INDEXED_CSR0        at 16#12# range 0 .. 15;
   end record;

   --  MSS USB 2.0 OTG High-Speed Controller
   USB_Periph : aliased USB_Peripheral
     with Import, Address => USB_Base,
          Volatile, Async_Readers, Async_Writers, Effective_Writes,
          Effective_Reads => True;

end MPFS_Registers.USB;
