   end record;

   --  Crypto Mesh control and status register
   type MESH_CR_Register is record
      --  Writing a 1 will start the Mesh System
      START          : Boolean := False;
      --  Sets the amount of time that the mesh is held active for, actual hold
      --  time includes up to 256 us of random variation. Minimum Time = 1 +
      --  256 * value us Maximum Time = 1 + 256 * (1+value) us Value must be
      --  greater than 0
      HOLD           : MPFS_Registers.UInt12 := 16#27#;
      --  unspecified
      Reserved_13_15 : MPFS_Registers.UInt3 := 16#0#;
      --  When set will inject an error in the mesh
      INJECT_ERROR   : Boolean := False;
      --  unspecified
      Reserved_17_23 : MPFS_Registers.UInt7 := 16#0#;
      --  Indicates that Mesh detected an error. Cleared by writing a '1'
      MESH_ERROR     : Boolean := False;
      --  Read-only. Indicates that the Mesh is functioning correctly. Will be
      --  set approximately 520 clock cycles after mesh started and stay set as
      --  long as the mesh is not detecting any errors.
      OKAY           : Boolean := False;
      --  unspecified
      Reserved_26_31 : MPFS_Registers.UInt6 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

