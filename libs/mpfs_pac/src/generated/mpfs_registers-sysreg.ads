   -----------------
   -- Peripherals --
   -----------------

   --  SYSREG Controller
   type SYSREG_Peripheral is record
      --  Register for software use
      TEMP0                       : aliased MPFS_Registers.UInt32;
      --  Register for software use
      TEMP1                       : aliased MPFS_Registers.UInt32;
      --  Master clock configuration
      CLOCK_CONFIG_CR             : aliased CLOCK_CONFIG_CR_Register;
      --  RTC clock divider
      RTC_CLOCK_CR                : aliased RTC_CLOCK_CR_Register;
      --  Fabric Reset mask
      FABRIC_RESET_CR             : aliased FABRIC_RESET_CR_Register;
      BOOT_FAIL_CR                : aliased BOOT_FAIL_CR_Register;
      --  Allows the CPU to fully reset the MSS
      MSS_RESET_CR                : aliased MSS_RESET_CR_Register;
      --  Configuration lock
      CONFIG_LOCK_CR              : aliased CONFIG_LOCK_CR_Register;
      --  Indicates which reset caused the last reset. After a reset occurs
      --  register should be read and then zero written to allow the next reset
      --  event to be correctly captured.
      RESET_SR                    : aliased RESET_SR_Register;
      --  Indicates the device status, in particular the state of the FPGA
      --  fabric and the MSS IO banks
      DEVICE_STATUS               : aliased DEVICE_STATUS_Register;
      --  MSS Build Info
      MSS_BUILD                   : aliased MPFS_Registers.UInt32;
      --  U54-1 Fabric interrupt enable
      FAB_INTEN_U54_1             : aliased MPFS_Registers.UInt32;
      --  U54-2 Fabric interrupt enable
      FAB_INTEN_U54_2             : aliased MPFS_Registers.UInt32;
      --  U54-3 Fabric interrupt enable
      FAB_INTEN_U54_3             : aliased MPFS_Registers.UInt32;
      --  U54-4 Fabric interrupt enable
      FAB_INTEN_U54_4             : aliased MPFS_Registers.UInt32;
      --  Allows the Ethernet interrupts to be directly routed to the U54 CPUS.
      FAB_INTEN_MISC              : aliased FAB_INTEN_MISC_Register;
      --  Switches GPIO interrupt from PAD to Fabric GPIO
      GPIO_INTERRUPT_FAB_CR       : aliased MPFS_Registers.UInt32;
      --  AMP Mode peripheral mapping register. When the register bit is '0'
      --  the peripheral is mapped into the 0x2000000 address range using AXI
      --  bus 5 from the Coreplex. When the register bit is '1' the peripheral
      --  is mapped into the 0x28000000 address range using AXI bus 6 from the
      --  Coreplex.
      APBBUS_CR                   : aliased APBBUS_CR_Register;
