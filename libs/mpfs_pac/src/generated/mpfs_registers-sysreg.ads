   --  GPIO Blocks reset control
   type GPIO_CR_Register is record
      --  This signal selects whether the associated byte is reset by soft
      --  reset or the MSS_GPIO_RESET_N signal from the FPGA fabric. The
      --  allowed values are: • 0: Selects MSS_GPIO_RESET_N signal from the
      --  FPGA fabric. • 1: Selects the GPIO to be reset by the GPIO block
      --  soft reset signal . Bit 0 controls GPIO0 [7:0] , and bit 1 GPIO[15:8]
      --  The master MSS reset will also reset the GPIO register if not
      --  configured to use fabric reset.
      GPIO0_SOFT_RESET_SELECT : MPFS_Registers.UInt2 := 16#3#;
      --  unspecified
      Reserved_2_3            : MPFS_Registers.UInt2 := 16#0#;
      --  Sets the reset value of the GPIO0 per byte Bit 0 controls GPIO0 [7:0]
      --  , and bit 1 GPIO[15:8]
      GPIO0_DEFAULT           : MPFS_Registers.UInt2 := 16#0#;
      --  unspecified
      Reserved_6_7            : MPFS_Registers.UInt2 := 16#0#;
      --  This signal selects whether the associated byte is reset by soft
      --  reset or the MSS_GPIO_RESET_N signal from the FPGA fabric. The
      --  allowed values are: • 0: Selects MSS_GPIO_RESET_N signal from the
      --  FPGA fabric. • 1: Selects the GPIO to be reset by the GPIO block
      --  soft reset signal . Bit 0 controls GPIO0 [7:0] ,bit 1 GPIO[15:8] and
      --  bit 2 GPIO[23:16] The master MSS reset will also reset the GPIO
      --  register if not configured to use fabric reset.
      GPIO1_SOFT_RESET_SELECT : MPFS_Registers.UInt3 := 16#7#;
      --  unspecified
      Reserved_11_11          : MPFS_Registers.Bit := 16#0#;
      --  Sets the reset value of the GPIO0 per byte Bit 0 controls GPIO0 [7:0]
      --  ,bit 1 GPIO[15:8] and bit 2 GPIO[23:16]
      GPIO1_DEFAULT           : MPFS_Registers.UInt3 := 16#0#;
      --  unspecified
      Reserved_15_15          : MPFS_Registers.Bit := 16#0#;
      --  This signal selects whether the associated byte is reset by soft
      --  reset or the MSS_GPIO_RESET_N signal from the FPGA fabric. The
      --  allowed values are: • 0: Selects MSS_GPIO_RESET_N signal from the
      --  FPGA fabric. • 1: Selects the GPIO to be reset by the GPIO block
      --  soft reset signal . Bit 0 controls GPIO0 [7:0] ,bit 1 GPIO[15:8] and
      --  bit 1 GPIO[23:16], and bit 3 GPIO[31:24] The master MSS reset will
