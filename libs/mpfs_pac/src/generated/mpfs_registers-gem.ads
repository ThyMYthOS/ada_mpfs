   for emac_tsu_peer_rx_msb_sec_Register use record
      TIMER_SECONDS  at 0 range 0 .. 15;
      RESERVED_31_16 at 0 range 16 .. 31;
   end record;

   --  The fill levels for the TX and RX packet buffer SRAMs can be read using
   --  this register, including the fill level for each queue in the TX
   --  direction. The fill level is reported as the number of word locations
   --  used. The number of bytes will depend on the SRAM data width.
   type emac_dpram_fill_dbg_Register is record
      --  TX/RX Fill Level select - report the fill level for the TX or RX
      --  packet buffer. Set 1 for transmit and 0 for receive.
      DMA_TX_RX_FILL_LEVEL_SELECT : Boolean := False;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_3_1                : MPFS_Registers.UInt3 := 16#0#;
      --  TX queue fill level select - select what TX queue to report fill
      --  levels for.
      DMA_TX_Q_FILL_LEVEL_SELECT  : MPFS_Registers.UInt4 := 16#0#;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_15_8               : MPFS_Registers.UInt8 := 16#0#;
      --  Read-only. Fill Level - TX or RX packet buffer fill level, selected
      --  by the tx_q_fill_level_select and tx_rx_fill_level_select registers.
      --  Read this register to determine the fill level.
      DMA_TX_RX_FILL_LEVEL        : MPFS_Registers.UInt16 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for emac_dpram_fill_dbg_Register use record
      DMA_TX_RX_FILL_LEVEL_SELECT at 0 range 0 .. 0;
      RESERVED_3_1                at 0 range 1 .. 3;
      DMA_TX_Q_FILL_LEVEL_SELECT  at 0 range 4 .. 7;
      RESERVED_15_8               at 0 range 8 .. 15;
      DMA_TX_RX_FILL_LEVEL        at 0 range 16 .. 31;
   end record;

   --  This register indicates a Cadence module identification number and
   --  module revision. The value of this register is read only as defined by
   --  `gem_revision_reg_value
   type emac_revision_reg_Register is record
      --  Read-only. Module revision - fixed value specific to the revision of
      --  the design which is incremented for each non-fix release of the IP.
      MODULE_REVISION              : MPFS_Registers.UInt16;
      --  Read-only. Module identification number - for the GEM, this value is
      --  fixed.
      MODULE_IDENTIFICATION_NUMBER : MPFS_Registers.UInt12;
      --  Read-only. Fix number - incremented for fix releases.
      FIX_NUMBER                   : MPFS_Registers.UInt4;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for emac_revision_reg_Register use record
      MODULE_REVISION              at 0 range 0 .. 15;
      MODULE_IDENTIFICATION_NUMBER at 0 range 16 .. 27;
      FIX_NUMBER                   at 0 range 28 .. 31;
   end record;

   --  Octets Transmitted 47:32
   type emac_octets_txed_top_Register is record
      --  Transmitted octets in frame without errors [47:32]. The number of
      --  octets transmitted in valid frames of any type. This counter is
      --  48-bits, and is read through two registers. This count does not
      --  include octets from automatically generated pause frames.
      COUNT          : MPFS_Registers.UInt16 := 16#0#;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_31_16 : MPFS_Registers.UInt16 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for emac_octets_txed_top_Register use record
      COUNT          at 0 range 0 .. 15;
      RESERVED_31_16 at 0 range 16 .. 31;
   end record;

   --  Pause Frames Transmitted
   type emac_pause_frames_txed_Register is record
      --  Transmitted pause frames - a 16 bit register counting the number of
      --  pause frames transmitted. Only pause frames triggered by the register
      --  interface or through the external pause pins or automatically when
      --  rx_water_mark is reached are counted as pause frames. Pause frames
      --  received through the external FIFO interface are counted in the
      --  frames transmitted counter.
      COUNT          : MPFS_Registers.UInt16 := 16#0#;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_31_16 : MPFS_Registers.UInt16 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for emac_pause_frames_txed_Register use record
      COUNT          at 0 range 0 .. 15;
      RESERVED_31_16 at 0 range 16 .. 31;
   end record;

   --  Transmit Under Runs
   type emac_tx_underruns_Register is record
      --  Transmit under runs - a 10 bit register counting the number of frames
      --  not transmitted due to a transmit under run. If this register is
      --  incremented then no other statistics register is incremented.
      COUNT          : MPFS_Registers.UInt10 := 16#0#;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_31_10 : MPFS_Registers.UInt22 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for emac_tx_underruns_Register use record
      COUNT          at 0 range 0 .. 9;
      RESERVED_31_10 at 0 range 10 .. 31;
   end record;

   --  Single Collision Frames
   type emac_single_collisions_Register is record
      --  Single collision frames - an 18 bit register counting the number of
      --  frames experiencing a single collision before being successfully
      --  transmitted, i.e. no under run.
      COUNT          : MPFS_Registers.UInt18 := 16#0#;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_31_18 : MPFS_Registers.UInt14 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for emac_single_collisions_Register use record
      COUNT          at 0 range 0 .. 17;
      RESERVED_31_18 at 0 range 18 .. 31;
   end record;

   --  Multiple Collision Frames
   type emac_multiple_collisions_Register is record
      --  Multiple collision frames - an 18 bit register counting the number of
      --  frames experiencing between two and fifteen collisions prior to being
      --  successfully transmitted, i.e. no under run and not too many retries.
      COUNT          : MPFS_Registers.UInt18 := 16#0#;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_31_18 : MPFS_Registers.UInt14 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for emac_multiple_collisions_Register use record
      COUNT          at 0 range 0 .. 17;
      RESERVED_31_18 at 0 range 18 .. 31;
   end record;

   --  Excessive Collisions
   type emac_excessive_collisions_Register is record
      --  Excessive collisions - a 10 bit register counting the number of
      --  frames that failed to be transmitted because they experienced 16
      --  collisions.
      COUNT          : MPFS_Registers.UInt10 := 16#0#;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_31_10 : MPFS_Registers.UInt22 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for emac_excessive_collisions_Register use record
      COUNT          at 0 range 0 .. 9;
      RESERVED_31_10 at 0 range 10 .. 31;
   end record;

   --  Late Collisions
   type emac_late_collisions_Register is record
      --  Late collisions - a 10 bit register counting the number of late
      --  collision occurring after the slot time (512 bits) has expired. In
      --  10/100 mode, late collisions are counted twice i.e. both as a
      --  collision and a late collision. In gigabit mode, a late collision
      --  causes the transmission to be aborted, thus the single and multi
      --  collision registers are not updated.
      COUNT          : MPFS_Registers.UInt10 := 16#0#;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_31_10 : MPFS_Registers.UInt22 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for emac_late_collisions_Register use record
      COUNT          at 0 range 0 .. 9;
      RESERVED_31_10 at 0 range 10 .. 31;
   end record;

   --  Deferred Transmission Frames
   type emac_deferred_frames_Register is record
      --  Deferred transmission frames - an 18 bit register counting the number
      --  of frames experiencing deferral due to carrier sense being active on
      --  their first attempt at transmission. Frames involved in any collision
      --  are not counted nor are frames that experienced a transmit under run.
      COUNT          : MPFS_Registers.UInt18 := 16#0#;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_31_18 : MPFS_Registers.UInt14 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for emac_deferred_frames_Register use record
      COUNT          at 0 range 0 .. 17;
      RESERVED_31_18 at 0 range 18 .. 31;
   end record;

   --  Carrier Sense Errors
   type emac_crs_errors_Register is record
      --  Carrier sense errors - a 10 bit register counting the number of
      --  frames transmitted where carrier sense was not seen during
      --  transmission or where carrier sense was deasserted after being
      --  asserted in a transmit frame without collision (no under run). Only
      --  incremented in half-duplex mode. The only effect of a carrier sense
      --  error is to increment this register. The behaviour of the other
      --  statistics registers is unaffected by the detection of a carrier
      --  sense error.
      COUNT          : MPFS_Registers.UInt10 := 16#0#;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_31_10 : MPFS_Registers.UInt22 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for emac_crs_errors_Register use record
      COUNT          at 0 range 0 .. 9;
      RESERVED_31_10 at 0 range 10 .. 31;
   end record;

   --  Octets Received 47:32
   type emac_octets_rxed_top_Register is record
      --  Received octets in frame without errors [47:32]. The number of octets
      --  received in valid frames of any type. This counter is 48-bits and is
      --  read through two registers. This count does not include octets from
      --  pause frames, and is only incremented if the frame is successfully
      --  filtered.
      COUNT          : MPFS_Registers.UInt16 := 16#0#;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_31_16 : MPFS_Registers.UInt16 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for emac_octets_rxed_top_Register use record
      COUNT          at 0 range 0 .. 15;
      RESERVED_31_16 at 0 range 16 .. 31;
   end record;

   --  Pause Frames Received
   type emac_pause_frames_rxed_Register is record
      --  Received pause frames - a 16 bit register counting the number of
      --  pause frames received without error.
      COUNT          : MPFS_Registers.UInt16 := 16#0#;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_31_16 : MPFS_Registers.UInt16 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for emac_pause_frames_rxed_Register use record
      COUNT          at 0 range 0 .. 15;
      RESERVED_31_16 at 0 range 16 .. 31;
   end record;

   --  Undersized Frames Received
   type emac_undersize_frames_Register is record
      --  Undersize frames received - a 10 bit register counting the number of
      --  frames received less than 64 bytes in length (10/100 mode or gigabit
      --  mode, full duplex) that do not have either a CRC error or an
