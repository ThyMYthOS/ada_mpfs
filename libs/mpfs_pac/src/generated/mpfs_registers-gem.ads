   --  This value of this register contains the next page received information
   --  from the link partner.
   type pcs_an_lp_np_Register is record
      --  Read-only. Message - contains data as defined by the message page
      --  indicator bit.
      MESSAGE                : MPFS_Registers.UInt11;
      --  Read-only. Toggle - this bit toggles with every received page.
      TOGGLE                 : Boolean;
      --  Read-only. Acknowledge 2 - set active high by the link partner to
      --  indicate when it has the ability to comply with the last message
      --  received.
      ACKNOWLEDGE_2          : Boolean;
      --  Read-only. Message page indicator - this bit identifies the message.
      --  , :0: Unformatted page. , :1: Message page.
      MESSAGE_PAGE_INDICATOR : Boolean;
      --  Read-only. Acknowledge - this bit indicates whether as part of the
      --  next page function, the link partner has successfully received the
      --  last message transmitted.
      ACKNOWLEDGE            : Boolean;
      --  Read-only. Next page to receive - this bit indicates whether this is
      --  the last page to be received in the sequence by the GEM PCS:, :0:
      --  Last page. , :1: Additional page(s) to follow.
      NEXT_PAGE_TO_RECEIVE   : Boolean;
      --  Read-only. Reserved. Set to zero.
      RESERVED_31_16         : MPFS_Registers.UInt16;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

