      --  frame and frames subsequently matched will dropped until an interval
      --  time passes where max_rate_val is not exceeded. If this value is set
      --  to zero, then no rate limiting will be performed. The interval time
      --  is specified in units of 64 rx_clk periods.
      INTERVAL_TIME : MPFS_Registers.UInt16 := 16#0#;
