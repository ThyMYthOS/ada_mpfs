      --  the byte stored in bits [31:24] is compared against the byte in the
      --  received frame from the selected offset+3., :, :If bit 9 of the
      --  associated compare_word1 register is clear, then the byte stored in
      --  bits [23:16] is compared against the byte in the received frame from
      --  the selected offset+0 and the byte stored in bits [31:24] is compared
      --  against the byte in the received frame from the selected offset+1., :
      COMPARE_VALUE : MPFS_Registers.UInt16 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

