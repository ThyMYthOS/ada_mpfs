      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_1   : Boolean := False;
      --  Transmit buffer queue base address - written with the address of the
      --  start of the transmit queue.
      DMA_TX_Q_PTR : MPFS_Registers.UInt30 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

