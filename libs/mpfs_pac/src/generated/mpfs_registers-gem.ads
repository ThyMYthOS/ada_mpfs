      RX_LONG_ERR_MASK         : Boolean := True;
      --  Mask bit for RX packet with symbol errors.
      RX_SYMBOL_ERR_MASK       : Boolean := True;
      --  Mask bit for RX packet with length field error.
      RX_LENGTH_ERR_MASK       : Boolean := True;
      --  Mask bit for RX packet IP checksum error.
      RX_IP_CK_ERR_MASK        : Boolean := True;
      --  Mask bit for RX packet TCP checksum error.
      RX_TCP_CK_ERR_MASK       : Boolean := True;
      --  Mask bit for RX packet UDP checksum error.
      RX_UDP_CK_ERR_MASK       : Boolean := True;
      --  Mask bit for too many retry attempts after collision error (half
      --  duplex only).
      TX_TOO_MANY_RETRIES_MASK : Boolean := True;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_15_9            : MPFS_Registers.UInt7 := 16#0#;
      --  Mask bit for Transmit DMA underrun occurred.
      TX_UNDERRUN_MASK         : Boolean := True;
      --  Mask bit for Transmit buffers exhausted before end of packet.
      TX_BUFF_EX_MID_MASK      : Boolean := True;
      --  Mask bit for DMA hresp error (AHB only).
      TX_HRESP_ERR_MASK        : Boolean := True;
      --  Mask bit for DMA hresp error (AHB only).
      RX_HRESP_ERR_MASK        : Boolean := True;
      --  Mask bit for DMA buffer overflow and packet was dropped.
      RX_OVERFLOW_MASK         : Boolean := True;
      --  Mask bit for RX packet was flushed from the DMA.
      RX_DMA_PKT_FLUSH_MASK    : Boolean := True;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_31_22           : MPFS_Registers.UInt10 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for asf_protocol_fault_mask_Register use record
      RX_CRC_ERR_MASK          at 0 range 0 .. 0;
      RX_SHORT_ERR_MASK        at 0 range 1 .. 1;
      RX_LONG_ERR_MASK         at 0 range 2 .. 2;
      RX_SYMBOL_ERR_MASK       at 0 range 3 .. 3;
      RX_LENGTH_ERR_MASK       at 0 range 4 .. 4;
      RX_IP_CK_ERR_MASK        at 0 range 5 .. 5;
      RX_TCP_CK_ERR_MASK       at 0 range 6 .. 6;
      RX_UDP_CK_ERR_MASK       at 0 range 7 .. 7;
      TX_TOO_MANY_RETRIES_MASK at 0 range 8 .. 8;
      RESERVED_15_9            at 0 range 9 .. 15;
      TX_UNDERRUN_MASK         at 0 range 16 .. 16;
      TX_BUFF_EX_MID_MASK      at 0 range 17 .. 17;
      TX_HRESP_ERR_MASK        at 0 range 18 .. 18;
      RX_HRESP_ERR_MASK        at 0 range 19 .. 19;
      RX_OVERFLOW_MASK         at 0 range 20 .. 20;
      RX_DMA_PKT_FLUSH_MASK    at 0 range 21 .. 21;
      RESERVED_31_22           at 0 range 22 .. 31;
   end record;

   --  Status register for protocol faults. If a fault occurs the relevant
