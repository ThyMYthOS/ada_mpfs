          Bit_Order => System.Low_Order_First;

   for emac_tsu_ptp_rx_msb_sec_Register use record
      TIMER_SECONDS  at 0 range 0 .. 15;
      RESERVED_31_16 at 0 range 16 .. 31;
   end record;

   --  PTP Peer Event Frame Transmitted Seconds Register 47:32
   type emac_tsu_peer_tx_msb_sec_Register is record
      --  Read-only. PTP Peer Event Frame TX Seconds. The register is updated
