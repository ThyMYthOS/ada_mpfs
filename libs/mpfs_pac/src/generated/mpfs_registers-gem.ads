      --  non-zero then a zero length pause frame is transmitted when the
      --  receive SRAM fill level falls below this value.
      RX_LOW_WATERMARK  : MPFS_Registers.UInt16 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

