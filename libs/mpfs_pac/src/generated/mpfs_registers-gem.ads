   end record;

   --  PTP Peer Event Frame Received Seconds Register 47:32
   type emac_tsu_peer_rx_msb_sec_Register is record
      --  Read-only. PTP Peer Event Frame RX Seconds. The register is updated
      --  with the value that the 1588 timer seconds register held when the SFD
      --  of a PTP receive peer event crosses the MII interface. The actual
