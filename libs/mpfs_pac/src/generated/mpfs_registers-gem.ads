      LENGTH_FIELD_ERROR_FRAME_DISCARD : Boolean := False;
      --  FCS remove - setting this bit will cause received frames to be
      --  written to memory without their frame check sequence (last 4 bytes).
      --  The frame length indicated will be reduced by four bytes in this
      --  mode.
      FCS_REMOVE                       : Boolean := False;
      --  MDC clock division - set according to pclk speed. These three bits
