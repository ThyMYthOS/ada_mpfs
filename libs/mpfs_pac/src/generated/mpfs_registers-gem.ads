      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_31_16 : MPFS_Registers.UInt16 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for auto_flushed_pkts_Register use record
      COUNT          at 0 range 0 .. 15;
      RESERVED_31_16 at 0 range 16 .. 31;
   end record;

   --  1588 Timer Increment Register sub nsec. From release 1p08f1 onwards this
   --  register must be written before the tsu_timer_incr register and the
   --  value written will not take effect until the tsu_timer_incr register is
   --  written to.
   type tsu_timer_incr_sub_nsec_Register is record
      --  These are the most significant bits [23:8] of the sub-ns value by
      --  which the 1588 timer will be incremented each clock cycle. 24 bits of
      --  sub nanosecond precision gives resolution of approximately 5.86E-17
      --  seconds (16 bits gives 15.2 femtoseconds).
      SUB_NS_INCR     : MPFS_Registers.UInt16 := 16#0#;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_23_16  : MPFS_Registers.UInt8 := 16#0#;
      --  These are the least significant bits [7:0] of the sub-ns value by
      --  which the 1588 timer will be incremented each clock cycle.
      SUB_NS_INCR_LSB : MPFS_Registers.UInt8 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for tsu_timer_incr_sub_nsec_Register use record
      SUB_NS_INCR     at 0 range 0 .. 15;
      RESERVED_23_16  at 0 range 16 .. 23;
      SUB_NS_INCR_LSB at 0 range 24 .. 31;
   end record;

   --  1588 Timer Seconds Register 47:32
   type tsu_timer_msb_sec_Register is record
      --  TSU timer value (s). Most significant 16 bits of seconds timer count.
      --  The register is writeable. The 48-bit counter increments by one when
      --  the 1588 nanoseconds counter counts to one second. It may also be
      --  incremented or decremented when the timer adjust register is written
      --  (if decremented from zero the 48-bit combined count would roll back
      --  to 0xFFFFFFFFFFFF). Note: The value of this register is used only
      --  when the lower 32 bit register is written to. This is to ensure a
      --  single update of the 48 bit seconds value
      TIMER          : MPFS_Registers.UInt16 := 16#0#;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_31_16 : MPFS_Registers.UInt16 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for tsu_timer_msb_sec_Register use record
      TIMER          at 0 range 0 .. 15;
      RESERVED_31_16 at 0 range 16 .. 31;
   end record;

   --  1588 Timer Sync Strobe Seconds Register 47:32
   type tsu_strobe_msb_sec_Register is record
      --  Read-only. 1588 Timer Sync Strobe Seconds. The most significant
      --  16-bit value of the Timer Seconds register captured when gem_tsu_ms
      --  and gem_tsu_inc_ctrl are zero.
      STROBE         : MPFS_Registers.UInt16;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_31_16 : MPFS_Registers.UInt16;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for tsu_strobe_msb_sec_Register use record
      STROBE         at 0 range 0 .. 15;
      RESERVED_31_16 at 0 range 16 .. 31;
   end record;

   --  1588 Timer Sync Strobe Nanoseconds Register
   type tsu_strobe_nsec_Register is record
      --  Read-only. 1588 Timer Sync Strobe Nanoseconds. The value of the Timer
      --  Nanoseconds register captured when gem_tsu_ms and gem_tsu_inc_ctrl
      --  are zero.
      STROBE         : MPFS_Registers.UInt30;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_31_30 : MPFS_Registers.UInt2;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for tsu_strobe_nsec_Register use record
      STROBE         at 0 range 0 .. 29;
      RESERVED_31_30 at 0 range 30 .. 31;
   end record;

   --  1588 Timer Nanoseconds Register
   type tsu_timer_nsec_Register is record
      --  Timer count in nanoseconds. This register is writeable. It can also
      --  be adjusted by writes to the 1588 timer adjust register. It
      --  increments by the value of the 1588 timer increment register each
      --  clock cycle (if this register is close to zero and a write to the
      --  timer adjust register causes a decrement the seconds register will be
      --  decremented if necessary and the nanoseconds register will roll back
      --  to 9999999xx (decimal)).
      TIMER          : MPFS_Registers.UInt30 := 16#0#;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_31_30 : MPFS_Registers.UInt2 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for tsu_timer_nsec_Register use record
      TIMER          at 0 range 0 .. 29;
      RESERVED_31_30 at 0 range 30 .. 31;
   end record;

   --  This register is used to adjust the value of the timer in the TSU. It
   --  allows an integral number of nanoseconds to be added or subtracted from
   --  the timer in a one-off operation. This register returns all zeroes when
   --  read.
   type tsu_timer_adjust_Register is record
      --  Timer increment value. The number of nanoseconds to increment or
      --  decrement the 1588 timer nanoseconds register. If necessary the 1588
      --  seconds register will be incremented or decremented.
      INCREMENT_VALUE : MPFS_Registers.UInt30 := 16#0#;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_30     : Boolean := False;
      --  Write as one to subtract from the 1588 timer. Write as zero to add to
      --  it.
      ADD_SUBTRACT    : Boolean := False;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for tsu_timer_adjust_Register use record
      INCREMENT_VALUE at 0 range 0 .. 29;
      RESERVED_30     at 0 range 30 .. 30;
      ADD_SUBTRACT    at 0 range 31 .. 31;
   end record;

   --  1588 Timer Increment Register. From release 1p08f1 onwards this register
   --  must be written after the tsu_timer_incr_sub_ns register and the write
   --  operation will cause the value written to the tsu_timer_incr_sub_ns
   --  register to take effect.
   type tsu_timer_incr_Register is record
      --  A count of nanoseconds by which the 1588 timer nanoseconds register
      --  will be incremented each clock cycle. These are the most significant
      --  8 bits of the 32 bit timer_increment counter. The
      --  tsu_timer_incr_sub_nsec register holds the least significant 24 bits
      --  of the increment.
      NS_INCREMENT   : MPFS_Registers.UInt8 := 16#0#;
      --  Alternative nanoseconds count. Alternative count of nanoseconds by
      --  which the 1588 timer nanoseconds register will be incremented each
      --  clock cycle.
      ALT_NS_INCR    : MPFS_Registers.UInt8 := 16#0#;
      --  Number of incs before alt inc. The number of increments after which
      --  the alternative increment is used.
      NUM_INCS       : MPFS_Registers.UInt8 := 16#0#;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_31_24 : MPFS_Registers.UInt8 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for tsu_timer_incr_Register use record
      NS_INCREMENT   at 0 range 0 .. 7;
      ALT_NS_INCR    at 0 range 8 .. 15;
      NUM_INCS       at 0 range 16 .. 23;
      RESERVED_31_24 at 0 range 24 .. 31;
   end record;

   --  PTP Event Frame Transmitted Nanoseconds Register
   type tsu_ptp_tx_nsec_Register is record
      --  Read-only. PTP Event Frame Transmitted Nanoseconds. The register is
      --  updated with the value that the 1588 timer nanoseconds register held
      --  when the SFD of a PTP transmit primary event crosses the MII
      --  interface. The actual update occurs when the GEM recognizes the frame
      --  as a PTP sync or delay_req frame. An interrupt is issued when the
      --  register is updated.
      TIMER          : MPFS_Registers.UInt30;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_31_30 : MPFS_Registers.UInt2;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for tsu_ptp_tx_nsec_Register use record
      TIMER          at 0 range 0 .. 29;
      RESERVED_31_30 at 0 range 30 .. 31;
   end record;

   --  PTP Event Frame Received Nanoseconds Register
   type tsu_ptp_rx_nsec_Register is record
      --  Read-only. PTP Event Frame Received Nanoseconds. The register is
      --  updated with the value that the 1588 timer nanoseconds register held
      --  when the SFD of a PTP receive primary event crosses the MII
      --  interface. The actual update occurs when the GEM recognizes the frame
      --  as a PTP sync or delay_req frame. An interrupt is issued when the
      --  register is updated.
      TIMER          : MPFS_Registers.UInt30;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_31_30 : MPFS_Registers.UInt2;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for tsu_ptp_rx_nsec_Register use record
      TIMER          at 0 range 0 .. 29;
      RESERVED_31_30 at 0 range 30 .. 31;
   end record;

   --  PTP Peer Event Frame Transmitted Nanoseconds Register
   type tsu_peer_tx_nsec_Register is record
      --  Read-only. PTP Peer Event Frame Transmitted Nanoseconds. The register
      --  is updated with the value that the 1588 timer nanoseconds register
      --  held when the SFD of a PTP transmit peer event crosses the MII
