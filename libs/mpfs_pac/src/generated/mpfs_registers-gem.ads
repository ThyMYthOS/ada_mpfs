      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_4           : Boolean := False;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_5           : Boolean := False;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_6           : Boolean := False;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_7           : Boolean := False;
      --  Read-only. Reserved, read as 0, ignored on write.
