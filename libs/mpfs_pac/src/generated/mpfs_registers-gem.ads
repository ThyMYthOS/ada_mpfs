   type asf_protocol_fault_status_Register is record
      --  Status bit for RX packet with bad CRC.
      RX_CRC_ERR_STATUS          : Boolean := False;
      --  Status bit for RX packet too short.
      RX_SHORT_ERR_STATUS        : Boolean := False;
      --  Status bit for RX packet too long.
      RX_LONG_ERR_STATUS         : Boolean := False;
      --  Status bit for RX packet with symbol errors.
      RX_SYMBOL_ERR_STATUS       : Boolean := False;
      --  Status bit for RX packet with length field error.
      RX_LENGTH_ERR_STATUS       : Boolean := False;
      --  Status bit for RX packet IP checksum error.
      RX_IP_CK_ERR_STATUS        : Boolean := False;
      --  Status bit for RX packet TCP checksum error.
      RX_TCP_CK_ERR_STATUS       : Boolean := False;
      --  Status bit for RX packet UDP checksum error.
      RX_UDP_CK_ERR_STATUS       : Boolean := False;
      --  Status bit for too many retry attempts after collision error (half
      --  duplex only).
      TX_TOO_MANY_RETRIES_STATUS : Boolean := False;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_15_9              : MPFS_Registers.UInt7 := 16#0#;
      --  Status bit for Transmit DMA underrun occurred.
      TX_UNDERRUN_STATUS         : Boolean := False;
      --  Status bit for Transmit buffers exhausted before end of packet.
      TX_BUFF_EX_MID_STATUS      : Boolean := False;
      --  Status bit for DMA hresp error (AHB only).
      TX_HRESP_ERR_STATUS        : Boolean := False;
      --  Status bit for DMA hresp error (AHB only).
