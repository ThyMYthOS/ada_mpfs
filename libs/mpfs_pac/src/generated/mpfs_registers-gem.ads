      --  UDP Port Match
      UDP_PORT_MATCH        : MPFS_Registers.UInt16 := 16#0#;
      --  DS/TC Enable
      DSTC_ENABLE           : Boolean := False;
      --  UDP port match enable
      UDP_PORT_MATCH_ENABLE : Boolean := False;
      --  When set, if the frame matches it will be completely dropped. In this
      --  case the queue number is don't care.
