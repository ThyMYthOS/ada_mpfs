   --  Used to moderate the number of transmit and receive complete interrupts
   --  issued. With interrupt moderation enabled receive and transmit
   --  interrupts are not generated immediately a frame is transmitted or
   --  received. Instead when a receive or transmit event occurs a timer is
   --  started and the interrupt is asserted after it times out. This limits
   --  the frequency with which the CPU receives interrupts. When interrupt
   --  moderation is enabled interrupt status bit one is always used for
   --  receive and bit 7 is always used for transmit even when priority queuing
   --  is enabled. With interrupt moderation 800ns periods are counted. GEM
   --  determines what constitutes an 800ns period by looking at the tbi (bit
   --  11), gigabit bit (10) and speed (bit 0) bits in the network
   --  configuration register and counting tx_clk cycles. Bit 0 needs to be set
   --  to 1 for 100M operation., :From release 1p11 onwards a frame threshold
   --  value may also be used to moderate interrupts. If both time based and
   --  frame threshold moderation is enabled the interrupt will be asserted as
   --  soon as the first moderation method expires.
   type emac_int_moderation_Register is record
      --  Count of 800ns periods before bit 1 is set in the interrupt status
      --  register after a frame is received. A non-zero value indicates
      --  receive interrupt moderation will be performed.
      RX_INT_MODERATION : MPFS_Registers.UInt8 := 16#0#;
      --  Count of received frames before bit 1 is set in the interrupt status
      --  register. A non-zero value indicates receive interrupt moderation
      --  will be performed.
      RX_INT_MOD_THRESH : MPFS_Registers.UInt8 := 16#0#;
      --  Count of 800ns periods before bit 7 is set in the interrupt status
      --  register after a frame is transmitted. A non-zero value indicates
      --  transmit interrupt moderation will be performed.
      TX_INT_MODERATION : MPFS_Registers.UInt8 := 16#0#;
      --  Count of transmitted frames before bit 7 is set in the interrupt
      --  status register. A non-zero value indicates transmit interrupt
      --  moderation will be performed.
      TX_INT_MOD_THRESH : MPFS_Registers.UInt8 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for emac_int_moderation_Register use record
      RX_INT_MODERATION at 0 range 0 .. 7;
      RX_INT_MOD_THRESH at 0 range 8 .. 15;
      TX_INT_MODERATION at 0 range 16 .. 23;
      TX_INT_MOD_THRESH at 0 range 24 .. 31;
   end record;

   --  Used to pause transmission after deassertion of tx_lpi_en. Each unit in
   --  this register corresponds to 25.6ns in 2.5G mode, 64ns in gigabit mode,
   --  320ns in 100M mode and 3200ns at 10M. After tx_lpi_en is deasserted
   --  transmission will pause for the set time.
   type emac_sys_wake_time_Register is record
      --  Count of 25.6ns, 64ns, 320ns or 3200ns intervals before transmission
      --  starts after deassertion of tx_lpi_en (each interval is equivalent to
      --  eight tx_clk periods and so varies with data rate).
      SYS_WAKE_TIME  : MPFS_Registers.UInt16 := 16#0#;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_31_16 : MPFS_Registers.UInt16 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for emac_sys_wake_time_Register use record
      SYS_WAKE_TIME  at 0 range 0 .. 15;
      RESERVED_31_16 at 0 range 16 .. 31;
   end record;

   --  The lockup detection and recovery configuration register.
   type emac_lockup_config_Register is record
      --  For release 1p10 this field defined the time (measured in units of
      --  1024 tx_clk periods) after which the lockup detection monitors would
      --  trigger, except for the receive MAC lock up detector which had its
      --  lockup time register. From release 1p11 onwards this field defines a
      --  prescaler value which is the number of tx_clk periods used to scale
      --  the timeout registers.
      PRESCALER_VALUE      : MPFS_Registers.UInt16 := 16#FFFF#;
      --  Prior to release 1p11 this field was reserved. From release 1p11
      --  onwards this field defines the timeout value for transmit and receive
      --  DMA lockup detection defined as a multiple of the prescaler value
      --  stored in bits 15:0 of this register.
      DMA_LOCKUP_TIME      : MPFS_Registers.UInt11 := 16#7FF#;
      --  Lockup recovery. If this bit is set then the module will go into a
      --  soft reset state if a lockup is detected on the transmit or receive
      --  data paths.
      LOCKUP_RECOVERY_EN   : Boolean := False;
      --  Enable the RX MAC lockup detector. Enable the monitor that detects
      --  lockups in the MAC receive path.
      RX_MAC_LOCKUP_MON_EN : Boolean := False;
      --  Enable the RX DMA lockup detector. Enable the monitor that detects
      --  lockups in the receive DMA.
      RX_DMA_LOCKUP_MON_EN : Boolean := False;
      --  Enable the TX MAC lockup detector. Enable the monitor that detects
      --  lockups in the MAC transmit path.
      TX_MAC_LOCKUP_MON_EN : Boolean := False;
      --  Enable the TX DMA lockup detector. Enable the monitor that detects
      --  lockups in the transmit DMA.
      TX_DMA_LOCKUP_MON_EN : Boolean := False;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for emac_lockup_config_Register use record
      PRESCALER_VALUE      at 0 range 0 .. 15;
      DMA_LOCKUP_TIME      at 0 range 16 .. 26;
      LOCKUP_RECOVERY_EN   at 0 range 27 .. 27;
      RX_MAC_LOCKUP_MON_EN at 0 range 28 .. 28;
      RX_DMA_LOCKUP_MON_EN at 0 range 29 .. 29;
      TX_MAC_LOCKUP_MON_EN at 0 range 30 .. 30;
      TX_DMA_LOCKUP_MON_EN at 0 range 31 .. 31;
   end record;

   --  MAC lockup detection time register. For receive this register specifies
   --  the maximum time between received frames. If no valid EOP is seen at the
   --  receive FIFO interface within the timer period then a lockup is
   --  considered to have occurred in the receive MAC. For transmit the MAC
   --  lockup time is simply the time it takes for data to be seen on the MII
   --  output pins after entering on the MAC FIFO interface.
