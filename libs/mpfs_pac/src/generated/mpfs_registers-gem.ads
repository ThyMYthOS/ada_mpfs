   end record;

   --  MMSL Control Register. This register contains the control bits for the
   --  802.3br MAC Merge Sublayer (MMSL)
   type mmsl_control_Register is record
      --  This bit field determines the minimum number of bytes which the pMAC
      --  sends before pre-emption is allowed. The vector is encoded as
      --  follows:, :, : 0: 64 bytes, : 1: 128 bytes, : 2: 192 bytes, : 3: 256
      --  bytes, :, :These bits are static and must be valid before pre_enable
      --  is set.
      ADD_FRAG_SIZE    : MPFS_Registers.UInt2 := 16#0#;
      --  This bit is for enabling/disabling the verification procedure that
      --  determine whether the link partner can support 802.3br. If disabled
      --  the link partner will not be verified and pre-emption is enabled as
      --  soon as pre_enable is set to one. Verify mpackets are responded to
      --  regardless of whether this bit is set. This bit is static and must be
      --  valid before pre_enable is set.
      VERIFY_DISABLE   : Boolean := False;
      --  This bit is for enabling/disabling the pre-emption operation. If set
      --  to zero pre-emption will not occur and verify mpackets will not be
      --  responded to or sent. If verify_disable is zero the verification
      --  process starts when this bit is written with one and pre-emption can
      --  occur once the verification process completes. If verify_disable is
      --  high pre-emption can occur as soon as this bit is set. If this bit is
      --  reset to zero from one and pre-emption is in progress, then
      --  pre-emption will complete and no more pre-emption will occur.
      PRE_ENABLE       : Boolean := False;
      --  Write a one to this bit to initiate the verification procedure.
      --  Writing a one to this bit has no effect if any of the following are
      --  true: pre_enable is zero, verify_disable is one or the verification
      --  procedure is already in progress. If pre-emption is active,
      --  route_rx_to_pmac should be set to zero before writing to the
      --  restart_ver bit otherwise express MAC frames will be sent to the pMAC
      --  and will be lost if they are interspersed between pMAC frame
      --  fragments. This bit always returns zero when read.
      RESTART_VER      : Boolean := False;
      --  When set, the MMSL routes all received traffic to the pMAC rather
      --  than the eMAC when pre_active is 0 in the MMSL status register.
      ROUTE_RX_TO_PMAC : Boolean := True;
      --  This bit is used for test purposes only. When set, the verify_timer
      --  counter is sped up by a factor of 256. The main effect of this is
      --  that about 40 us are spent waiting for a response packet rather than
      --  10 ms.
      MMSL_DEBUG_MODE  : Boolean := False;
      --  When set to 1 the generated mCRC will be inverted before transmission
      --  and the receive path will require the received mCRC to be inverted.
      --  Keep this bit 0 for normal operation.
      INVERT_MCRC      : Boolean := False;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_31_8    : MPFS_Registers.UInt24 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for mmsl_control_Register use record
      ADD_FRAG_SIZE    at 0 range 0 .. 1;
      VERIFY_DISABLE   at 0 range 2 .. 2;
      PRE_ENABLE       at 0 range 3 .. 3;
      RESTART_VER      at 0 range 4 .. 4;
      ROUTE_RX_TO_PMAC at 0 range 5 .. 5;
      MMSL_DEBUG_MODE  at 0 range 6 .. 6;
      INVERT_MCRC      at 0 range 7 .. 7;
      RESERVED_31_8    at 0 range 8 .. 31;
   end record;

   --  MMSL Status Register. This register contains the MMSL status bits.
   type mmsl_status_Register is record
      --  Read-only. This bit is set to one if pre-emption capability is
      --  active. It is set to one after the verification process completes, or
      --  if verify_disable is one when pre_enable is set to one.
      PRE_ACTIVE     : Boolean := False;
      --  Read-only. This bit indicates the state of the respond state
      --  machine:, : 0 - R_IDLE, : 1 - SEND_RESPOND
      RESPOND_STATUS : Boolean := False;
      --  Read-only. These bits indicate the state of the verification state
      --  machine:, : 3'b000 - INIT_VERIFICATION, : 3'b001 - VERIFICATION_IDLE,
      --  : 3'b010 - SEND_VERIFY, : 3'b011 - WAIT_FOR_RESPONSE, : 3'b100 -
      --  VERIFIED, : 3'b101 - VERIFY_FAIL
      VERIFY_STATUS  : MPFS_Registers.UInt3 := 16#0#;
      --  This bit is set to 1 if the response m-packet received is incorrect.
      --  If this occurs the verification process fails.
      RCV_R_ERROR    : Boolean := False;
      --  This bit is set to 1 if the verification m-packet received is
      --  incorrect
      RCV_V_ERROR    : Boolean := False;
      --  This is set to 1 if an SMD-S is received when waiting for an SMD-C
      SMDS_ERROR     : Boolean := False;
      --  This bit is set to 1 if an SMD-C is received when waiting for an
      --  SMD-S
      SMDC_ERROR     : Boolean := False;
      --  This bit is set to 1 if a frame count error occurs, that is if the
      --  SMD-C received indicates a different frame count than expected (i.e.
      --  the fragment belongs to another frame and not to the Start packet
      --  already received before this) or if a Fragment error happened, which
      --  means the field following the SMD-C received was encoding a different
      --  fragment count than it was supposed to be
      FRER_COUNT_ERR : Boolean := False;
      --  This bit is set to 1 if an illegal SMD is received, that is if the
      --  SMD was not an Express, Verify, Response, Start Preemptible or
      --  Continuation Preemptible SMD.
      SMD_ERROR      : Boolean := False;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_31_11 : MPFS_Registers.UInt21 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for mmsl_status_Register use record
      PRE_ACTIVE     at 0 range 0 .. 0;
      RESPOND_STATUS at 0 range 1 .. 1;
      VERIFY_STATUS  at 0 range 2 .. 4;
      RCV_R_ERROR    at 0 range 5 .. 5;
      RCV_V_ERROR    at 0 range 6 .. 6;
      SMDS_ERROR     at 0 range 7 .. 7;
      SMDC_ERROR     at 0 range 8 .. 8;
      FRER_COUNT_ERR at 0 range 9 .. 9;
      SMD_ERROR      at 0 range 10 .. 10;
      RESERVED_31_11 at 0 range 11 .. 31;
   end record;

   --  MMSL error statistics register. This register contains error counters
   --  for the MMSL. It is cleared on a read and does not roll if its maximum
   --  value is reached.
   type mmsl_err_stats_Register is record
      --  A count of MAC frames with reassembly errors. The counter is
      --  incremented by one every time the ASSEMBLY_ERROR state in the Receive
      --  Processing State Diagram is entered.
      ASS_ERROR_COUNT : MPFS_Registers.UInt8 := 16#0#;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_15_8   : MPFS_Registers.UInt8 := 16#0#;
      --  A count of received MAC frames/MAC frame fragments rejected due to
      --  unknown SMD value or arriving with an SMD-C when no frame is in
      --  progress.
      SMD_ERR_COUNT   : MPFS_Registers.UInt8 := 16#0#;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_31_24  : MPFS_Registers.UInt8 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for mmsl_err_stats_Register use record
      ASS_ERROR_COUNT at 0 range 0 .. 7;
      RESERVED_15_8   at 0 range 8 .. 15;
      SMD_ERR_COUNT   at 0 range 16 .. 23;
      RESERVED_31_24  at 0 range 24 .. 31;
   end record;

   --  MMSL frames reassembled OK register. This register contains a count of
   --  MAC frames that were successfully reassembled and delivered to MAC. It
   --  is cleared on a read and does not roll if its maximum value is reached.
   type mmsl_ass_ok_count_Register is record
      --  A count of MAC frames that were successfully reassembled and
      --  delivered to the MAC.
      ASS_OK_COUNT   : MPFS_Registers.UInt17 := 16#0#;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_31_17 : MPFS_Registers.UInt15 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for mmsl_ass_ok_count_Register use record
      ASS_OK_COUNT   at 0 range 0 .. 16;
      RESERVED_31_17 at 0 range 17 .. 31;
   end record;

   --  MMSL fragments received register. This register contains a count of the
   --  number of additional mPackets received due to preemption. It is cleared
   --  on a read and does not roll if its maximum value is reached.
   type mmsl_frag_count_rx_Register is record
      --  A count of the number of additional mPackets received due to
      --  preemption.
      FRAG_COUNT_RX  : MPFS_Registers.UInt17 := 16#0#;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_31_17 : MPFS_Registers.UInt15 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for mmsl_frag_count_rx_Register use record
      FRAG_COUNT_RX  at 0 range 0 .. 16;
      RESERVED_31_17 at 0 range 17 .. 31;
   end record;

   --  MMSL fragments transmitted register. This register contains a count of
   --  the number of additional mPackets transmitted due to preemption. It is
   --  cleared on a read and does not roll if its maximum value is reached.
   type mmsl_frag_count_tx_Register is record
      --  A count of the number of additional mPackets transmitted due to
      --  preemption.
      FRAG_COUNT_TX  : MPFS_Registers.UInt17 := 16#0#;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_31_17 : MPFS_Registers.UInt15 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for mmsl_frag_count_tx_Register use record
      FRAG_COUNT_TX  at 0 range 0 .. 16;
      RESERVED_31_17 at 0 range 17 .. 31;
   end record;

   --  MMSL Interrupt Status Register. This register indicates the source of an
   --  MMSL interrupt. The corresponding bit in the MMSL interrupt mask
   --  register must be clear for a bit to be set. If any bit is set in this
   --  register the ethernet_int signal will be asserted. For test purposes
   --  each bit can be set or reset by writing to the interrupt mask register.
   --  All interrupt status bits are reset to zero on read if the
   --  `gem_irq_read_clear define is set otherwise a one is written to the
   --  appropriate bit in order to clear it. In this mode reading has no effect
   --  on the status of the bit.
   type mmsl_int_status_Register is record
      --  Indicates an incorrect response m-packet was received. If this occurs
      --  the verification process fails.
      RCV_R_ERR     : Boolean := False;
      --  Indicates an incorrect verification m-packet was received
      RCV_V_ERR     : Boolean := False;
      --  Indicates an SMD-S was received when waiting for an SMD-C
      SMDS_ERR      : Boolean := False;
      --  Indicates an SMD-C was received when waiting for an SMD-S
      SMDC_ERR      : Boolean := False;
      --  Indicates a Frame Count error happened, that is the SMD-C received
      --  indicates a different frame count than expected (i.e. the fragment
      --  belongs to another frame and not to the Start packet already received
      --  before this) or if a Fragment error happened, which means the field
      --  following the SMD-C received was encoding a different fragment count
      --  than it was supposed to be
      FR_COUNT_ERR  : Boolean := False;
      --  Indicates an illegal SMD was received, that is the SMD was not an
      --  Express, Verify, Response, Start Pre-emptible or Continuation
      --  Pre-emptible SMD.
      SMD_ERR       : Boolean := False;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_31_6 : MPFS_Registers.UInt26 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for mmsl_int_status_Register use record
      RCV_R_ERR     at 0 range 0 .. 0;
      RCV_V_ERR     at 0 range 1 .. 1;
      SMDS_ERR      at 0 range 2 .. 2;
      SMDC_ERR      at 0 range 3 .. 3;
      FR_COUNT_ERR  at 0 range 4 .. 4;
      SMD_ERR       at 0 range 5 .. 5;
      RESERVED_31_6 at 0 range 6 .. 31;
   end record;

   --  MMSL Interrupt Enable Register. At reset all interrupts are disabled.
   --  Writing a one to the relevant bit location enables the required
   --  interrupt. This register is write only and when read will return zero.
   type mmsl_int_enable_Register is record
      --  Enable response packet received error interrupt.
      RCV_R_ERROR_INT_EN    : Boolean := False;
      --  Enable verify packet received error interrupt.
      RCV_V_ERROR_INT_EN    : Boolean := False;
      --  Enable SMD-S error interrupt.
      SMDS_ERROR_INT_EN     : Boolean := False;
      --  Enable SMD-C error interrupt.
      SMDC_ERROR_INT_EN     : Boolean := False;
      --  Enable frame count error interrupt.
      FR_COUNT_ERROR_INT_EN : Boolean := False;
      --  Enable SMD error interrupt.
      SMD_ERROR_INT_EN      : Boolean := False;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_31_6         : MPFS_Registers.UInt26 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for mmsl_int_enable_Register use record
      RCV_R_ERROR_INT_EN    at 0 range 0 .. 0;
      RCV_V_ERROR_INT_EN    at 0 range 1 .. 1;
      SMDS_ERROR_INT_EN     at 0 range 2 .. 2;
      SMDC_ERROR_INT_EN     at 0 range 3 .. 3;
      FR_COUNT_ERROR_INT_EN at 0 range 4 .. 4;
      SMD_ERROR_INT_EN      at 0 range 5 .. 5;
      RESERVED_31_6         at 0 range 6 .. 31;
   end record;

   --  MMSL Interrupt Disable Register. Writing a 1 to the relevant bit
   --  location disables that particular interrupt. This register is write only
   --  and when read will return zero.
   type mmsl_int_disable_Register is record
      --  Disable response packet received error interrupt.
      RCV_R_ERROR_INT_DIS    : Boolean := False;
      --  Disable verify packet received error interrupt.
      RCV_V_ERROR_INT_DIS    : Boolean := False;
      --  Disable SMD-S error interrupt.
      SMDS_ERROR_INT_DIS     : Boolean := False;
      --  Disable SMD-C error interrupt.
      SMDC_ERROR_INT_DIS     : Boolean := False;
      --  Disable frame count error interrupt.
      FR_COUNT_ERROR_INT_DIS : Boolean := False;
      --  Disable SMD error interrupt.
      SMD_ERROR_INT_DIS      : Boolean := False;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_31_6          : MPFS_Registers.UInt26 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for mmsl_int_disable_Register use record
      RCV_R_ERROR_INT_DIS    at 0 range 0 .. 0;
      RCV_V_ERROR_INT_DIS    at 0 range 1 .. 1;
      SMDS_ERROR_INT_DIS     at 0 range 2 .. 2;
      SMDC_ERROR_INT_DIS     at 0 range 3 .. 3;
      FR_COUNT_ERROR_INT_DIS at 0 range 4 .. 4;
      SMD_ERROR_INT_DIS      at 0 range 5 .. 5;
      RESERVED_31_6          at 0 range 6 .. 31;
   end record;

   --  MMSL Interrupt Mask Register. The interrupt mask register is a read only
   --  register indicating which interrupts are masked. All bits are set at
   --  reset and can be reset individually by writing to the interrupt enable
   --  register or set individually by writing to the interrupt disable
   --  register. Having separate address locations for enable and disable saves
   --  the need for performing a read modify write when updating the interrupt
   --  mask register. For test purposes there is a write-only function to this
   --  register that allows the bits in the interrupt status register to be set
   --  or cleared, regardless of the state of the mask register.
   type mmsl_int_mask_Register is record
      --  Read-only. Mask bit for response packet received error interrupt.
      RCV_R_ERROR_MASK    : Boolean;
      --  Read-only. Mask bit for verify packet received error interrupt.
      RCV_V_ERROR_MASK    : Boolean;
      --  Read-only. Mask bit for SMD-S error interrupt.
      SMDS_ERROR_MASK     : Boolean;
      --  Read-only. Mask bit for SMD-C error interrupt.
      SMDC_ERROR_MASK     : Boolean;
      --  Read-only. Mask bit for frame count error interrupt.
      FR_COUNT_ERROR_MASK : Boolean;
      --  Read-only. Mask bit for SMD error interrupt.
      SMD_ERROR_MASK      : Boolean;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_31_6       : MPFS_Registers.UInt26;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for mmsl_int_mask_Register use record
      RCV_R_ERROR_MASK    at 0 range 0 .. 0;
      RCV_V_ERROR_MASK    at 0 range 1 .. 1;
      SMDS_ERROR_MASK     at 0 range 2 .. 2;
      SMDC_ERROR_MASK     at 0 range 3 .. 3;
      FR_COUNT_ERROR_MASK at 0 range 4 .. 4;
      SMD_ERROR_MASK      at 0 range 5 .. 5;
      RESERVED_31_6       at 0 range 6 .. 31;
   end record;

   --  The network control register contains general MAC control functions for
   --  both receiver and transmitter.
   type emac_network_control_Register is record
      --  Loopback - controls the loopback output pin.
      LOOPBACK                                : Boolean := False;
      --  Loopback local - asserts the loopback_local signal to the system
      --  clock generator. Also connects txd to rxd, tx_en to rx_dv and forces
      --  full duplex mode. If the GEM configuration contains the PCS then bit
      --  11 of the network configuration register must be set low to disable
      --  TBI mode when in internal loopback. rx_clk and tx_clk may malfunction
      --  as the GEM is switched into and out of internal loopback. It is
      --  important that receive and transmit circuits have already been
      --  disabled when making the switch into and out of internal loopback.
      --  Local loopback functionality is optional and may not be supported by
      --  some instantiations of the GEM.
      LOOPBACK_LOCAL                          : Boolean := False;
      --  Receive enable - when set, it enables the GEM to receive data. When
      --  reset frame reception will stop immediately and the receive pipeline
      --  will be cleared. The receive queue pointer register is unaffected.
      ENABLE_RECEIVE                          : Boolean := False;
      --  Transmit enable - when set, it enables the GEM transmitter to send
      --  data. When reset transmission will stop immediately, the transmit
      --  pipeline and control registers will be cleared and the transmit queue
      --  pointer register will reset to point to the start of the transmit
      --  descriptor list. This bit needs to be set before bit 9 the start
      --  transmission bit. (Setting this bit low resets the transmit queue
      --  pointer however reading the transmit queue pointer register through
      --  the APB interface may still return an old value until transmission is
      --  restarted.)
      ENABLE_TRANSMIT                         : Boolean := False;
      --  Management port enable - set to one to enable the management port.
      --  When zero forces mdio to high impedance state and mdc low.
      MAN_PORT_EN                             : Boolean := False;
      --  Clear statistics registers - this bit is write only. Writing a one
      --  clears the statistics registers.
      CLEAR_ALL_STATS_REGS                    : Boolean := False;
      --  Incremental statistics registers - this bit is write only. Writing a
      --  one increments all the statistics registers by one for test purposes.
      INC_ALL_STATS_REGS                      : Boolean := False;
      --  Write enable for statistics registers - setting this bit to one means
      --  the statistics registers can be written for functional test purposes.
      STATS_WRITE_EN                          : Boolean := False;
      --  Back pressure if set in 10M or 100M half-duplex mode will force
      --  collisions on all received frames. Ignored in gigabit half-duplex
      --  mode.
      BACK_PRESSURE                           : Boolean := False;
      --  Start transmission - writing one to this bit starts transmission.
      TRANSMIT_START                          : Boolean := False;
      --  Transmit halt - writing one to this bit resets the tx_go variable and
      --  halts the dma from reading more transmit frames into the transmit
      --  SRAM buffer. Any frames already read into the transmit SRAM will
      --  still be transmitted.
      TRANSMIT_HALT                           : Boolean := False;
      --  Transmit pause frame - writing one to this bit causes a pause frame
      --  to be transmitted.
      TX_PAUSE_FRAME_REQ                      : Boolean := False;
      --  Transmit zero quantum pause frame - writing one to this bit causes a
      --  pause frame with zero quantum to be transmitted.
      TX_PAUSE_FRAME_ZERO                     : Boolean := False;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_14_13                          : MPFS_Registers.UInt2 := 16#0#;
      --  Store receive time stamp to memory. Setting this bit to one will
      --  cause the CRC of every received frame to be replaced with the value
      --  of the nanoseconds field of the 1588 timer that was captured as the
      --  receive frame passed the message time stamp point (for releases prior
      --  to 1p10 bits 31 and 30 of the value written to the CRC field were
      --  hardwired to zero, from release 1p10 onwards these bits represent the
      --  two least significant seconds bit of the captured timer value). Set
      --  to zero for normal operation.
      STORE_RX_TS                             : Boolean := False;
      --  Enable PFC Priority Based Pause Reception capabilities. Setting this
      --  bit will enable PFC negotiation and recognition of priority based
      --  pause frames.
      PFC_ENABLE                              : Boolean := False;
      --  Write a one to transmit PFC priority based pause frame. Takes the
      --  values stored in the Transmit PFC Pause Register.
      TRANSMIT_PFC_PRIORITY_BASED_PAUSE_FRAME : Boolean := False;
      --  Flush the next packet from the external RX DPRAM. This bit flushes
      --  the frame that is the next in line to be pushed out to the AXI
      --  interface. Writing one to this bit will only have an effect if the
      --  DMA is not currently writing a packet already stored in the DPRAM to
      --  memory.
      FLUSH_RX_PKT_PCLK                       : Boolean := False;
      --  LPI is supported by the pMAC not the eMAC. Do not set this bit in the
      --  eMAC.
      TX_LPI_EN                               : Boolean := False;
      --  Enable detection of unicast PTP unicast frames.
      PTP_UNICAST_ENA                         : Boolean := False;
      --  Alternative sgmii mode. If asserted with sgmii_mode in the network
      --  control register the ACK bit is driven before ability detect during
      --  transfer of status information from the PHY to the MAC.
      ALT_SGMII_MODE                          : Boolean := False;
      --  Store UDP / TCP offset to memory. Setting this bit to one will cause
      --  the upper 16-bits of the CRC of every received frame to be replaced
      --  with the offset from start of frame to the beginning of the UDP or
      --  TCP header. The lower 16-bits of the CRC are replaced with zero and
      --  reserved for future use. The offset is measured in units of 2 bytes.
      --  Set to zero for normal operation.
      STORE_UDP_OFFSET                        : Boolean := False;
      --  External TSU timer port enable (1 = enable) - for the eMAC this
      --  should be enabled.
      EXT_TSU_PORT_ENABLE                     : Boolean := False;
      --  1588 One Step Sync Mode. Write 1 to enable. Replace timestamp field
      --  in the 1588 header for TX Sync Frames with current TSU timer value.
      ONE_STEP_SYNC_MODE                      : Boolean := False;
      --  Enable multiple PFC pause quantums, one per pause priority.
      PFC_CTRL                                : Boolean := False;
      --  Enable external selection of receive queue. When this bit is high the
      --  ext_match1, ext_match2, ext_match3 and ext_match4 inputs will
      --  determine which receive queue a frame is routed to. This will be the
      --  case regardless of the state of the external address match enable bit
      --  9 of the network config register. Note that receive frames will be
      --  dropped unless they are matched by the internal frame filtering
      --  functionality. If the external address match enable bit 9 in the
      --  network config register is set frames may be matched by an external
      --  address match filter as long as one of the ext_match1, ext_match2,
      --  ext_match3 and ext_match4 inputs is asserted early enough. When set
      --  ext_rxq_sel_en takes precedence over the existing screener
      --  functionality. This bit is only relevant if priority queuing is
      --  configured.
      EXT_RXQ_SEL_EN                          : Boolean := False;
      --  1588 One Step Correction Field Update. Set this bit high to enable
      --  updating the correction field of PTP 1588 version 2 sync frames by
      --  adding current TSU timer value.
      OSS_CORRECTION_FIELD                    : Boolean := False;
      --  If the RGMII interface being used set this bit high to configure the
      --  interface for MII operation (in 802.3br configurations this bit has
      --  no effect for the eMAC).
      SEL_MII_ON_RGMII                        : Boolean := False;
      --  2.5G operation selected - setting this bit high drives the
      --  speed_mode[3] top level output pin high and also adjusts the link
      --  timer in the PCS auto-negotiation block to ensure it delivers 10ms
      --  for 2500BASE-X and 1.6ms in SGMII mode, and also ensures
      --  int_moderation counts 800ns periods with the speeded up MAC clocks.
      TWO_PT_FIVE_GIG                         : Boolean := False;
      --  Setting this bit high modifies the CBS algorithm so the IFG/IPG
      --  associated with a transmit frame counts towards its 802.1Qav credit.
      IFG_EATS_QAV_CREDIT                     : Boolean := False;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_31                             : Boolean := False;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for emac_network_control_Register use record
      LOOPBACK                                at 0 range 0 .. 0;
      LOOPBACK_LOCAL                          at 0 range 1 .. 1;
      ENABLE_RECEIVE                          at 0 range 2 .. 2;
      ENABLE_TRANSMIT                         at 0 range 3 .. 3;
      MAN_PORT_EN                             at 0 range 4 .. 4;
      CLEAR_ALL_STATS_REGS                    at 0 range 5 .. 5;
      INC_ALL_STATS_REGS                      at 0 range 6 .. 6;
      STATS_WRITE_EN                          at 0 range 7 .. 7;
      BACK_PRESSURE                           at 0 range 8 .. 8;
      TRANSMIT_START                          at 0 range 9 .. 9;
      TRANSMIT_HALT                           at 0 range 10 .. 10;
      TX_PAUSE_FRAME_REQ                      at 0 range 11 .. 11;
      TX_PAUSE_FRAME_ZERO                     at 0 range 12 .. 12;
      RESERVED_14_13                          at 0 range 13 .. 14;
      STORE_RX_TS                             at 0 range 15 .. 15;
      PFC_ENABLE                              at 0 range 16 .. 16;
      TRANSMIT_PFC_PRIORITY_BASED_PAUSE_FRAME at 0 range 17 .. 17;
      FLUSH_RX_PKT_PCLK                       at 0 range 18 .. 18;
      TX_LPI_EN                               at 0 range 19 .. 19;
      PTP_UNICAST_ENA                         at 0 range 20 .. 20;
      ALT_SGMII_MODE                          at 0 range 21 .. 21;
      STORE_UDP_OFFSET                        at 0 range 22 .. 22;
      EXT_TSU_PORT_ENABLE                     at 0 range 23 .. 23;
      ONE_STEP_SYNC_MODE                      at 0 range 24 .. 24;
      PFC_CTRL                                at 0 range 25 .. 25;
      EXT_RXQ_SEL_EN                          at 0 range 26 .. 26;
      OSS_CORRECTION_FIELD                    at 0 range 27 .. 27;
      SEL_MII_ON_RGMII                        at 0 range 28 .. 28;
      TWO_PT_FIVE_GIG                         at 0 range 29 .. 29;
      IFG_EATS_QAV_CREDIT                     at 0 range 30 .. 30;
      RESERVED_31                             at 0 range 31 .. 31;
   end record;

   --  The network configuration register contains functions for setting the
   --  mode of operation for the Gigabit Ethernet MAC.
   type emac_network_config_Register is record
      --  Speed - set to logic one to indicate 100Mbps operation, logic zero
      --  for 10Mbps. The value of this pin is reflected on the speed_mode[0]
      --  output pin (in 802.3br configurations this bit has no effect for the
      --  eMAC).
      SPEED                            : Boolean := False;
      --  Full duplex - if set to logic one, the transmit block ignores the
      --  state of collision and carrier sense and allows receive while
      --  transmitting. Also controls the half_duplex pin.
      FULL_DUPLEX                      : Boolean := False;
      --  Discard non-VLAN frames - when set only VLAN tagged frames will be
      --  passed to the address matching logic.
      DISCARD_NON_VLAN_FRAMES          : Boolean := False;
      --  Jumbo frames - set to one to enable jumbo frames up to
      --  `gem_jumbo_max_length bytes to be accepted. The default length is
      --  10,240 bytes.
      JUMBO_FRAMES                     : Boolean := False;
      --  Copy all frames - when set to logic one, all valid frames will be
      --  accepted.
      COPY_ALL_FRAMES                  : Boolean := False;
      --  No broadcast - when set to logic one, frames addressed to the
      --  broadcast address of all ones will not be accepted.
      NO_BROADCAST                     : Boolean := False;
      --  Multicast hash enable - when set, multicast frames will be accepted
      --  when the 6 bit hash function of the destination address points to a
      --  bit that is set in the hash register.
      MULTICAST_HASH_ENABLE            : Boolean := False;
      --  Unicast hash enable - when set, unicast frames will be accepted when
      --  the 6 bit hash function of the destination address points to a bit
      --  that is set in the hash register.
      UNICAST_HASH_ENABLE              : Boolean := False;
      --  Receive 1536 byte frames - setting this bit means the GEM will accept
      --  frames up to 1536 bytes in length. Normally the GEM would reject any
      --  frame above 1518 bytes.
      RECEIVE_1536_BYTE_FRAMES         : Boolean := False;
      --  External address match enable - when set the external address match
      --  interface can be used to copy frames to memory.
      EXTERNAL_ADDRESS_MATCH_ENABLE    : Boolean := False;
      --  Gigabit mode enable - setting this bit configures the GEM for 1000
      --  Mbps operation., :0: 10/100 operation using MII or TBI interface, :1:
      --  Gigabit operation using GMII or TBI interface, :(in 802.3br
      --  configurations this bit must be set identically in the eMAC and pMAC)
      GIGABIT_MODE_ENABLE              : Boolean := False;
      --  PCS select - selects between MII/GMII and TBI. Must be set for SGMII
      --  operation., :0: GMII/MII interface enabled, TBI disabled, :1: TBI
      --  enabled, GMII/MII disabled, :(in 802.3br configurations this bit must
      --  be set identically in the eMAC and pMAC)
      PCS_SELECT                       : Boolean := False;
      --  Retry test - must be set to zero for normal operation. If set to one
      --  the backoff between collisions will always be one slot time. Setting
      --  this bit to one helps test the too many retries condition. Also used
      --  in the pause frame tests to reduce the pause counter's decrement time
      --  from 512 bit times, to every rx_clk cycle.
      RETRY_TEST                       : Boolean := False;
      --  Pause enable - when set, transmission will pause if a non-zero 802.3
      --  classic pause frame is received and PFC has not been negotiated.
      PAUSE_ENABLE                     : Boolean := False;
      --  Receive buffer offset - indicates the number of bytes by which the
      --  received data is offset from the start of the receive buffer. Note
      --  that when the define gem_pbuf_rsc has been set then these bits cannot
      --  be used.
      RECEIVE_BUFFER_OFFSET            : MPFS_Registers.UInt2 := 16#0#;
      --  Length field error frame discard - setting this bit causes frames
      --  with a measured length shorter than the extracted length field (as
      --  indicated by bytes 13 and 14 in a non-VLAN tagged frame) to be
      --  discarded. This only applies to frames with a length field less than
      --  0x0600.
      LENGTH_FIELD_ERROR_FRAME_DISCARD : Boolean := False;
      --  FCS remove - setting this bit will cause received frames to be
      --  written to memory without their frame check sequence (last 4 bytes).
      --  The frame length indicated will be reduced by four bytes in this
      --  mode.
      FCS_REMOVE                       : Boolean := False;
      --  MDC clock division - set according to pclk speed. These three bits
      --  determine the number pclk will be divided by to generate MDC. For
      --  conformance with the 802.3 specification, MDC must not exceed 2.5 MHz
      --  (MDC is only active during MDIO read and write operations). The reset
      --  value for this can be changed by defining a new value for
      --  gem_mdc_clock_div in gem_defs.v, :000: divide pclk by 8 (pclk up to
      --  20 MHz), :001: divide pclk by 16 (pclk up to 40 MHz), :010: divide
      --  pclk by 32 (pclk up to 80 MHz), :011: divide pclk by 48 (pclk up to
      --  120MHz), :100: divide pclk by 64 (pclk up to 160 MHz), :101: divide
      --  pclk by 96 (pclk up to 240 MHz), :110: divide pclk by 128 (pclk up to
      --  320 MHz), :111: divide pclk by 224 (pclk up to 540 MHz)., :Note. The
      --  reset value of this field is equal to the gem_mdc_clock_div define,
      --  which is user configurable.
      MDC_CLOCK_DIVISION               : MPFS_Registers.UInt3 := 16#2#;
      --  Data bus width - set according to AMBA (AHB/AXI) or external FIFO
      --  data bus width. The reset value for this can be changed by defining a
      --  new value for gem_dma_bus_width_def in gem_defs. Only valid bus
      --  widths may be written if the system is configured to a maximum width
      --  less than 128-bits., :00: 32 bit data bus width, :01: 64 bit AMBA
      --  (AHB/AXI) data bus width, :10: 128 bit AMBA (AHB/AXI) data bus width,
      --  :11: invalid, :Note. The reset value of this field is equal to the
      --  gem_dma_bus_width_def define, which is user configurable.
      DATA_BUS_WIDTH                   : MPFS_Registers.UInt2 := 16#1#;
      --  Disable copy of pause frames - set to one to prevent pause frames
      --  being copied to memory. When set, neither control frames with type id
      --  8808, nor pause frames with destination address 010000c28001 are
      --  copied to memory, this functionality was enhanced in release 1p09.
      --  Note that valid pause frames received will still increment pause
      --  statistics and pause the transmission of frames as required.
      DISABLE_COPY_OF_PAUSE_FRAMES     : Boolean := False;
      --  Receive checksum offload enable - when set, the receive checksum
      --  engine is enabled. Frames with bad IP, TCP or UDP checksums are
      --  discarded.
      RECEIVE_CHECKSUM_OFFLOAD_ENABLE  : Boolean := False;
      --  Enable frames to be received in half-duplex mode while transmitting.
      EN_HALF_DUPLEX_RX                : Boolean := False;
      --  Ignore RX FCS - when set frames with FCS/CRC errors will not be
      --  rejected. FCS error statistics will still be collected for frames
      --  with bad FCS and FCS status will be recorded in frame's DMA
      --  descriptor. For normal operation this bit must be set to zero.
      IGNORE_RX_FCS                    : Boolean := False;
      --  SGMII mode enable - changes behaviour of the auto-negotiation
      --  advertisement and link partner ability registers to meet the
      --  requirements of SGMII and reduces the duration of the link timer from
      --  10 ms to 1.6 ms.
      SGMII_MODE_ENABLE                : Boolean := False;
      --  IPG stretch enable - when set the transmit IPG can be increased above
      --  96 bit times depending on the previous frame length using the IPG
      --  stretch register.
      IPG_STRETCH_ENABLE               : Boolean := False;
      --  Receive bad preamble. When set frames with non-standard preamble are
      --  not rejected (the first byte of preamble needs to be 55 and the last
      --  D5, bytes other than 55 or D5 may be inserted in between).
      NSP_ACCEPT                       : Boolean := False;
      --  Ignore IPG rx_er. When set rx_er has no effect on the GEMs operation
      --  when rx_dv is low. Set this when using the RGMII wrapper in
      --  half-duplex mode.
      IGNORE_IPG_RX_ER                 : Boolean := False;
      --  Uni-direction-enable. When low the PCS will transmit idle symbols if
      --  the link goes down. When high the PCS can transmit frame data when
      --  the link is down.
      UNI_DIRECTION_ENABLE             : Boolean := False;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for emac_network_config_Register use record
      SPEED                            at 0 range 0 .. 0;
      FULL_DUPLEX                      at 0 range 1 .. 1;
      DISCARD_NON_VLAN_FRAMES          at 0 range 2 .. 2;
      JUMBO_FRAMES                     at 0 range 3 .. 3;
      COPY_ALL_FRAMES                  at 0 range 4 .. 4;
      NO_BROADCAST                     at 0 range 5 .. 5;
      MULTICAST_HASH_ENABLE            at 0 range 6 .. 6;
      UNICAST_HASH_ENABLE              at 0 range 7 .. 7;
      RECEIVE_1536_BYTE_FRAMES         at 0 range 8 .. 8;
      EXTERNAL_ADDRESS_MATCH_ENABLE    at 0 range 9 .. 9;
      GIGABIT_MODE_ENABLE              at 0 range 10 .. 10;
      PCS_SELECT                       at 0 range 11 .. 11;
      RETRY_TEST                       at 0 range 12 .. 12;
      PAUSE_ENABLE                     at 0 range 13 .. 13;
      RECEIVE_BUFFER_OFFSET            at 0 range 14 .. 15;
      LENGTH_FIELD_ERROR_FRAME_DISCARD at 0 range 16 .. 16;
      FCS_REMOVE                       at 0 range 17 .. 17;
      MDC_CLOCK_DIVISION               at 0 range 18 .. 20;
      DATA_BUS_WIDTH                   at 0 range 21 .. 22;
      DISABLE_COPY_OF_PAUSE_FRAMES     at 0 range 23 .. 23;
      RECEIVE_CHECKSUM_OFFLOAD_ENABLE  at 0 range 24 .. 24;
      EN_HALF_DUPLEX_RX                at 0 range 25 .. 25;
      IGNORE_RX_FCS                    at 0 range 26 .. 26;
      SGMII_MODE_ENABLE                at 0 range 27 .. 27;
      IPG_STRETCH_ENABLE               at 0 range 28 .. 28;
      NSP_ACCEPT                       at 0 range 29 .. 29;
      IGNORE_IPG_RX_ER                 at 0 range 30 .. 30;
      UNI_DIRECTION_ENABLE             at 0 range 31 .. 31;
   end record;

   --  The network status register returns status information with respect to
   --  the PHY management MDIO interface, the PCS, priority flow control, LPI
   --  and other status.
   type emac_network_status_Register is record
      --  Read-only. Returns status of PCS link state. If auto-negotiation is
      --  disabled this returns the synchronisation status. If auto-negotiation
      --  is enabled it is set in the LINK_OK state as long as a compatible
      --  duplex mode is resolved, it is always set in the LINK_OK state in
      --  SGMII mode.
      PCS_LINK_STATE          : Boolean;
      --  Read-only. Returns status of the mdio_in pin.
      MDIO_IN                 : Boolean;
      --  Read-only. The PHY management logic is idle (i.e. has completed).
      MAN_DONE                : Boolean;
      --  Read-only. PCS auto-negotiation duplex resolution. Set to one if the
      --  resolution function determines that both devices are capable of full
      --  duplex operation. If zero half-duplex operation is possible as long
      --  as bit 0 (PCS link state) is also one.
      MAC_FULL_DUPLEX         : Boolean;
      --  Read-only. PCS auto-negotiation pause receive resolution.
      MAC_PAUSE_RX_EN         : Boolean;
      --  Read-only. PCS auto-negotiation pause transmit resolution.
      MAC_PAUSE_TX_EN         : Boolean;
      --  Read-only. Set when PFC Priority Based Pause has been negotiated.
      PFC_NEGOTIATE_PCLK      : Boolean;
      --  Read-only. LPI Indication - Low power idle has been detected on
      --  receive. This bit is set when LPI is detected and reset when normal
      --  idle is detected. An interrupt is generated when the state of this
      --  bit changes.
      LPI_INDICATE_PCLK       : Boolean;
      --  Read-only. Outstanding AXI Transactions - This status bit is set when
      --  one or more AXI read or write transactions have been issued by the
      --  DUT but the responses have not yet been fully collected.
      AXI_XACTION_OUTSTANDING : Boolean;
      --  Read-only. For 2.5GBASE-X operation these two bits return the state
      --  of link_fault in the LFSM defined in Figure 46-11 of IEEE 802.3:, :
      --  00 - OK, : 01 - local fault, : 10 - remote fault, : 11 - link
      --  interruption, :If the link fault state machine is not enabled (by
      --  setting the 2.5G, AN enable, uni directional enable and tbi control
      --  bits) these two bits are set to zero.
      LINK_FAULT_INDICATION   : MPFS_Registers.UInt2;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_31_11          : MPFS_Registers.UInt21;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for emac_network_status_Register use record
      PCS_LINK_STATE          at 0 range 0 .. 0;
      MDIO_IN                 at 0 range 1 .. 1;
      MAN_DONE                at 0 range 2 .. 2;
      MAC_FULL_DUPLEX         at 0 range 3 .. 3;
      MAC_PAUSE_RX_EN         at 0 range 4 .. 4;
      MAC_PAUSE_TX_EN         at 0 range 5 .. 5;
      PFC_NEGOTIATE_PCLK      at 0 range 6 .. 6;
      LPI_INDICATE_PCLK       at 0 range 7 .. 7;
      AXI_XACTION_OUTSTANDING at 0 range 8 .. 8;
      LINK_FAULT_INDICATION   at 0 range 9 .. 10;
      RESERVED_31_11          at 0 range 11 .. 31;
   end record;

   --  DMA Configuration Register
   type emac_dma_config_Register is record
      --  Selects the burst length to use on the AMBA (AHB/AXI) when
      --  transferring frame data. Not used for DMA management operations and
      --  only used where space and data size allow and respecting AXI/AHB
      --  burst boundary rules. One-hot priority encoding enforced
      --  automatically on register writes as follows, where x represents don't
      --  care:, :1xxxx: Attempt to use bursts of up to 16., :01xxx: Attempt to
      --  use bursts of up to 8., :001xx: Attempt to use bursts of up to 4.,
      --  :0001x: Always use SINGLE bursts., :00001: Always use SINGLE bursts.,
      --  :00000: Attempt to use bursts of up to 256.
      AMBA_BURST_LENGTH          : MPFS_Registers.UInt5 := 16#4#;
      --  Enable header data Splitting. When set, receive frames will be
      --  forwarded to main memory using a minimum of two DMA data buffers. The
      --  first X data buffers will contain the frame header, consisting of the
      --  Ethernet,VLAN,(IPv4 or IPv6),(TCP or UDP). X= (frame header size
      --  divided by rx_buf_size as defined in bits 23:16 of this register).
      --  The last Y data buffers will contain the frame payload. Y= (frame
      --  payload size divided by rx_buf_size). Note that for non
      --  VLAN/IP/TCP/UDP frames, the header will always be 14 bytes. When this
      --  feature is disabled, the frame is forwarded to main memory in blocks
      --  of rx_buf_size.
      HDR_DATA_SPLITTING_EN      : Boolean := False;
      --  endian swap mode enable for management descriptor accesses. When set,
      --  selects swapped endianism for AMBA (AHB/AXI) transfers. When clear,
      --  selects little endian mode.
      ENDIAN_SWAP_MANAGEMENT     : Boolean := False;
      --  endian swap mode enable for packet data accesses. When set, selects
      --  swapped endianism for AMBA (AHB/AXI) transfers. When clear, selects
      --  little endian mode.
      ENDIAN_SWAP_PACKET         : Boolean := False;
      --  Receiver packet buffer memory size select. Having these bits at less
      --  than 11 reduces the amount of memory used for the receive packet
      --  buffer. This reduces the amount of memory used by the GEM. It is
      --  important to set these bits both to one if the full configured
      --  physical memory is available. The value in brackets below represents
      --  the size that would result for the default maximum configured memory
      --  size of 8 Kbytes., :11: Use full configured addressable space (8 Kb),
      --  :10: Do not use top address bit (4 Kb), :01: Do not use top two
      --  address bits (2 Kb), :00: Do not use top three address bits (1 Kb),
      --  :If the GEM is not configured to use the DMA packet buffer, these
      --  bits are not implemented and will be treated as reserved, read as 0,
      --  ignored on write., :Note. The reset value of this field is equal to
      --  the gem_rx_pbuf_size_def define, which is user configurable.
      RX_PBUF_SIZE               : MPFS_Registers.UInt2 := 16#3#;
      --  Transmitter packet buffer memory size select. Having this bit at zero
      --  halves the amount of memory used for the transmit packet buffer. This
      --  reduces the amount of memory used by the GEM. It is important to set
      --  this bit to one if the full configured physical memory is available.
      --  The value in brackets below represents the size that would result for
      --  the default maximum configured memory size of 4 Kbytes., :1: Use full
      --  configured addressable space (4 Kb), :0: Do not use top address bit
      --  (2 Kb), :If the GEM is not configured to use the DMA packet buffer,
      --  this bit is not implemented and will be treated as reserved, read as
      --  0, ignored on write., :Note. The reset value of this field is equal
      --  to the gem_tx_pbuf_size_def define, which is user configurable.
      TX_PBUF_SIZE               : Boolean := True;
      --  Transmitter IP, TCP and UDP checksum generation offload enable (not
      --  supported when in TX Partial Store and Forward mode). When set, the
      --  transmitter checksum generation engine is enabled, to calculate and
      --  substitute checksums for transmit frames. When clear, frame data is
      --  unaffected. If the GEM is not configured to use the DMA packet
      --  buffer, this bit is not implemented and will be treated as reserved,
      --  read as 0, ignored on write.
      TX_PBUF_TCP_EN             : Boolean := False;
      --  Forces the receive DMA to consider the data buffer pointed to by last
      --  descriptor in the descriptor list to be of elastic size (the last
      --  descriptor is the one with its wrap bit set). This means the first
      --  buffer pointed to in the list will always contain the beginning of a
      --  frame (this helps if there is a desire to build custom logic that
      --  interfaces with the receive buffer directly without software
      --  intervention). When set the rx_buf_size bits 23:16 in the dma
      --  configuration register are ignored for the last receive buffer in the
      --  descriptor list and data will be written into the buffer sequentially
      --  until the frame is completely received and the buffer descriptor
      --  status will be updated with the frame length as normal.
      INFINITE_LAST_DBUF_SIZE_EN : Boolean := False;
      --  When the bit is set, bit 16 of the receive buffer descriptor will
      --  represent FCS/CRC error (only if frames with FCS are copied to memory
      --  as enabled by bit 26 in the network config register). When this bit
      --  is clear, bit 16 of the receive buffer descriptor will represent the
      --  Canonical format indicator (CFI) bit as extracted from the receive
      --  frame (if the receive buffer descriptor is pointing to the last data
      --  buffer of the receive frame and the received frame was VLAN tagged).
      CRC_ERROR_REPORT           : Boolean := False;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_15_14             : MPFS_Registers.UInt2 := 16#0#;
      --  DMA receive buffer size in external AMBA (AHB/AXI) system memory. The
      --  value defined by these bits determines the size of buffer to use in
      --  main system memory when writing received data. The value is defined
      --  in multiples of 64 bytes., :0x01 corresponds to buffers of 64 bytes,
      --  :0x02 corresponds to 128 bytes etc., :For example:, :0x02: 128 byte.,
      --  :0x18: 1536 byte (1*max length frame/buffer), :0xA0: 10240 byte
      --  (1*10K jumbo frame/buffer), :0xFF: 16320 byte , :Note that this value
      --  should never be written as zero., :Note. The reset value of this
      --  field is equal to the gem_rx_buffer_length_def define, which is user
      --  configurable.
      RX_BUF_SIZE                : MPFS_Registers.UInt8 := 16#2#;
      --  Auto Discard RX frames during lack of resource. When set, the GEM DMA
      --  will automatically discard the next frame (that is the oldest frame)
      --  from the receiver packet buffer memory when a receive buffer
      --  descriptor is read with its used bit set. When low, then received
      --  frames will remain to be stored in the SRAM based packet buffer until
      --  AMBA (AHB/AXI) buffer resource next becomes available. In this case
      --  if the SRAM memory fills up then there will be a receive overflow
      --  condition and the most recently received frame (that is the newest)
      --  will be discarded. A write to this bit is ignored if the DMA is not
      --  configured in the packet buffer full store and forward mode.
      FORCE_DISCARD_ON_ERR       : Boolean := False;
      --  Force max length bursts on RX. Force the RX DMA to always issue max
      --  length bursts on EOP (end of packet) or EOB (end of buffer)
      --  transfers, even if there is less than max burst real packet data
      --  required to write. Any extra bytes of pad data is set to 0x00. AHB
      --  only - does not apply on AXI bursts (prior to release 1p10) or bursts
      --  that break 1k boundary rule - supported on AXI from release 1p10.
      FORCE_MAX_AMBA_BURST_RX    : Boolean := False;
      --  Force max length bursts on TX. Force the TX DMA to always issue max
      --  length bursts on EOP (end of packet) or EOB (end of buffer) transfers
      --  as defined by bits 4:0 of this register, even when there is less than
      --  max burst data bytes to read. Residual data read is ignored. AHB only
      --  - does not apply on AXI bursts (prior to release 1p10) or bursts that
      --  break 1k boundary rule - supported on AXI from release 1p10.
      FORCE_MAX_AMBA_BURST_TX    : Boolean := False;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_27                : Boolean := False;
      --  Enable RX extended BD mode. See RX BD control register definition for
      --  description of feature.
      RX_BD_EXTENDED_MODE_EN     : Boolean := False;
      --  Enable TX extended BD mode. See TX BD control register definition for
      --  description of feature.
      TX_BD_EXTENDED_MODE_EN     : Boolean := False;
      --  DMA address bus width. 0 = 32b, 1 = 64b.
      DMA_ADDR_BUS_WIDTH_1       : Boolean := False;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_31                : Boolean := False;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for emac_dma_config_Register use record
      AMBA_BURST_LENGTH          at 0 range 0 .. 4;
      HDR_DATA_SPLITTING_EN      at 0 range 5 .. 5;
      ENDIAN_SWAP_MANAGEMENT     at 0 range 6 .. 6;
      ENDIAN_SWAP_PACKET         at 0 range 7 .. 7;
      RX_PBUF_SIZE               at 0 range 8 .. 9;
      TX_PBUF_SIZE               at 0 range 10 .. 10;
      TX_PBUF_TCP_EN             at 0 range 11 .. 11;
      INFINITE_LAST_DBUF_SIZE_EN at 0 range 12 .. 12;
      CRC_ERROR_REPORT           at 0 range 13 .. 13;
      RESERVED_15_14             at 0 range 14 .. 15;
      RX_BUF_SIZE                at 0 range 16 .. 23;
      FORCE_DISCARD_ON_ERR       at 0 range 24 .. 24;
      FORCE_MAX_AMBA_BURST_RX    at 0 range 25 .. 25;
      FORCE_MAX_AMBA_BURST_TX    at 0 range 26 .. 26;
      RESERVED_27                at 0 range 27 .. 27;
      RX_BD_EXTENDED_MODE_EN     at 0 range 28 .. 28;
      TX_BD_EXTENDED_MODE_EN     at 0 range 29 .. 29;
      DMA_ADDR_BUS_WIDTH_1       at 0 range 30 .. 30;
      RESERVED_31                at 0 range 31 .. 31;
   end record;

   --  This register, when read, provides details of the status of the transmit
   --  path. Once read, individual bits may be cleared by writing 1 to them. It
   --  is not possible to set a bit to 1 by writing to the register.
   type emac_transmit_status_Register is record
      --  Used bit read - set when a transmit buffer descriptor is read with
      --  its used bit set. Cleared by writing a one to this bit.
      USED_BIT_READ           : Boolean := False;
      --  Collision occurred - set by the assertion of collision. Cleared by
      --  writing a one to this bit. When operating in 10/100 mode, this status
      --  indicates either a collision or a late collision. In gigabit mode,
      --  this status is not set for a late collision.
      COLLISION_OCCURRED      : Boolean := False;
      --  Retry limit exceeded - cleared by writing a one to this bit.
      RETRY_LIMIT_EXCEEDED    : Boolean := False;
      --  Read-only. Transmit go - if high transmit is active. When using the
      --  exposed FIFO interface, this bit represents bit 3 of the network
      --  control register. When using the DMA interface this bit represents
      --  the tx_go variable as specified in the transmit buffer description.
      TRANSMIT_GO             : Boolean := False;
      --  Transmit frame corruption due to AMBA (AHB/AXI) errors. Set if an
      --  error occurs whilst midway through reading transmit frame from
      --  external memory including HRESP(AHB), RRESP or BRESP(AXI) errors and
      --  buffers exhausted mid frame (if the buffers run out during
      --  transmission of a frame then transmission stops, FCS shall be bad and
      --  tx_er asserted). Also set in DMA packet buffer mode if single frame
      --  is too large for configured packet buffer memory size. Cleared by
      --  writing a one to this bit.
      AMBA_ERROR              : Boolean := False;
      --  Transmit complete - set when a frame has been transmitted. Cleared by
      --  writing a one to this bit.
      TRANSMIT_COMPLETE       : Boolean := False;
      --  Transmit under run - this bit is set if the transmitter was forced to
      --  terminate a frame that it had already began transmitting due to
      --  further data being unavailable. This bit is set if a transmitter
      --  status write back has not completed when another status write back is
      --  attempted. When using the DMA interface configured for internal FIFO
      --  mode, this bit is also set when the transmit DMA has written the SOP
      --  data into the FIFO and either the AHB bus was not granted in time for
      --  further data, or because an AHB not OK response was returned, or
      --  because a used bit was read. When using the DMA interface configured
      --  for packet buffer mode, this bit will never be set. When using the
      --  external FIFO interface, this bit is also set when the tx_r_underflow
      --  input is asserted during a frame transfer. Cleared by writing a 1.
      TRANSMIT_UNDER_RUN      : Boolean := False;
      --  Late collision occurred - only set if the condition occurs in gigabit
      --  mode, as retry is not attempted. Cleared by writing a one to this
      --  bit.
      LATE_COLLISION_OCCURRED : Boolean := False;
      --  bresp/hresp not OK - set when the DMA block sees bresp/hresp not OK.
      --  Cleared by writing a one to this bit.
      RESP_NOT_OK             : Boolean := False;
      --  TX MAC lockup detected - set when lockup has been detected by the
      --  lockup monitor on the MAC transmit path.
      TX_MAC_LOCKUP_DETECTED  : Boolean := False;
      --  TX DMA lockup detected - set when lockup has been detected the
      --  transmit DMA lockup monitor.
      TX_DMA_LOCKUP_DETECTED  : Boolean := False;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_31_11          : MPFS_Registers.UInt21 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for emac_transmit_status_Register use record
      USED_BIT_READ           at 0 range 0 .. 0;
      COLLISION_OCCURRED      at 0 range 1 .. 1;
      RETRY_LIMIT_EXCEEDED    at 0 range 2 .. 2;
      TRANSMIT_GO             at 0 range 3 .. 3;
      AMBA_ERROR              at 0 range 4 .. 4;
      TRANSMIT_COMPLETE       at 0 range 5 .. 5;
      TRANSMIT_UNDER_RUN      at 0 range 6 .. 6;
      LATE_COLLISION_OCCURRED at 0 range 7 .. 7;
      RESP_NOT_OK             at 0 range 8 .. 8;
      TX_MAC_LOCKUP_DETECTED  at 0 range 9 .. 9;
      TX_DMA_LOCKUP_DETECTED  at 0 range 10 .. 10;
      RESERVED_31_11          at 0 range 11 .. 31;
   end record;

   --  This register holds the start address of the receive buffer queue
   --  (receive buffers descriptor list). The receive buffer queue base address
   --  must be initialized before receive is enabled through bit 2 of the
   --  network control register. Once reception is enabled, any write to the
   --  receive buffer queue base address register is ignored. Reading this
   --  register returns the location of the descriptor currently being
   --  accessed. This value increments as buffers are used. Software should not
   --  use this register for determining where to remove received frames from
   --  the queue as it constantly changes as new frames are received. Software
   --  should instead work its way through the buffer descriptor queue checking
   --  the used bits. In terms of AMBA (AHB/AXI) operation, the receive
   --  descriptors are read from memory using a single 32bit AHB/AXI access.
   --  When the datapath is configured at 64bit or 128bit, the receive
   --  descriptors should be aligned at 64-bit boundaries and each pair of
   --  32-bit descriptors is written to using a single 64bit AHB/AXI access.
   --  For 32bit datapaths, the receive descriptors should be aligned at 32-bit
   --  boundaries and are written to using two individual non sequential 32-bit
   --  accesses.
   type emac_receive_q_ptr_Register is record
      --  Disable queue if set to 1. This can be used to reduce the number of
      --  active queues and should only be changed while receive is not
      --  enabled.
      DMA_RX_DIS_Q : Boolean := False;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_1   : Boolean := False;
      --  Receive buffer queue base address - written with the address of the
      --  start of the receive queue.
      DMA_RX_Q_PTR : MPFS_Registers.UInt30 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for emac_receive_q_ptr_Register use record
      DMA_RX_DIS_Q at 0 range 0 .. 0;
      RESERVED_1   at 0 range 1 .. 1;
      DMA_RX_Q_PTR at 0 range 2 .. 31;
   end record;

   --  This register holds the start address of the transmit buffer queue
   --  (transmit buffers descriptor list). The transmit buffer queue base
   --  address register must be initialized before transmit is started through
   --  bit 9 of the network control register. Once transmission has started,
   --  any write to the transmit buffer queue base address register is illegal
   --  and therefore ignored. Note that due to clock boundary synchronization,
   --  it takes a maximum of four pclk cycles from the writing of the transmit
   --  start bit before the transmitter is active. Writing to the transmit
   --  buffer queue base address register during this time may produce
   --  unpredictable results. Reading this register returns the location of the
   --  descriptor currently being accessed. Because the DMA can store data for
   --  multiple frames at once, this may not necessarily be pointing to the
   --  current frame being transmitted. In terms of AMBA AHB/AXI operation, the
   --  transmit descriptors are written to memory using a single 32bit AHB
   --  access. When the datapath is configured as 64bit or 128bit, the transmit
   --  descriptors should be aligned at 64-bit boundaries and each pair of
   --  32-bit descriptors is read from memory using a single AHB/AXI access.
   --  For 32bit datapaths, the descriptors should be aligned at 32-bit
   --  boundaries and the descriptors are read from memory using two individual
   --  32-bit non sequential accesses.
   type emac_transmit_q_ptr_Register is record
      --  Disable queue if set to 1. This can be used to reduce the number of
      --  active queues and should only be changed while transmit is not
      --  enabled.
      DMA_TX_DIS_Q : Boolean := False;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_1   : Boolean := False;
      --  Transmit buffer queue base address - written with the address of the
      --  start of the transmit queue.
      DMA_TX_Q_PTR : MPFS_Registers.UInt30 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for emac_transmit_q_ptr_Register use record
      DMA_TX_DIS_Q at 0 range 0 .. 0;
      RESERVED_1   at 0 range 1 .. 1;
      DMA_TX_Q_PTR at 0 range 2 .. 31;
   end record;

   --  This register, when read provides details of the status of the receive
   --  path. Once read, individual bits may be cleared by writing 1 to them. It
   --  is not possible to set a bit to 1 by writing to the register.
   type emac_receive_status_Register is record
      --  Buffer not available - an attempt was made to get a new buffer and
      --  the pointer indicated that it was owned by the processor. The DMA
      --  will reread the pointer each time an end of frame is received until a
      --  valid pointer is found. This bit is set following each descriptor
      --  read attempt that fails, even if consecutive pointers are
      --  unsuccessful and software has in the meantime cleared the status
      --  flag. Cleared by writing a one to this bit.
      BUFFER_NOT_AVAILABLE   : Boolean := False;
      --  Frame received - one or more frames have been received and placed in
      --  memory. Cleared by writing a one to this bit.
      FRAME_RECEIVED         : Boolean := False;
      --  Receive overrun - this bit is set if either the gem_dma RX FIFO or
      --  external RX FIFO were unable to store the receive frame due to a FIFO
      --  overflow, or if the receive status, reported by the gem_rx module to
      --  the gem_dma was not taken at end of frame. This bit is also set in
      --  DMA packet buffer mode if the packet buffer overflows. For DMA
      --  operation the buffer will be recovered if an overrun occurs. This bit
      --  is cleared by writing a one to it.
      RECEIVE_OVERRUN        : Boolean := False;
      --  bresp/hresp not OK - set when the DMA block sees bresp/hresp not OK.
      --  Cleared by writing a one to this bit.
      RESP_NOT_OK            : Boolean := False;
      --  RX MAC lockup detected - set when lockup has been detected by the
      --  lockup monitor on the MAC receive path.
      RX_MAC_LOCKUP_DETECTED : Boolean := False;
      --  RX DMA lockup detected - set when lockup has been detected the
      --  receive DMA lockup monitor.
      RX_DMA_LOCKUP_DETECTED : Boolean := False;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_31_6          : MPFS_Registers.UInt26 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for emac_receive_status_Register use record
      BUFFER_NOT_AVAILABLE   at 0 range 0 .. 0;
      FRAME_RECEIVED         at 0 range 1 .. 1;
      RECEIVE_OVERRUN        at 0 range 2 .. 2;
      RESP_NOT_OK            at 0 range 3 .. 3;
      RX_MAC_LOCKUP_DETECTED at 0 range 4 .. 4;
      RX_DMA_LOCKUP_DETECTED at 0 range 5 .. 5;
      RESERVED_31_6          at 0 range 6 .. 31;
   end record;

   --  If not configured for priority queuing, the GEM generates a single
   --  interrupt. This register indicates the source of this interrupt. The
   --  corresponding bit in the mask register must be clear for a bit to be
   --  set. If any bit is set in this register the ethernet_int signal will be
   --  asserted. For test purposes each bit can be set or reset by writing to
   --  the interrupt mask register. The default configuration is shown below
   --  whereby all bits are reset to zero on read. Changing the validity of the
   --  `gem_irq_read_clear define will instead require a one to be written to
   --  the appropriate bit in order to clear it. In this mode reading has no
   --  effect on the status of the bit.
   type emac_int_status_Register is record
      --  Management frame sent - the PHY management register has completed its
      --  operation. Cleared on read.
      MANAGEMENT_FRAME_SENT                            : Boolean := False;
      --  Receive complete - a frame has been stored in memory. Cleared on
      --  read.
      RECEIVE_COMPLETE                                 : Boolean := False;
      --  RX used bit read - set when a receive buffer descriptor is read with
      --  its used bit set. Cleared on read.
      RX_USED_BIT_READ                                 : Boolean := False;
      --  TX used bit read - set when a transmit buffer descriptor is read with
      --  its used bit set. Cleared on read.
      TX_USED_BIT_READ                                 : Boolean := False;
      --  Transmit under run - this interrupt is set if the transmitter was
      --  forced to terminate a frame that it has already began transmitting
      --  due to further data being unavailable. If an under run occurs, the
      --  transmitter will force bad crc and tx_er high. This interrupt is set
      --  if a transmitter status write back has not completed when another
      --  status write back is attempted. When using the DMA interface
      --  configured for internal FIFO mode, this interrupt is also set when
      --  the transmit DMA has written the SOP data into the FIFO and either
      --  the AHB bus was not granted in time for further data, or because an
      --  AHB/AXI error response was returned by the connected slave, or
      --  because a used bit was read. When using the DMA interface configured
      --  for packet buffer mode, this bit will never be set. When using the
      --  external FIFO interface, this interrupt is also set when the
      --  tx_r_underflow input was asserted during a frame transfer. Cleared on
      --  read.
      TRANSMIT_UNDER_RUN                               : Boolean := False;
      --  Retry limit exceeded or late collision - transmit error. Late
      --  collision will only cause this status bit to be set in gigabit mode
      --  (as a retry is not attempted). Cleared on read.
      RETRY_LIMIT_EXCEEDED_OR_LATE_COLLISION           : Boolean := False;
      --  Transmit frame corruption due to AMBA (AHB/AXI) error. Set if an
      --  error occurs whilst midway through reading transmit frame from
      --  external system memory, including HRESP errors(AHB), RRESP or
      --  BRESP(AXI) errors and buffers exhausted mid frame (if the buffers run
      --  out during transmission of a frame then transmission stops, FCS shall
      --  be bad and tx_er asserted). Also set in DMA packet buffer mode if
      --  single frame is too large for configured packet buffer memory size.
      --  Cleared on a read.
      AMBA_ERROR                                       : Boolean := False;
      --  Transmit complete - set when a frame has been transmitted. Cleared on
      --  read.
      TRANSMIT_COMPLETE                                : Boolean := False;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_8                                       : Boolean := False;
      --  Link change - set when the PCS link status changes. If
      --  auto-negotiation is enabled then link status goes high when it
      --  completes. If AN is disabled link status goes high when
      --  synchronization is achieved. If 802.3cb link fault signalling is
      --  enabled a link change interrupt is triggered when the link fault
      --  indication as reported in the network status register changes.
      --  Cleared on read.
      LINK_CHANGE                                      : Boolean := False;
      --  Receive overrun - set when the receive overrun status bit gets set.
      --  Cleared on read.
      RECEIVE_OVERRUN                                  : Boolean := False;
      --  bresp/hresp not OK - set when the DMA block sees bresp/hresp not OK.
      --  Cleared on read.
      RESP_NOT_OK                                      : Boolean := False;
      --  Pause frame with non-zero pause quantum received - indicates a valid
      --  legacy pause frame with a non-zero pause quantum field has been
      --  received or any valid PFC pause frame has been received. Cleared on
      --  read.
      PAUSE_FRAME_WITH_NON_ZERO_PAUSE_QUANTUM_RECEIVED : Boolean := False;
      --  Pause Time elapsed - set when either the pause time register at
      --  address 0x38 decrements to zero, or when a valid pause frame is
      --  received with a zero pause quantum field. Not set for PFC pause
      --  frames. Cleared on read.
      PAUSE_TIME_ELAPSED                               : Boolean := False;
      --  Pause frame transmitted - indicates a pause frame has been
      --  successfully transmitted after being initiated from the network
      --  control register or from the tx_pause control pin. Cleared on read.
      PAUSE_FRAME_TRANSMITTED                          : Boolean := False;
      --  External interrupt - set when a rising edge has been detected on the
      --  ext_interrupt_in input pin. Cleared on read.
      EXTERNAL_INTERRUPT                               : Boolean := False;
      --  PCS auto-negotiation complete - set once the internal PCS layer has
      --  completed auto-negotiation. Cleared on read.
      PCS_AUTO_NEGOTIATION_COMPLETE                    : Boolean := False;
      --  PCS link partner page received - set when a new base page or next
      --  page is received from the link partner. The first time this interrupt
      --  is received, it will indicate base page received and subsequent reads
      --  will indicate next pages. The next page and base page registers
      --  should only be read when this interrupt is signalled. For next pages,
      --  the link partner next page register should be read first to avoid the
      --  register being over written. This interrupt also indicates when the
      --  host should write a new page into the next page register. If further
      --  next page exchange is only required by the link partner, this
      --  register should be written with a null message page (0x2001). Cleared
      --  on read.
      PCS_LINK_PARTNER_PAGE_RECEIVED                   : Boolean := False;
      --  PTP delay_req frame received indicates a PTP delay_req frame has been
      --  received. Cleared on read.
      PTP_DELAY_REQ_FRAME_RECEIVED                     : Boolean := False;
      --  PTP sync frame received indicates a PTP sync frame has been received.
      --  Cleared on read.
      PTP_SYNC_FRAME_RECEIVED                          : Boolean := False;
      --  PTP delay_req frame transmitted indicates a PTP delay_req frame has
      --  been transmitted. Cleared on read.
      PTP_DELAY_REQ_FRAME_TRANSMITTED                  : Boolean := False;
      --  PTP sync frame transmitted indicates a PTP sync frame has been
      --  transmitted. Cleared on read.
      PTP_SYNC_FRAME_TRANSMITTED                       : Boolean := False;
      --  PTP pdelay_req frame received indicates a PTP pdelay_req frame has
      --  been received. Cleared on read.
      PTP_PDELAY_REQ_FRAME_RECEIVED                    : Boolean := False;
      --  PTP pdelay_resp frame received indicates a PTP pdelay_resp frame has
      --  been received. Cleared on read.
      PTP_PDELAY_RESP_FRAME_RECEIVED                   : Boolean := False;
      --  PTP pdelay_req frame transmitted indicates a PTP pdelay_req frame has
      --  been transmitted. Cleared on read.
      PTP_PDELAY_REQ_FRAME_TRANSMITTED                 : Boolean := False;
      --  PTP pdelay_resp frame transmitted indicates a PTP pdelay_resp frame
      --  has been transmitted. Cleared on read.
      PTP_PDELAY_RESP_FRAME_TRANSMITTED                : Boolean := False;
      --  TSU seconds register increment indicates the register has
      --  incremented. Cleared on read.
      TSU_SECONDS_REGISTER_INCREMENT                   : Boolean := False;
      --  Receive LPI indication status bit change
      RECEIVE_LPI_INDICATION_STATUS_BIT_CHANGE         : Boolean := False;
      --  WOL interrupt. Indicates a WOL event has been received.
      WOL_INTERRUPT                                    : Boolean := False;
      --  TSU timer comparison interrupt. Indicates when TSU timer count value
      --  is equal to programmed value.
      TSU_TIMER_COMPARISON_INTERRUPT                   : Boolean := False;
      --  RX lockup detection - set when lockup has been detected by any of the
      --  lockup monitors on the receive datapath.
      RX_LOCKUP_DETECTED                               : Boolean := False;
      --  TX lockup detection - set when lockup has been detected by any of the
      --  lockup monitors on the transmit datapath.
      TX_LOCKUP_DETECTED                               : Boolean := False;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for emac_int_status_Register use record
      MANAGEMENT_FRAME_SENT                            at 0 range 0 .. 0;
      RECEIVE_COMPLETE                                 at 0 range 1 .. 1;
      RX_USED_BIT_READ                                 at 0 range 2 .. 2;
      TX_USED_BIT_READ                                 at 0 range 3 .. 3;
      TRANSMIT_UNDER_RUN                               at 0 range 4 .. 4;
      RETRY_LIMIT_EXCEEDED_OR_LATE_COLLISION           at 0 range 5 .. 5;
      AMBA_ERROR                                       at 0 range 6 .. 6;
      TRANSMIT_COMPLETE                                at 0 range 7 .. 7;
      RESERVED_8                                       at 0 range 8 .. 8;
      LINK_CHANGE                                      at 0 range 9 .. 9;
      RECEIVE_OVERRUN                                  at 0 range 10 .. 10;
      RESP_NOT_OK                                      at 0 range 11 .. 11;
      PAUSE_FRAME_WITH_NON_ZERO_PAUSE_QUANTUM_RECEIVED at 0 range 12 .. 12;
      PAUSE_TIME_ELAPSED                               at 0 range 13 .. 13;
      PAUSE_FRAME_TRANSMITTED                          at 0 range 14 .. 14;
      EXTERNAL_INTERRUPT                               at 0 range 15 .. 15;
      PCS_AUTO_NEGOTIATION_COMPLETE                    at 0 range 16 .. 16;
      PCS_LINK_PARTNER_PAGE_RECEIVED                   at 0 range 17 .. 17;
      PTP_DELAY_REQ_FRAME_RECEIVED                     at 0 range 18 .. 18;
      PTP_SYNC_FRAME_RECEIVED                          at 0 range 19 .. 19;
      PTP_DELAY_REQ_FRAME_TRANSMITTED                  at 0 range 20 .. 20;
      PTP_SYNC_FRAME_TRANSMITTED                       at 0 range 21 .. 21;
      PTP_PDELAY_REQ_FRAME_RECEIVED                    at 0 range 22 .. 22;
      PTP_PDELAY_RESP_FRAME_RECEIVED                   at 0 range 23 .. 23;
      PTP_PDELAY_REQ_FRAME_TRANSMITTED                 at 0 range 24 .. 24;
