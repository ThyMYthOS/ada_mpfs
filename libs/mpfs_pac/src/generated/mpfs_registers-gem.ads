   --  Used to set the maximum amount of outstanding transactions on the AXI
   --  bus between AR / R channels and AW / W channels. Cannot be more than the
   --  depth of the configured AXI pipeline FIFO (defined in verilog defs.v)
   type axi_max_pipeline_Register is record
      --  Defines the maximum number of outstanding AXI read requests that can
      --  be issued by the DMA via the AR channel. This is effectively the read
      --  issuing capability.
      AR2R_MAX_PIPELINE : MPFS_Registers.UInt8 := 16#1#;
      --  Defines the maximum number of outstanding AXI write requests that can
      --  be issued by the DMA via the AW channel. This is effectively the
      --  write issuing capability.
      AW2W_MAX_PIPELINE : MPFS_Registers.UInt8 := 16#1#;
      --  For the write issuing capability as defined in bits 15:8 of this
      --  register, select whether the max number of transactions operates
      --  between the AW to W AXI channel or the AW to B channel. Set to 0 to
      --  operate between the AW and W channels. Set to 1 to operate between
      --  the AW and B channels.
      USE_AW2B_FILL     : Boolean := False;
      --  unspecified
      Reserved_17_31    : MPFS_Registers.UInt15 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

