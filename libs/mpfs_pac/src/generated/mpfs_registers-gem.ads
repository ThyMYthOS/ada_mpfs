   --  Type ID Match 1
   type emac_spec_type_Register is record
      --  Type ID match 1. For use in comparisons with received frames type
      --  ID/length field.
      MATCH          : MPFS_Registers.UInt16 := 16#0#;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_30_16 : MPFS_Registers.UInt15 := 16#0#;
      --  Enable copying of type ID match 1 matched frames.
      ENABLE_COPY    : Boolean := False;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for emac_spec_type_Register use record
      MATCH          at 0 range 0 .. 15;
      RESERVED_30_16 at 0 range 16 .. 30;
      ENABLE_COPY    at 0 range 31 .. 31;
   end record;

   --  Wake on LAN Register
   type emac_wol_register_Register is record
      --  Wake on LAN ARP request IP address. Written to define the least
      --  significant 16 bits of the target IP address that is matched to
      --  generate a Wake on LAN event. A value of zero will not generate an
      --  event, even if this is matched by the received frame.
      ADDR           : MPFS_Registers.UInt16 := 16#0#;
      --  Wake on LAN magic packet event enable. When set magic packet events
      --  will cause the wol output to be asserted.
      WOL_MASK_0     : Boolean := False;
      --  Wake on LAN ARP request event enable. When set ARP request events
      --  will cause the wol output to be asserted.
      WOL_MASK_1     : Boolean := False;
      --  Wake on LAN specific address register 1 event enable. When set
      --  specific address 1 events will cause the wol output to be asserted.
      WOL_MASK_2     : Boolean := False;
      --  Wake on LAN multicast hash event enable. When set multicast hash
      --  events will cause the wol output to be asserted.
      WOL_MASK_3     : Boolean := False;
      --  Read-only. Reserved - read 0, ignored when written.
      RESERVED_31_20 : MPFS_Registers.UInt12 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for emac_wol_register_Register use record
      ADDR           at 0 range 0 .. 15;
      WOL_MASK_0     at 0 range 16 .. 16;
      WOL_MASK_1     at 0 range 17 .. 17;
      WOL_MASK_2     at 0 range 18 .. 18;
      WOL_MASK_3     at 0 range 19 .. 19;
      RESERVED_31_20 at 0 range 20 .. 31;
   end record;

   --  IPG stretch register
   type emac_stretch_ratio_Register is record
      --  IPG Stretch. Bits 7:0 are multiplied with the previously transmitted
      --  frame length (including preamble) bits 15:8 +1 divide the frame
      --  length. If the resulting number is greater than 96 and bit 28 is set
      --  in the network configuration register then the resulting number is
      --  used for the transmit inter-packet-gap. 1 is added to bits 15:8 to
      --  prevent a divide by zero.
      IPG_STRETCH    : MPFS_Registers.UInt16 := 16#0#;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_31_16 : MPFS_Registers.UInt16 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for emac_stretch_ratio_Register use record
      IPG_STRETCH    at 0 range 0 .. 15;
      RESERVED_31_16 at 0 range 16 .. 31;
   end record;

   --  Stacked VLAN Register
   type emac_stacked_vlan_Register is record
      --  User defined VLAN_TYPE field. When Stacked VLAN is enabled, the first
      --  VLAN tag in a received frame will only be accepted if the VLAN type
      --  field is equal to this user defined VLAN_TYPE OR equal to the
      --  standard VLAN type (0x8100). Note that the second VLAN tag of a
      --  Stacked VLAN packet will only be matched correctly if its VLAN_TYPE
      --  field equals 0x8100.
      MATCH             : MPFS_Registers.UInt16 := 16#0#;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_30_16    : MPFS_Registers.UInt15 := 16#0#;
      --  Enable stacked VLAN processing mode
      ENABLE_PROCESSING : Boolean := False;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for emac_stacked_vlan_Register use record
      MATCH             at 0 range 0 .. 15;
      RESERVED_30_16    at 0 range 16 .. 30;
      ENABLE_PROCESSING at 0 range 31 .. 31;
   end record;

   --  Transmit PFC Pause Register
   type emac_tx_pfc_pause_Register is record
      --  Priority Vector Enable. If bit 17 of the network control register is
      --  written with a one then the priority enable vector of the PFC
      --  priority based pause frame will be set equal to the value stored in
      --  this register [7:0].
      VECTOR_ENABLE  : MPFS_Registers.UInt8 := 16#0#;
      --  Priority Vector Pause Size. If bit 17 of the network control register
      --  is written with a one then for each entry equal to zero in the
      --  Transmit PFC Pause Register[15:8], the PFC pause frame's pause
      --  quantum field associated with that entry will be taken from the
      --  transmit pause quantum register. For each entry equal to one in the
      --  Transmit PFC Pause Register [15:8], the pause quantum associated with
      --  that entry will be zero.
      VECTOR         : MPFS_Registers.UInt8 := 16#0#;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_31_16 : MPFS_Registers.UInt16 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for emac_tx_pfc_pause_Register use record
      VECTOR_ENABLE  at 0 range 0 .. 7;
      VECTOR         at 0 range 8 .. 15;
      RESERVED_31_16 at 0 range 16 .. 31;
   end record;

   --  Specific Address Mask 1 Top 47:32
   type emac_mask_add1_top_Register is record
      --  Specific Address Mask. Setting a bit to one masks the corresponding
      --  bit in the specific address 1 register
      ADDRESS_MASK   : MPFS_Registers.UInt16 := 16#0#;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_31_16 : MPFS_Registers.UInt16 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for emac_mask_add1_top_Register use record
      ADDRESS_MASK   at 0 range 0 .. 15;
      RESERVED_31_16 at 0 range 16 .. 31;
   end record;

   --  Receive DMA Data Buffer Address Mask - only applies to AHB operation
   type emac_dma_addr_or_mask_Register is record
      --  Data Buffer Address Mask Enable. These bits are associated directly
      --  with bits[31:28].When bit 0 is set, the AHB address bit 28 used for
      --  accessing the receive data buffers will be forced to the value stored
      --  in bit 28 of this register. When bit 1 is set, the AHB address bit 29
      --  used for accessing the receive data buffers will be forced to the
      --  value stored in bit 29 of this register. When bit 2 is set, the AHB
      --  address bit 30 used for accessing the receive data buffers will be
      --  forced to the value stored in bit 30 of this register. When bit 3 is
      --  set, the AHB address bit 31 used for accessing the receive data
      --  buffers will be forced to the value stored in bit 31 of this
      --  register. When these bits are clear, the associated value stored in
      --  bits 31:28 have no effect on the AHB address used for receive data
      --  buffer accesses. Any changes to this register will be ignored while
      --  the DMA is currently processing a receive packet. It will only affect
      --  the next full packet to be written to external memory.
      MASK_ENABLE   : MPFS_Registers.UInt4 := 16#0#;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_27_4 : MPFS_Registers.UInt24 := 16#0#;
      --  Data Buffer Address Mask Value. Values used to force bits 31:28 of
      --  the receive data buffer AHB address to a particular value when the
      --  associated enable bits stored in this register [3:0] are set. Any
      --  changes to this register will be ignored while the DMA is currently
      --  processing a receive packet. It will only affect the next full packet
      --  to be written to external system memory.
      MASK_VALUE    : MPFS_Registers.UInt4 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for emac_dma_addr_or_mask_Register use record
      MASK_ENABLE   at 0 range 0 .. 3;
      RESERVED_27_4 at 0 range 4 .. 27;
      MASK_VALUE    at 0 range 28 .. 31;
   end record;

   --  TSU timer comparison value nanoseconds
   type emac_tsu_nsec_cmp_Register is record
      --  TSU timer comparison value (ns). Value is compared to the bits[45:24]
      --  of the TSU timer count value (upper 22 bits of nanosecond value). The
      --  output tsu_timer_cmp_val is driven high when the timer comparison
      --  values match the TSU count value. From release 1p11 onwards this
      --  comparison only occurs once the nanosecond compare register has been
      --  written and when the match occurs tsu_timer_cmp_val will only be
      --  driven high for a single tsu_clk period.
      COMPARISON_VALUE : MPFS_Registers.UInt22 := 16#0#;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_31_22   : MPFS_Registers.UInt10 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for emac_tsu_nsec_cmp_Register use record
      COMPARISON_VALUE at 0 range 0 .. 21;
      RESERVED_31_22   at 0 range 22 .. 31;
   end record;

   --  TSU timer comparison value seconds 47:32
   type emac_tsu_msb_sec_cmp_Register is record
      --  TSU timer comparison value (s). Value is compared to the top 16 bits
      --  (most significant 16-bits [47:32] of seconds value) of the TSU timer
      --  count value.
      COMPARISON_VALUE : MPFS_Registers.UInt16 := 16#0#;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_31_16   : MPFS_Registers.UInt16 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for emac_tsu_msb_sec_cmp_Register use record
      COMPARISON_VALUE at 0 range 0 .. 15;
      RESERVED_31_16   at 0 range 16 .. 31;
   end record;

   --  PTP Event Frame Transmitted Seconds Register 47:32
   type emac_tsu_ptp_tx_msb_sec_Register is record
      --  Read-only. PTP Event Frame TX Seconds. The register is updated with
      --  the value that the 1588 timer seconds register held when the SFD of a
      --  PTP transmit primary event crosses the MII interface. The actual
      --  update occurs when the GEM recognizes the frame as a PTP sync or
      --  delay_req frame. An interrupt is issued when the register is updated.
      TIMER_SECONDS  : MPFS_Registers.UInt16;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_31_16 : MPFS_Registers.UInt16;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for emac_tsu_ptp_tx_msb_sec_Register use record
      TIMER_SECONDS  at 0 range 0 .. 15;
      RESERVED_31_16 at 0 range 16 .. 31;
   end record;

   --  PTP Event Frame Received Seconds Register 47:32
   type emac_tsu_ptp_rx_msb_sec_Register is record
      --  Read-only. PTP Event Frame TX Seconds. The register is updated with
