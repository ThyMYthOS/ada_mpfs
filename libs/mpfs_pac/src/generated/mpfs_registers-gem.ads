      COUNT          at 0 range 0 .. 9;
      RESERVED_31_10 at 0 range 10 .. 31;
   end record;

   --  Receive Symbol Errors
   type rx_symbol_errors_Register is record
      --  Receive symbol errors - a 10-bit register counting the number of
      --  frames that had rx_er asserted during reception. For 10/100 mode
