   for tsu_peer_tx_nsec_Register use record
      TIMER          at 0 range 0 .. 29;
      RESERVED_31_30 at 0 range 30 .. 31;
   end record;

   --  PTP Peer Event Frame Received Nanoseconds Register
   type tsu_peer_rx_nsec_Register is record
      --  Read-only. PTP Peer Event Frame Received Nanoseconds. The register is
      --  updated with the value that the 1588 timer nanoseconds register held
      --  when the SFD of a PTP receive peer event crosses the MII interface.
      --  The actual update occurs when the GEM recognizes the frame as a PTP
      --  pdelay_req or pdelay_resp frame. An interrupt is issued when the
      --  register is updated.
      TIMER          : MPFS_Registers.UInt30;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_31_30 : MPFS_Registers.UInt2;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for tsu_peer_rx_nsec_Register use record
