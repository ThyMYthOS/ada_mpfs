      --  less than 128-bits., :00: 32 bit data bus width, :01: 64 bit AMBA
      --  (AHB/AXI) data bus width, :10: 128 bit AMBA (AHB/AXI) data bus width,
      --  :11: invalid, :Note. The reset value of this field is equal to the
      --  gem_dma_bus_width_def define, which is user configurable.
      DATA_BUS_WIDTH                   : MPFS_Registers.UInt2 := 16#1#;
