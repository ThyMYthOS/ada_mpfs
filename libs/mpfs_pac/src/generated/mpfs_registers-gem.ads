   for asf_protocol_fault_status_Register use record
      RX_CRC_ERR_STATUS          at 0 range 0 .. 0;
      RX_SHORT_ERR_STATUS        at 0 range 1 .. 1;
      RX_LONG_ERR_STATUS         at 0 range 2 .. 2;
      RX_SYMBOL_ERR_STATUS       at 0 range 3 .. 3;
      RX_LENGTH_ERR_STATUS       at 0 range 4 .. 4;
      RX_IP_CK_ERR_STATUS        at 0 range 5 .. 5;
      RX_TCP_CK_ERR_STATUS       at 0 range 6 .. 6;
      RX_UDP_CK_ERR_STATUS       at 0 range 7 .. 7;
