      RX_MAC_LOCKUP_TIME : MPFS_Registers.UInt16 := 16#FFFF#;
      --  Prior to release 1p11 this field was reserved. From release 1p11
      --  onwards this field defines the timeout value for transmit MAC lockup
      --  detection defined as a multiple of the prescaler value stored in bits
      --  15:0 of the lockup config register.
      TX_MAC_LOCKUP_TIME : MPFS_Registers.UInt11 := 16#7FF#;
      --  Read-only. Reserved, read as 0, ignored on write.
      RESERVED_31_27     : MPFS_Registers.UInt5 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for mac_lockup_time_Register use record
      RX_MAC_LOCKUP_TIME at 0 range 0 .. 15;
      TX_MAC_LOCKUP_TIME at 0 range 16 .. 26;
      RESERVED_31_27     at 0 range 27 .. 31;
   end record;

   --  DMA TX Lockup Enable Control Register. This register enables the lockup
