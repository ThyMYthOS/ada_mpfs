      RESERVED_31_30 at 0 range 30 .. 31;
   end record;

   --  Note: All PCS registers are defined in the IEEE 802.3 Standard. PCS
   --  Control Register. This register provides the main control functions with
   --  respect to the PCS.
   type pcs_control_Register is record
      --  Read-only. Reserved. Set to zero.
      RESERVED_5_0       : MPFS_Registers.UInt6 := 16#0#;
      --  Read-only. Speed select bit 0 - combined with speed select [1] to
      --  indicate the speed of operation of the PCS. As the GEM PCS is only
      --  intended to operate at 1000 Mbps, this bit is hardwired to logic 1.
      SPEED_SELECT_BIT_0 : Boolean := True;
      --  Collision test - when set active high, the PCS generates collisions
      --  on transmit. This bit should only be set for test purposes.
      COLLISION_TEST     : Boolean := False;
      --  Read-only. MAC Duplex state. This returns the value of the MAC's
      --  duplex state as indicated in bit 1 of the MAC's network configuration
      --  register.
      MAC_DUPLEX_STATE   : Boolean := False;
      --  Restart auto-negotiation - when set active high, the hardware
      --  restarts auto-negotiation. This bit is self-clearing, but once set
      --  shall remain in this state until auto-negotiation has restarted.
      --  Writing logic 0 has no effect.
      RESTART_AUTO_NEG   : Boolean := False;
      --  Read-only. Reserved. Set to zero.
      RESERVED_11_10     : MPFS_Registers.UInt2 := 16#0#;
      --  Enable auto-negotiation - when set active high, auto-negotiation
      --  operation is enabled.
      ENABLE_AUTO_NEG    : Boolean := True;
      --  Read-only. Speed select bit 1 - combined with speed select [0] to
      --  indicate the speed of operation of the PCS. As the GEM PCS is only
      --  intended to operate at 1000 Mbps, this bit is hardwired to logic 0.
      SPEED_SELECT_BIT_1 : Boolean := False;
      --  Loopback mode - the ewrap output pin of the GEM reflects this control
      --  bit, and can be used to select loopback mode in the PHY transceiver.
      --  0: Loopback mode disabled. 1: Loopback mode enabled.
      LOOPBACK_MODE      : Boolean := False;
      --  PCS software reset - written by software to force the hardware logic
      --  into a reset state. This bit is self-clearing. When reading this bit,
      --  logic 1 is returned until both the soft reset has completed and the
      --  PCS is enabled through the PCS select bit of the network
      --  configuration register. Writing logic 0 has no effect.
      PCS_SOFTWARE_RESET : Boolean := True;
      --  Read-only. Reserved. Set to zero.
      RESERVED_31_16     : MPFS_Registers.UInt16 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for pcs_control_Register use record
      RESERVED_5_0       at 0 range 0 .. 5;
      SPEED_SELECT_BIT_0 at 0 range 6 .. 6;
      COLLISION_TEST     at 0 range 7 .. 7;
      MAC_DUPLEX_STATE   at 0 range 8 .. 8;
      RESTART_AUTO_NEG   at 0 range 9 .. 9;
      RESERVED_11_10     at 0 range 10 .. 11;
      ENABLE_AUTO_NEG    at 0 range 12 .. 12;
      SPEED_SELECT_BIT_1 at 0 range 13 .. 13;
      LOOPBACK_MODE      at 0 range 14 .. 14;
      PCS_SOFTWARE_RESET at 0 range 15 .. 15;
      RESERVED_31_16     at 0 range 16 .. 31;
   end record;

   --  This register indicates general status information concerning the PCS.
   type pcs_status_Register is record
      --  Read-only. Extended register capabilities - when set active high,
      --  indicates the PCS supports extended register capabilities. This bit
      --  is hardwired to logic 1.
      EXTENDED_CAPABILITIES   : Boolean;
      --  Read-only. Reserved. Set to zero.
      RESERVED_1              : Boolean;
      --  Read-only. Link status - indicates the status of the physical
      --  connection to the link partner. When set to logic 1 the link is up,
      --  and when set to logic 0, the link is down. If auto-negotiation is
      --  disabled this returns the synchronisation status. Held at logic 0 if
      --  the link goes down until this bit is read.
      LINK_STATUS             : Boolean;
      --  Read-only. Auto-negotiation ability - this bit indicates whether the
      --  PCS has auto-negotiation ability and reflects the value of the
      --  auto-negotiation enable bit in the PCS control register. 0: PCS is
      --  not able to perform auto-negotiation. 1: PCS is able to perform
      --  auto-negotiation.
      AUTO_NEG_ABILITY        : Boolean;
      --  Read-only. Remote fault - set active high if the link partner remote
      --  fault bits in the PCS auto-negotiation link partner ability register,
      --  indicates an error. Resets low when read.
      REMOTE_FAULT            : Boolean;
      --  Read-only. Auto-negotiation complete - set active high by the PCS
      --  hardware to indicate auto-negotiation has completed.
      AUTO_NEG_COMPLETE       : Boolean;
      --  Read-only. Reserved. Set to zero.
      RESERVED_7_6            : MPFS_Registers.UInt2;
      --  Read-only. Extended status - when set active high, indicates extended
      --  status information is present in the PCS auto-negotiation extended
      --  status register. This bit is hardwired to logic 1.
      EXTENDED_STATUS         : Boolean;
      --  Read-only. 100 BASE-T2 half-duplex - the GEM PCS does not support 100
      --  BASE-T2. This bit is hardwired to logic 0.
      BASE_100_T2_HALF_DUPLEX : Boolean;
      --  Read-only. 100 BASE-T2 full duplex - the GEM PCS does not support 100
      --  BASE-T2. This bit is hardwired to logic 0.
      BASE_100_T2_FULL_DUPLEX : Boolean;
      --  Read-only. 10 Mbps half-duplex - the GEM PCS does not support this
      --  mode. This bit is hardwired to logic 0.
      MBPS_10_HALF_DUPLEX     : Boolean;
      --  Read-only. 10 Mbps full duplex - the GEM PCS does not support this
      --  mode. This bit is hardwired to logic 0.
      MBPS_10_FULL_DUPLEX     : Boolean;
      --  Read-only. 100 BASE-X half-duplex - the GEM PCS does not support 100
      --  BASE-X. This bit is hardwired to logic 0.
      BASE_100_X_HALF_DUPLEX  : Boolean;
      --  Read-only. 100 BASE-X full duplex - the GEM PCS does not support 100
      --  BASE-X. This bit is hardwired to logic 0.
      BASE_100_X_FULL_DUPLEX  : Boolean;
      --  Read-only. 100 BASE-T4 - the GEM PCS does not support 100 BASE-T4.
      --  This bit is hardwired to logic 0.
      BASE_100_T4             : Boolean;
      --  Read-only. Reserved. Set to zero.
      RESERVED_31_16          : MPFS_Registers.UInt16;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for pcs_status_Register use record
      EXTENDED_CAPABILITIES   at 0 range 0 .. 0;
      RESERVED_1              at 0 range 1 .. 1;
      LINK_STATUS             at 0 range 2 .. 2;
      AUTO_NEG_ABILITY        at 0 range 3 .. 3;
      REMOTE_FAULT            at 0 range 4 .. 4;
      AUTO_NEG_COMPLETE       at 0 range 5 .. 5;
      RESERVED_7_6            at 0 range 6 .. 7;
      EXTENDED_STATUS         at 0 range 8 .. 8;
      BASE_100_T2_HALF_DUPLEX at 0 range 9 .. 9;
      BASE_100_T2_FULL_DUPLEX at 0 range 10 .. 10;
      MBPS_10_HALF_DUPLEX     at 0 range 11 .. 11;
      MBPS_10_FULL_DUPLEX     at 0 range 12 .. 12;
      BASE_100_X_HALF_DUPLEX  at 0 range 13 .. 13;
      BASE_100_X_FULL_DUPLEX  at 0 range 14 .. 14;
      BASE_100_T4             at 0 range 15 .. 15;
      RESERVED_31_16          at 0 range 16 .. 31;
   end record;

   --  The value of this register indicates the upper 16-bits of the PHY's
   --  identification code. This is a read-only register with a value defined
   --  by `gem_phy_id_top
   type pcs_phy_top_id_Register is record
      --  Read-only. Upper 16-bits of the PHY identification code,
      --  corresponding to the fixed identification for the GEM IP.
      ID_CODE        : MPFS_Registers.UInt16;
      --  Read-only. Reserved. Set to zero.
      RESERVED_31_16 : MPFS_Registers.UInt16;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for pcs_phy_top_id_Register use record
      ID_CODE        at 0 range 0 .. 15;
      RESERVED_31_16 at 0 range 16 .. 31;
   end record;

   --  The value of this register indicates the lower 16-bits of the PHY's
   --  identification code. This is a read-only register with a value defined
   --  by `gem_phy_id_bot
   type pcs_phy_bot_id_Register is record
      --  Read-only. Lower 16-bits of the PHY identification code,
      --  corresponding to the revision of the GEM IP, which is incremented
      --  after each release of the IP.
      ID_CODE        : MPFS_Registers.UInt16;
      --  Read-only. Reserved. Set to zero.
      RESERVED_31_16 : MPFS_Registers.UInt16;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for pcs_phy_bot_id_Register use record
      ID_CODE        at 0 range 0 .. 15;
      RESERVED_31_16 at 0 range 16 .. 31;
   end record;

   --  The value of this register is used to transmit the base page of the GEM
   --  PCS advertised capabilities as long as SGMII mode is not enabled. If
   --  SGMII mode is enabled by setting bit 27 in the network configuration
   --  register then this register becomes read only with a fixed value of
   --  0x00000001. (SGMII specifies that the transmit configuration information
   --  sent from the MAC to the PHY is fixed with bit 14 set to 1 to indicate
   --  acknowledge, bit 0 set to 1 to indicate SGMII and all other bits set to
   --  0.)
   type pcs_an_adv_Register is record
      --  Read-only. Reserved. Set to zero.
      RESERVED_4_0   : MPFS_Registers.UInt5 := 16#0#;
      --  Full duplex - this bit defines to the link partner whether the GEM is
      --  capable of supporting full duplex operation. , :0: The GEM cannot
      --  support full duplex. , :1: The GEM can support full duplex.
      FULL_DUPLEX    : Boolean := True;
      --  half-duplex - this bit defines to the link partner whether the GEM is
      --  capable of supporting half-duplex operation., :0: The GEM cannot
      --  support half-duplex. , :1: The GEM can support half-duplex.
      HALF_DUPLEX    : Boolean := False;
      --  Pause[1:0] - used to provide a pause capability mechanism as
      --  follows:, :00: No pause. , :01: Symmetric pause. , :10: Asymmetric
      --  pause toward link partner. , :11: Both symmetric pause and asymmetric
      --  pause toward link device.
      PAUSE          : MPFS_Registers.UInt2 := 16#0#;
      --  Read-only. Reserved. Set to zero.
      RESERVED_11_9  : MPFS_Registers.UInt3 := 16#0#;
      --  Remote fault [1:0] - indicates and classifies a remote fault
      --  condition to the link partner:, :00: No error, Link OK, :01: Link
      --  Failure. , :10: Off line. , :11: Auto-negotiation error.
      REMOTE_FAULT   : MPFS_Registers.UInt2 := 16#0#;
      --  Read-only. Reserved. Set to zero.
      RESERVED_14    : Boolean := False;
      --  Next page. When set active high, this bit is used during
      --  auto-negotiation to indicate to the link partner that the PCS
      --  requires exchanging next pages.
      NEXT_PAGE      : Boolean := False;
      --  Read-only. Reserved. Set to zero.
      RESERVED_31_16 : MPFS_Registers.UInt16 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for pcs_an_adv_Register use record
      RESERVED_4_0   at 0 range 0 .. 4;
      FULL_DUPLEX    at 0 range 5 .. 5;
      HALF_DUPLEX    at 0 range 6 .. 6;
      PAUSE          at 0 range 7 .. 8;
      RESERVED_11_9  at 0 range 9 .. 11;
      REMOTE_FAULT   at 0 range 12 .. 13;
      RESERVED_14    at 0 range 14 .. 14;
      NEXT_PAGE      at 0 range 15 .. 15;
      RESERVED_31_16 at 0 range 16 .. 31;
   end record;

   --  When SGMII mode is not enabled, the value of this register contains the
   --  link partner's base page received information. This register is updated
   --  in the ABILITY_DETECT state of the PCS auto-negotiation state machine so
   --  bit 14 will only be set if the link partner is sending acknowledge while
   --  the PCS in this state. The register is not updated in the ACK_DETECT
   --  state. For SGMII mode, the contents of this register change to the one
   --  defined in the SGMII standard. The value of this register contains the
   --  link partner's base page received information. In this case the link
   --  partner is the PHY connected by the SGMII.
   type pcs_an_lp_base_Register is record
      --  Read-only. Reserved. Set to zero.
      RESERVED_4_0                          : MPFS_Registers.UInt5;
      --  Read-only. The contents of this register change depending on SGMII or
      --  non SGMII mode., :, :non SGMII Mode:, :Link partner full duplex -
      --  this bit indicates whether the link partner is capable of supporting
      --  full duplex operation. , :0: The link partner cannot support full
      --  duplex. , :1: The link partner can support full duplex., :, :SGMII
      --  Mode: , :Reserved. read as 0.
      LINK_PARTNER_FULL_DUPLEX              : Boolean;
      --  Read-only. The contents of this register change depending on SGMII or
      --  non SGMII mode., :, :non SGMII Mode:, :Link partner half-duplex -
      --  this bit indicates whether the link partner is capable of supporting
      --  half-duplex operation. , :0: The link partner cannot support
      --  half-duplex. , :1: The link partner can support half-duplex., :,
      --  :SGMII Mode: , :Reserved. read as 0.
      LINK_PARTNER_HALF_DUPLEX              : Boolean;
      --  Read-only. The contents of this register change depending on SGMII or
      --  non SGMII mode., :, :non SGMII Mode:, :Pause[1:0] - provides the link
      --  partner's pause frame capability as follows:, :00: No pause. , :01:
      --  Symmetric pause. , :10: Asymmetric pause toward link partner. , :11:
      --  Both symmetric pause and asymmetric pause toward link device., :,
      --  :SGMII Mode:, :Reserved. read as 0.
      PAUSE                                 : MPFS_Registers.UInt2;
      --  Read-only. The contents of this register change depending on SGMII or
      --  non SGMII mode., :, :non SGMII Mode:, :Reserved. Set to zero., :,
      --  :SGMII Mode :, :Bits 11:10 : Speed : , :11 : Reserved, :10 : 1000
      --  Mbps, :01 : 100Mbps, :00 : 10 Mbps, :Bit 9 : Reserved. read as 0.
      SPEED_RESERVED                        : MPFS_Registers.UInt3;
      --  Read-only. The contents of this register change depending on SGMII or
      --  non SGMII mode., :, :non SGMII Mode:, :Link partner remote fault
      --  [1:0] - indicates and classifies a remote fault condition has been
      --  detected by the link partner as follows:, :00: No error, Link OK,
      --  :01: Link Failure., :10: Off line. , :11: Auto-negotiation error., :,
      --  :SGMII Mode:, :Bit 13: Reserved. read as 0., :Bit 12 : 0 :
      --  half-duplex. 1: Full Duplex.
      LINK_PARTNER_REMOTE_FAULT_DUPLEX_MODE : MPFS_Registers.UInt2;
      --  Read-only. Link partner acknowledge - indicates the link partner has
      --  successfully received the transmitted base page
      LINK_PARTNER_ACKNOWLEDGE              : Boolean;
      --  Read-only. The contents of this register change depending on SGMII or
      --  non SGMII mode., :, :non SGMII Mode:, :Link partner next page - when
      --  set active high, this bit indicates the link partner's intention to
      --  exchange next pages., :, :SGMII Mode: , :Link Status., :0 : Link
      --  Down., :1 : Link Up.
      LINK_PARTNER_NEXT_PAGE_STATUS         : Boolean;
      --  Read-only. Reserved. Set to zero.
      RESERVED_31_16                        : MPFS_Registers.UInt16;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for pcs_an_lp_base_Register use record
      RESERVED_4_0                          at 0 range 0 .. 4;
      LINK_PARTNER_FULL_DUPLEX              at 0 range 5 .. 5;
      LINK_PARTNER_HALF_DUPLEX              at 0 range 6 .. 6;
      PAUSE                                 at 0 range 7 .. 8;
      SPEED_RESERVED                        at 0 range 9 .. 11;
      LINK_PARTNER_REMOTE_FAULT_DUPLEX_MODE at 0 range 12 .. 13;
      LINK_PARTNER_ACKNOWLEDGE              at 0 range 14 .. 14;
      LINK_PARTNER_NEXT_PAGE_STATUS         at 0 range 15 .. 15;
      RESERVED_31_16                        at 0 range 16 .. 31;
   end record;

   --  This register contains auto-negotiation next page ability and page
   --  received information.
   type pcs_an_exp_Register is record
      --  Read-only. Reserved. Set to zero.
      RESERVED_0           : Boolean;
      --  Read-only. Page received - this bit is set active high when a new
      --  page has been received from the link partner. It is cleared when the
      --  link partner next page register has been read.
      PAGE_RECEIVED        : Boolean;
      --  Read-only. Next page capability - hard wired to logic 1 to indicate
      --  that the GEM PCS supports next page operation.
      NEXT_PAGE_CAPABILITY : Boolean;
      --  Read-only. Reserved. Set to zero.
      RESERVED_31_3        : MPFS_Registers.UInt29;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for pcs_an_exp_Register use record
      RESERVED_0           at 0 range 0 .. 0;
      PAGE_RECEIVED        at 0 range 1 .. 1;
      NEXT_PAGE_CAPABILITY at 0 range 2 .. 2;
      RESERVED_31_3        at 0 range 3 .. 31;
   end record;

   --  The value of this register is used to transmit the next page information
   --  for the GEM PCS. For next page exchange to work this register must be
   --  written within 10 ms of receiving a new page from the link partner. If
   --  the link partner is requesting next pages and the GEM has none or no
   --  more to send then this register should be written with the null message
   --  (0x2001). The value 0x0000 must not be written to this register.
   type pcs_an_np_tx_Register is record
      --  Message - contains data as defined by the message page indicator bit.
      MESSAGE                : MPFS_Registers.UInt11 := 16#0#;
      --  Read-only. Reserved. Set to zero.
      RESERVED_11            : Boolean := False;
      --  Acknowledge 2 - when set active high, indicates that the GEM PCS has
      --  the ability to comply with the last received message.
      ACKNOWLEDGE_2          : Boolean := False;
      --  Message page indicator - this bit identifies the message. 0:
      --  Unformatted page. 1: Message page.
      MESSAGE_PAGE_INDICATOR : Boolean := False;
      --  Read-only. Reserved. Set to zero.
      RESERVED_14            : Boolean := False;
      --  Next page to transmit - this bit indicates whether this is the last
      --  next page to be transmitted:0: Last page. 1: Additional page(s) to
      --  follow.
      NEXT_PAGE_TO_TRANSMIT  : Boolean := False;
      --  Read-only. Reserved. Set to zero.
      RESERVED_31_16         : MPFS_Registers.UInt16 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for pcs_an_np_tx_Register use record
      MESSAGE                at 0 range 0 .. 10;
      RESERVED_11            at 0 range 11 .. 11;
      ACKNOWLEDGE_2          at 0 range 12 .. 12;
      MESSAGE_PAGE_INDICATOR at 0 range 13 .. 13;
      RESERVED_14            at 0 range 14 .. 14;
