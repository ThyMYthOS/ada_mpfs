      --  8-bit and stick parity (SP) bit configured to 0. If EAFM bit is
      --  disabled.. the Rx FIFO is enabled by receiving all the bytes. When
      --  EAFM bit is enabled.. the Rx FIFO is disabled until an address flag
      --  with matching address is received. Note: If an address match occurs
      --  and the Rx FIFO is enabled then it can be disabled.. if either
      --  another address flag occurs or there is a mismatch or the EAFC bit is
      --  set. In either case.. the Address flag compare will continue as long
      --  as the EAFM bit is set. 0: Disabled (default) 1: Enabled
      EAFM          : Boolean := False;
      --  Enable a address flag clear (EAFC). When EAFM is enabled the Rx FIFO
      --  is disabled until another address flag with matching address is
      --  received. The bit gets cleared on write in multi-mode control
      --  registers 2. 0: Disabled (default) 1: Enabled
      EAFC          : Boolean := False;
      --  Enable single-wire.. half-duplex mode. 0: Disabled (default) 1:
      --  Enabled
      ESWM          : Boolean := False;
      --  unspecified
      Reserved_4_31 : MPFS_Registers.UInt28 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for MM2_Register use record
      EERR          at 0 range 0 .. 0;
      EAFM          at 0 range 1 .. 1;
      EAFC          at 0 range 2 .. 2;
      ESWM          at 0 range 3 .. 3;
      Reserved_4_31 at 0 range 4 .. 31;
   end record;

   --  Fractional divisor register
   type DFR_Register is record
      --  The fractional divisor register (DFR) is used to store the fractional
      --  divisor used to calculate the fractional baud rate value in 1/64th
      --  using EQ 5. 0x0: 0/64 0x1: 1/64 .... 0x3F: 63/64
      DFR           : MPFS_Registers.UInt6 := 16#0#;
      --  unspecified
      Reserved_6_31 : MPFS_Registers.UInt26 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for DFR_Register use record
      DFR           at 0 range 0 .. 5;
      Reserved_6_31 at 0 range 6 .. 31;
   end record;

   --  Glitch filter register
   type GFR_Register is record
      --  The glitch filter resynchronizes (GLR) and suppresses random input
      --  noise from MMUART_x_RXD (serial input data) and MMUART_x_SCK_IN
      --  (serial input clock in synchronous mode) based on the filter length
      --  given in number system clock cycles. The following are the different
      --  filter lengths in the APB clock cycles that can be written into the
      --  GLR register and their description. 0b000: Two resynchronize
      --  flip-flops are used but there is no spike suppression. 0b001: Three
      --  resynchronize flip-flops are used but there is no spike suppression.
      --  0b010: Three resynchronize flip-flops are used and it also causes 1
      --  APB clock cycle suppression. 0b011: Three resynchronize flip-flops
      --  are used and it also causes 2 APB clock cycle suppression. 0b100:
      --  Three resynchronize flip-flops are used and it also causes 3 APB
      --  clock cycle suppression. 0b101: Three resynchronize flip-flops are
      --  used and it also causes 4 APB clock cycle suppression. 0b110: Three
      --  resynchronize flip-flops are used and it also causes 5 APB clock
      --  cycle suppression. 0b111: Three resynchronize flip-flops are used and
      --  it also causes 6 APB clock cycle suppression.
      GLR           : MPFS_Registers.UInt3 := 16#0#;
      --  unspecified
      Reserved_3_31 : MPFS_Registers.UInt29 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for GFR_Register use record
      GLR           at 0 range 0 .. 2;
      Reserved_3_31 at 0 range 3 .. 31;
   end record;

   --  Transmitter time guard register
   type TTG_Register is record
      --  If the transmitter time guard is enabled from the multi-mode control
      --  register 0 (MM0).. the transmitter time guard value determines the
      --  amount of system clock cycles to wait between transmissions. The time
      --  guard equation is based on the baud rate bit time (Tbit) value as
      --  follows: Tx Time Guard Value = TTG x Bit Time (Tbit)
      TTG           : MPFS_Registers.UInt8 := 16#0#;
      --  unspecified
      Reserved_8_31 : MPFS_Registers.UInt24 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for TTG_Register use record
      TTG           at 0 range 0 .. 7;
      Reserved_8_31 at 0 range 8 .. 31;
   end record;

   --  Receiver time-out register
   type RTO_Register is record
      --  Writing to the RTO register sets the counter value and enables.. if
      --  the ERTO bit in the MM0 is enabled. You can configure the timeout
      --  value by writing into this register. The RTO counts when the Rx block
      --  input state is idle; is reset when a start condition occurs.. and
      --  restarts counting upon returning to the idle state. When the RTO
      --  value is reached.. the RTOII interrupt is set. Re-writing the RTO
      --  register clears the interrupt and sets the counter. The receiver
      --  timeout value equation is based on the baud rate bit time (Tbit) as
      --  follows: Rx Timeout Value = 4 x RTO x Bit Time (Tbit)
      RTO           : MPFS_Registers.UInt8 := 16#0#;
      --  unspecified
      Reserved_8_31 : MPFS_Registers.UInt24 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for RTO_Register use record
      RTO           at 0 range 0 .. 7;
      Reserved_8_31 at 0 range 8 .. 31;
   end record;

   --  Address register
   type ADR_Register is record
      --  The address register is used in 9-bit Address Flag mode. When an
      --  address flag is received on the 9th bit.. and EAFM is set in MM2..
      --  the incoming data is checked against the address register. If a match
      --  occurs.. the Rx FIFO is enabled.
      ADR           : MPFS_Registers.UInt8 := 16#0#;
      --  unspecified
      Reserved_8_31 : MPFS_Registers.UInt24 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for ADR_Register use record
      ADR           at 0 range 0 .. 7;
      Reserved_8_31 at 0 range 8 .. 31;
   end record;

   --  Divisor latch (LSB, DLL of a 16550). The address (offset 0x80) is an
   --  alias of the data port at offset 0: it reaches the divisor latch only
   --  with LCR.DLAB 1; with DLAB 0 it reads and writes RBR/THR instead. The
   --  reset value 0x1 is the latch value, a read at LCR 0 after reset returns
   --  the RBR value (measured on an Icicle Kit MPFS250T with the clock
   --  enabled: +0x00, +0x80 and +0x100 read 0x01 at LCR 0x83, a write of 0x37
   --  at +0x00 reads back at all three; at LCR 0 +0x80 reads the same as +0x00
   --  and a write of 0x37 to +0x80 changes no readback).
   type DLR_Register is record
      --  This divisor latch LSB register (DLR) holds the LSB of the integer
      --  divisor value used to calculate the baud rate. The baud rate can be
      --  calculated using EQ 1.. 2.. 3.. or 4. ** To access this register the
      --  divisor latch access bit (DLAB, bit 7) of the line control register
      --  (LCR) must be set.
      DLR           : MPFS_Registers.UInt8 := 16#1#;
      --  unspecified
      Reserved_8_31 : MPFS_Registers.UInt24 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for DLR_Register use record
      DLR           at 0 range 0 .. 7;
      Reserved_8_31 at 0 range 8 .. 31;
   end record;

   --  Divisor latch (MSB, DLM of a 16550). The address (offset 0x84) is an
   --  alias of the data port at offset 4: it reaches the divisor latch only
   --  with LCR.DLAB 1; with DLAB 0 it reads and writes IER instead. The reset
   --  value 0x0 is the latch value, a read at LCR 0 after reset returns the
   --  IER value (measured on an Icicle Kit MPFS250T with the clock enabled:
   --  +0x84 reads 0 at LCR 0 and at LCR 0x83, the IER value and the DLM reset
   --  value coincide).
   type DMR_Register is record
      --  This divisor latch MSB register (DMR) holds the MSB of the integer
      --  divisor value used to calculate the baud rate. The baud rate can be
      --  calculated using EQ 1.. 2.. 3.. or 4. ** To access this register the
      --  divisor latch access bit (DLAB, bit 7) of the line control register
      --  (LCR) must be set.
      DMR           : MPFS_Registers.UInt8 := 16#0#;
      --  unspecified
      Reserved_8_31 : MPFS_Registers.UInt24 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for DMR_Register use record
      DMR           at 0 range 0 .. 7;
      Reserved_8_31 at 0 range 8 .. 31;
   end record;

   --  Transmit holding register. The address (offset 0x100) is an alias of the
   --  data port at offset 0 (RBR when read, THR when written): a read of this
   --  address is not an access to THR: it returns the receive FIFO like RBR
   --  and pops it (measured on an Icicle Kit MPFS250T with the clock enabled:
   --  +0x100 reads exactly what +0x00 reads at LCR.DLAB 0 and 1).
   type THR_Register is record
      --  Write-only. This register holds the data bits to be transmitted. Bit
      --  0 is the LSB and is transmitted first. The MSB may be transmitted
      --  first.. if it is configured with the E_MSB_TX bit in the MM1. The
      --  reset value is unknown since the register is loaded with data in the
      --  transmit FIFO. The DLAB.. bit 7 of LCR.. must be 0 to write to this
      --  register. This register is write only. Reading from this register
      --  with the DLAB 0 reads the RBR register value and removes the oldest
      --  character from the receive FIFO (read side effect as RBR). With the
      --  DLAB 1 the address reads and writes the divisor latch LSB (DLR).
      THR           : MPFS_Registers.UInt8 := 16#0#;
      --  unspecified
      Reserved_8_31 : MPFS_Registers.UInt24 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for THR_Register use record
      THR           at 0 range 0 .. 7;
      Reserved_8_31 at 0 range 8 .. 31;
   end record;

   --  FIFO control register. The address (offset 0x108) is an alias of the
   --  data port at offset 8 (IIR when read, FCR when written): a read returns
   --  the interrupt identification register IIR, not the last value written
   --  (measured on an Icicle Kit MPFS250T with the clock enabled: +0x108 reads
   --  0xC1, the IIR value at +0x08). The register is write-only; a read of
   --  this address is a read of IIR (which acknowledges a pending transmitter
   --  holding register empty interrupt, see IIR) and must not be used to read
   --  back FCR, so a read-modify-write of FCR is not allowed.
   type FCR_Register is record
      --  Write-only. It enables both the Tx and Rx FIFOs and is hardwired to
      --  1.. which means it is always enabled and cannot be changed.
      ENABLE_TX_RX_FIFO  : Boolean := True;
      --  Write-only. Clears all bytes in Rx FIFO and resets counter logic.
      --  This shift register is not cleared. 0: Disabled (default) 1: Enabled
      CLEAR_RX_FIFO      : Boolean := False;
      --  Write-only. Clears all bytes in the Tx FIFO and resets its counter
      --  logic. The shift register is not cleared. 0: Disabled (default) 1:
      --  Enabled
      CLEAR_TX_FIFO      : Boolean := False;
      --  Write-only. Switches between RXRDY and TXRDY mode 0 and mode 1
      --  functionality. 0-Mode 0. 1-Mode 1
      ENABLE_TXRDY_RXRDY : Boolean := False;
      --  unspecified
      Reserved_4_5       : MPFS_Registers.UInt2 := 16#0#;
      --  Write-only. These bits are used to set the trigger level for the Rx
      --  FIFO interrupt. Rx FIFO trigger level (bytes) are: 0b00: 1 byte 0b01:
      --  4 bytes 0b10: 8 bytes 0b11: 14 bytes
      RX_TRIG            : MPFS_Registers.UInt2 := 16#3#;
      --  unspecified
      Reserved_8_31      : MPFS_Registers.UInt24 := 16#0#;
   end record
     with Volatile_Full_Access, Object_Size => 32,
          Bit_Order => System.Low_Order_First;

   for FCR_Register use record
      ENABLE_TX_RX_FIFO  at 0 range 0 .. 0;
      CLEAR_RX_FIFO      at 0 range 1 .. 1;
      CLEAR_TX_FIFO      at 0 range 2 .. 2;
      ENABLE_TXRDY_RXRDY at 0 range 3 .. 3;
      Reserved_4_5       at 0 range 4 .. 5;
      RX_TRIG            at 0 range 6 .. 7;
      Reserved_8_31      at 0 range 8 .. 31;
   end record;

   -----------------
   -- Peripherals --
   -----------------

   --  MMUART0_HI Controller
   type MMUART_Peripheral is record
      --  Receiver buffer register
      RBR        : aliased RBR_Register;
      --  Interrupt enable register
      IER        : aliased IER_Register;
      --  Interrupt identification register
      IIR        : aliased IIR_Register;
      --  Line control register
      LCR        : aliased LCR_Register;
      --  Modem control register
      MCR        : aliased MCR_Register;
      --  Line status register
      LSR        : aliased LSR_Register;
      --  Modem status register
      MSR        : aliased MSR_Register;
      --  Scratch register
      SR         : aliased SR_Register;
      --  Reserved register
      Reserved   : aliased Reserved_Register;
      --  Multi-mode interrupt enable register
      IEM        : aliased IEM_Register;
      --  Multi-mode interrupt identification register
      IIM        : aliased IIM_Register;
      Reserved_1 : aliased Reserved_1_Register;
      --  Multi-mode control register0
      MM0        : aliased MM0_Register;
      --  Multi-mode control register1
      MM1        : aliased MM1_Register;
      --  Multi-mode control register2
      MM2        : aliased MM2_Register;
      --  Fractional divisor register
      DFR        : aliased DFR_Register;
      --  Glitch filter register
      GFR        : aliased GFR_Register;
      --  Transmitter time guard register
      TTG        : aliased TTG_Register;
      --  Receiver time-out register
      RTO        : aliased RTO_Register;
      --  Address register
      ADR        : aliased ADR_Register;
      --  Divisor latch (LSB, DLL of a 16550). The address (offset 0x80) is an
      --  alias of the data port at offset 0: it reaches the divisor latch only
      --  with LCR.DLAB 1; with DLAB 0 it reads and writes RBR/THR instead. The
      --  reset value 0x1 is the latch value, a read at LCR 0 after reset
      --  returns the RBR value (measured on an Icicle Kit MPFS250T with the
      --  clock enabled: +0x00, +0x80 and +0x100 read 0x01 at LCR 0x83, a write
      --  of 0x37 at +0x00 reads back at all three; at LCR 0 +0x80 reads the
      --  same as +0x00 and a write of 0x37 to +0x80 changes no readback).
      DLR        : aliased DLR_Register;
      --  Divisor latch (MSB, DLM of a 16550). The address (offset 0x84) is an
      --  alias of the data port at offset 4: it reaches the divisor latch only
      --  with LCR.DLAB 1; with DLAB 0 it reads and writes IER instead. The
      --  reset value 0x0 is the latch value, a read at LCR 0 after reset
      --  returns the IER value (measured on an Icicle Kit MPFS250T with the
      --  clock enabled: +0x84 reads 0 at LCR 0 and at LCR 0x83, the IER value
      --  and the DLM reset value coincide).
      DMR        : aliased DMR_Register;
      --  Transmit holding register. The address (offset 0x100) is an alias of
      --  the data port at offset 0 (RBR when read, THR when written): a read
      --  of this address is not an access to THR: it returns the receive FIFO
      --  like RBR and pops it (measured on an Icicle Kit MPFS250T with the
      --  clock enabled: +0x100 reads exactly what +0x00 reads at LCR.DLAB 0
      --  and 1).
      THR        : aliased THR_Register;
      --  FIFO control register. The address (offset 0x108) is an alias of the
      --  data port at offset 8 (IIR when read, FCR when written): a read
      --  returns the interrupt identification register IIR, not the last value
      --  written (measured on an Icicle Kit MPFS250T with the clock enabled:
      --  +0x108 reads 0xC1, the IIR value at +0x08). The register is
      --  write-only; a read of this address is a read of IIR (which
      --  acknowledges a pending transmitter holding register empty interrupt,
      --  see IIR) and must not be used to read back FCR, so a
      --  read-modify-write of FCR is not allowed.
      FCR        : aliased FCR_Register;
   end record
     with Volatile;

   for MMUART_Peripheral use record
      RBR        at 16#0# range 0 .. 31;
      IER        at 16#4# range 0 .. 31;
      IIR        at 16#8# range 0 .. 31;
      LCR        at 16#C# range 0 .. 31;
      MCR        at 16#10# range 0 .. 31;
      LSR        at 16#14# range 0 .. 31;
      MSR        at 16#18# range 0 .. 31;
      SR         at 16#1C# range 0 .. 31;
      Reserved   at 16#20# range 0 .. 31;
      IEM        at 16#24# range 0 .. 31;
      IIM        at 16#28# range 0 .. 31;
      Reserved_1 at 16#2C# range 0 .. 31;
      MM0        at 16#30# range 0 .. 31;
      MM1        at 16#34# range 0 .. 31;
      MM2        at 16#38# range 0 .. 31;
      DFR        at 16#3C# range 0 .. 31;
      GFR        at 16#44# range 0 .. 31;
      TTG        at 16#48# range 0 .. 31;
      RTO        at 16#4C# range 0 .. 31;
      ADR        at 16#50# range 0 .. 31;
      DLR        at 16#80# range 0 .. 31;
      DMR        at 16#84# range 0 .. 31;
      THR        at 16#100# range 0 .. 31;
      FCR        at 16#108# range 0 .. 31;
   end record;

   --  MMUART0_HI Controller
   MMUART0_HI_Periph : aliased MMUART_Peripheral
     with Import, Address => MMUART0_HI_Base,
          Volatile, Async_Readers, Async_Writers, Effective_Writes,
          Effective_Reads => True;

