#
# Single source of truth for all tool versions. Sourced by tools/mpfs-env.sh
# (and read by CI for the toolchain cache key). A change here is its own pull
# request, together with re-blessed metrics.
#
# Plain NAME=VALUE lines only, no command substitution, no export.

# Alire release binary, used when alr is not on PATH (checked against the SHA-256)
ALR_VERSION=2.1.1
ALR_SHA256_X86_64_LINUX=09c66bcd8c35dd4b97b72c3d9b76e44caa6964a2db35aba069f396f00f1f64c7
ALR_SHA256_UNIVERSAL_MACOS=66fc5fb11ac10e3ebf5840e201cf284948475aa9d50a7db5dff045d112c91e02
ALR_SHA256_X86_64_WINDOWS=6c3ebc00afd19448054f0f286b65f6ba9ea283560190925191953a23b3b2f15e
# gnat_riscv64_elf; 16.1.0 exists, switch only together with a bb-runtimes base of v16
GNAT_RISCV64_VERSION=15.3.1
# Host tools and host tests
GNAT_NATIVE_VERSION=15.3.1
GPRBUILD_VERSION=26.0.1

# Alire index versions current on 2026-10-09; change only deliberately.
# `./x toolchain check` reports an empty value as unpinned.
GNATPROVE_VERSION=16.1.0
ADALANG_ANALYZER_VERSION=1.8.8

# svd2ada is built from source at a pinned commit (the Alire release 0.1.0,
# 6eb0b59, has known defects). The commit is pull request #117 of the repository
# (register types of different sizes are not shared) on top of f6071e4; it is not
# on a branch, so x fetches SVD2ADA_REF if the clone does not contain it. Pin the
# upstream commit and leave SVD2ADA_REF empty once the pull request is merged.
SVD2ADA_REPO=https://github.com/AdaCore/svd2ada
SVD2ADA_REF=refs/pull/117/head
SVD2ADA_COMMIT=314265ec980ed9498b421279b2a26f9062fb07b8
# Rust svdtools: the release binary on x86_64 Linux, Apple silicon macOS and
# x86_64 Windows (checked against the SHA-256 of the downloaded file),
# `cargo install --locked` elsewhere, all into a per-version prefix.
# The PyPI package svdtools is an abandoned Python port (lxml~=4.6, no Python 3.13).
SVDTOOLS_VERSION=0.5.0
SVDTOOLS_SHA256_X86_64_LINUX=4d5a911d2adcf917bd98f6b1520c53299d509b0820fad0ff7189501133c44810
SVDTOOLS_SHA256_AARCH64_DARWIN=3beb6e9c9858631af2a174caec00ef85a1e969bf060c9b988a3306fd0a97766b
SVDTOOLS_SHA256_X86_64_WINDOWS=713c1687ffb3743a0a2e45a52143f4f15f1d9f3b9c19809a8df9985d9d75d8e5
# Oldest rustc that builds (source build only) the pinned svdtools (its dependency liquid-lib needs 1.83)
SVDTOOLS_RUSTC_MIN=1.83

RENODE_VERSION=1.17.0
# SHA-256 of renode-$RENODE_VERSION.linux-portable.tar.gz (the release asset)
RENODE_SHA256_X86_64_LINUX=4ba7c68b59e2447f188ef4b4b112fcccd2802582c460beedceb63b84e5605a5f

# Minimum versions of host tools provided by the OS
# QEMU: `-bios none -kernel` needs 10.1 or newer
QEMU_MIN=10.1
PYTHON_MIN=3.13
