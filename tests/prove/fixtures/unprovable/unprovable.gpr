--
--  Fixture of the prove.sh tests: a project that gnatprove cannot prove. It is
--  not in tools/prove.list.

project Unprovable is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Create_Missing_Dirs use "True";
   for Languages use ("Ada");
end Unprovable;
