#
# smoke.expected -- what each image must print on MMUART0 under Renode. Same
# format as tests/qemu/smoke.expected (image<TAB>string, fixed strings, image
# relative to the repository root), edited by hand.
#
# The pmp_probe rows differ from the QEMU ones on purpose: the Renode model of
# the board has 16 PMP entries per hart, QEMU 10.1.0 has 8; it implements bits
# 53:0 of pmpaddr, QEMU all 64. The PMP tests
# (pmp_xml_test, pmp_access_test, apb_window_test) adapt to the number they
# count; their verdict line is printed only when every check held.
image	string
examples/bare_hello/bin-e51/bare_hello.elf	bare hello E51 hart 0
examples/bare_hello/bin-u54/bare_hello.elf	bare hello U54 hart 1
examples/pmp_probe/bin-e51/pmp_probe.elf	pmp probe hart 0
examples/pmp_probe/bin-e51/pmp_probe.elf	pmp entries 16
examples/pmp_probe/bin-e51/pmp_probe.elf	pmp pmpaddr width 54
examples/pmp_probe/bin-u54/pmp_probe.elf	pmp probe hart 1
examples/pmp_probe/bin-u54/pmp_probe.elf	pmp entries 16
examples/pmp_probe/bin-u54/pmp_probe.elf	pmp pmpaddr width 54
examples/pmp_xml_test/bin-e51/pmp_xml_test.elf	TEST pmp_xml_test_e51: PASS
examples/pmp_xml_test/bin-u54/pmp_xml_test.elf	TEST pmp_xml_test_u54: PASS
examples/pmp_access_test/bin-e51/pmp_access_test.elf	TEST pmp_access_test_e51: PASS
examples/pmp_access_test/bin-u54/pmp_access_test.elf	TEST pmp_access_test_u54: PASS
examples/pmp_isolation_test/bin-e51/pmp_isolation_test.elf	TEST pmp_isolation_test_e51: PASS
examples/pmp_isolation_test/bin-u54/pmp_isolation_test.elf	TEST pmp_isolation_test_u54: PASS
examples/apb_window_test/bin-e51/apb_window_test.elf	TEST apb_window_test_e51: PASS
examples/apb_window_test/bin-u54/apb_window_test.elf	TEST apb_window_test_u54: PASS
