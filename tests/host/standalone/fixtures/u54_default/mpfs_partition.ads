--  GENERATED by config/gen/standalone.py from the parameters of the build of
--  this image (hart, profile, console, memory profile and stack sizes). Do
--  not edit: change the inputs and run the generator (CI fails if this file
--  is not current).
--
--  The partition data of one image and the checks on them. The package is
--  pure and has no body: the values are named numbers, the checks are flat
--  static constants, each with a Compile_Time_Error on it, because GNAT
--  ignores one whose condition is not static. The linker scripts and the
--  start code read the same values as link symbols, which the list
--  mpfs_partition.defsyms carries.

package MPFS_Partition is

   pragma Pure;

   -----------
   -- Harts --
   -----------

   Harts_Mask               : constant := 16#2#;
   --  Bit n is hart n: bit 0 is the E51, bits 1 to 4 are the U54 cores.
   Boot_Role                : constant := 1;
   --  1 primary, 0 secondary (__mpfs_boot_role).
   Hart_E51                 : constant := 16#01#;
   --  The E51 in a mask.
   Hart_U54                 : constant := 16#1E#;
   --  The U54 cores in a mask.

   -------------
   -- Console --
   -------------

   Console_None             : constant := 0;
   Console_MMUART           : constant := 1;
   Console_RAM_FIFO         : constant := 2;
   Console_Kind             : constant := 1;
   --  The console is mmuart1.
   Console_Base             : constant := 16#2010_0000#;
   --  The LO base of the MMUART; 0 without one.
   Console_Init             : constant := 1;
   --  1 the runtime sets divisor and format; 0 the boot stage has done it.
   Console_Divisor          : constant := 22;
   --  The integer divisor of the baud rate.
   Console_Fraction         : constant := 0;
   --  The fraction in 64ths of the divisor.

   ------------
   -- Stacks --
   ------------

   Stack_Size               : constant := 16384;
   --  Bytes, the stack of the environment task.
   Interrupt_Stack_Size     : constant := 8192;
   --  Bytes, per hart.
   Secondary_Stack_Size     : constant := 16384;
   --  Bytes, the secondary stack of the environment task. Not a link symbol:
   --  the runtime takes the default of its profile, so only the check reads
   --  it.

   ------------
   -- Memory --
   ------------

   L2_Ways                  : constant := 16;
   --  The L2 is 16 ways of 128 KB.
   Cache_Ways               : constant := 1;
   LIM_Ways                 : constant := 15;
   --  Ways used as LIM (L2 addressed as SRAM).
   Scratchpad_Ways          : constant := 0;
   Max_LIM_Ways             : constant := 15;
   --  At least one way stays cache.
   LIM_Length               : constant := 16#001E_0000#;
   Scratchpad_Length        : constant := 16#0#;
   DTIM_Length              : constant := 16#0#;
   --  The E51 only.
   DTIM_Max                 : constant := 16#2000#;
   ITIM_Length_0            : constant := 16#0#;
   --  The ITIM of hart 0.
   ITIM_Length_1            : constant := 16#0#;
   --  The ITIM of hart 1.
   ITIM_Length_2            : constant := 16#0#;
   ITIM_Length_3            : constant := 16#0#;
   ITIM_Length_4            : constant := 16#0#;
   ITIM_Max_0               : constant := 16#2000#;
   --  E51: 8 KB, U54: 28 KB.
   ITIM_Max_1               : constant := 16#7000#;
   ITIM_Max_2               : constant := 16#7000#;
   ITIM_Max_3               : constant := 16#7000#;
   ITIM_Max_4               : constant := 16#7000#;
   SMP_Available            : constant := 0;
   --  1 once the runtime has more than one CPU.

   ------------
   -- Checks --
   ------------

   --  Each check is a flat static Boolean constant, then the pragma. A false
   --  condition costs nothing; a true one stops the compilation with the
   --  message.

   Mask_Names_No_Hart       : constant Boolean :=
     Harts_Mask = 0 or else Harts_Mask > 16#1F#;
   pragma Compile_Time_Error
     (Mask_Names_No_Hart,
      "the harts mask names no hart or a hart above 4");

   Mask_Mixes_E51_And_U54   : constant Boolean :=
     Harts_Mask mod 2 = 1 and then Harts_Mask / 2 /= 0;
   pragma Compile_Time_Error
     (Mask_Mixes_E51_And_U54,
      "a partition mask must not mix the E51 and U54 harts");

   Boot_Role_Invalid        : constant Boolean :=
     Boot_Role > 1;
   pragma Compile_Time_Error
     (Boot_Role_Invalid,
      "__mpfs_boot_role must be 1 (primary) or 0 (secondary)");

   Stack_Size_Invalid       : constant Boolean :=
     Stack_Size = 0 or else Stack_Size mod 16 /= 0;
   pragma Compile_Time_Error
     (Stack_Size_Invalid,
      "the stack size must be a non-zero multiple of 16");

   Interrupt_Stack_Size_Invalid : constant Boolean :=
     Interrupt_Stack_Size = 0 or else Interrupt_Stack_Size mod 16 /= 0;
   pragma Compile_Time_Error
     (Interrupt_Stack_Size_Invalid,
      "the interrupt stack size must be a non-zero multiple of 16");

   Secondary_Stack_Size_Invalid : constant Boolean :=
     Secondary_Stack_Size = 0 or else Secondary_Stack_Size mod 16 /= 0;
   pragma Compile_Time_Error
     (Secondary_Stack_Size_Invalid,
      "the secondary stack size must be a non-zero multiple of 16");

   Console_RAM_FIFO_Without_SMP : constant Boolean :=
     Console_Kind = Console_RAM_FIFO and then SMP_Available = 0;
   pragma Compile_Time_Error
     (Console_RAM_FIFO_Without_SMP,
      "the console ram_fifo needs a second hart; SMP does not exist yet");

   L2_Way_Sum_Not_16        : constant Boolean :=
     Cache_Ways + LIM_Ways + Scratchpad_Ways /= L2_Ways;
   pragma Compile_Time_Error
     (L2_Way_Sum_Not_16,
      "the L2 ways (cache, LIM, scratchpad) must add up to 16");

   LIM_Ways_Above_15        : constant Boolean :=
     LIM_Ways > Max_LIM_Ways;
   pragma Compile_Time_Error
     (LIM_Ways_Above_15,
      "at most 15 L2 ways can be LIM: one way stays cache");

   DTIM_Not_On_E51          : constant Boolean :=
     DTIM_Length /= 0 and then Harts_Mask mod 2 = 0;
   pragma Compile_Time_Error
     (DTIM_Not_On_E51,
      "the DTIM exists on the E51 only");

   DTIM_Too_Large           : constant Boolean :=
     DTIM_Length > DTIM_Max;
   pragma Compile_Time_Error
     (DTIM_Too_Large,
      "the DTIM of the E51 is 8 KB at most");

   ITIM_0_Too_Large         : constant Boolean :=
     ITIM_Length_0 > ITIM_Max_0;
   pragma Compile_Time_Error
     (ITIM_0_Too_Large,
      "the ITIM of E51 is larger than the ITIM of that hart");

   ITIM_1_Too_Large         : constant Boolean :=
     ITIM_Length_1 > ITIM_Max_1;
   pragma Compile_Time_Error
     (ITIM_1_Too_Large,
      "the ITIM of U54 hart 1 is larger than the ITIM of that hart");

   ITIM_2_Too_Large         : constant Boolean :=
     ITIM_Length_2 > ITIM_Max_2;
   pragma Compile_Time_Error
     (ITIM_2_Too_Large,
      "the ITIM of U54 hart 2 is larger than the ITIM of that hart");

   ITIM_3_Too_Large         : constant Boolean :=
     ITIM_Length_3 > ITIM_Max_3;
   pragma Compile_Time_Error
     (ITIM_3_Too_Large,
      "the ITIM of U54 hart 3 is larger than the ITIM of that hart");

   ITIM_4_Too_Large         : constant Boolean :=
     ITIM_Length_4 > ITIM_Max_4;
   pragma Compile_Time_Error
     (ITIM_4_Too_Large,
      "the ITIM of U54 hart 4 is larger than the ITIM of that hart");

end MPFS_Partition;
