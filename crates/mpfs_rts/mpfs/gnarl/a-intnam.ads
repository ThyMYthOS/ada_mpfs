   package Local is

      --  The local interrupt numbers of the harts: the mcause of the
      --  interrupt is Mcause_Offset + number (interrupt bit set), and the
      --  same number is a different interrupt on the E51 and on the U54
      --  cores. A name lists the harts that have the interrupt, and the PLIC
      --  source that the same event also raises, if it has one.

      type Local_Interrupt is range 0 .. 47;

      Mcause_Offset : constant := 16;

